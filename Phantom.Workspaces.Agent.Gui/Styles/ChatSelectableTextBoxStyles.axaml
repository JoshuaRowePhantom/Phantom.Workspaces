<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="SelectableTextBlock.agent-chat-output-text">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="6" />
    </Style>

    <Style Selector="ScrollViewer.agent-chat-output-scrollviewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style Selector="Span.agent-chat-selectable-role-label">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.strong.Foreground}" />
    </Style>
    <Style Selector="Run.agent-chat-selectable-role-label">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.strong.Foreground}" />
    </Style>

    <Style Selector="Span.agent-chat-selectable-running-header">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.accent.Foreground}" />
        <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style Selector="Run.agent-chat-selectable-running-header">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.accent.Foreground}" />
        <Setter Property="FontStyle" Value="Italic" />
    </Style>

    <Style Selector="Span.agent-chat-selectable-reasoning">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.subtle.Foreground}" />
        <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style Selector="Run.agent-chat-selectable-reasoning">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.subtle.Foreground}" />
        <Setter Property="FontStyle" Value="Italic" />
    </Style>

    <Style Selector="Span.agent-chat-selectable-meta">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.warning.Foreground}" />
    </Style>
    <Style Selector="Run.agent-chat-selectable-meta">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.warning.Foreground}" />
    </Style>

    <Style Selector="Span.agent-chat-selectable-monospace">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Monaco, monospace" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.strong.Foreground}" />
    </Style>
    <Style Selector="Run.agent-chat-selectable-monospace">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Monaco, monospace" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.strong.Foreground}" />
    </Style>

    <Style Selector="Span.agent-chat-selectable-error">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.error.Foreground}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Run.agent-chat-selectable-error">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.error.Foreground}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Span.agent-chat-selectable-uri">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.accent.Foreground}" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Run.agent-chat-selectable-uri">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.accent.Foreground}" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <Style Selector="Span.agent-chat-selectable-user-message > Span.agent-chat-selectable-role-label">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.success.Foreground}" />
    </Style>
    <Style Selector="Span.agent-chat-selectable-user-message > Span.agent-chat-selectable-role-label > Run.agent-chat-selectable-role-label">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.success.Foreground}" />
    </Style>

    <Style Selector="Span.agent-chat-selectable-assistant-message > Span.agent-chat-selectable-role-label">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.accent.Foreground}" />
    </Style>
    <Style Selector="Span.agent-chat-selectable-assistant-message > Span.agent-chat-selectable-role-label > Run.agent-chat-selectable-role-label">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.accent.Foreground}" />
    </Style>

</Styles>
