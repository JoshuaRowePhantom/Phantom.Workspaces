<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Phantom.Workspaces.Agent.Gui.ErrorWindow"
        Width="640"
        Height="400"
        MinWidth="400"
        MinHeight="200"
        WindowStartupLocation="CenterScreen"
        Title="Agent Startup Error"
        Classes="agent-window">
    <DockPanel Classes="agent-dialog-root">
        <StackPanel DockPanel.Dock="Bottom"
                    Classes="agent-dialog-actions">
            <Button Content="Close"
                    Click="OnCloseClicked"
                    Classes="queue-action-button"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="Failed to load agent definition"
                   Classes="agent-dialog-title agent-error-title"/>

        <Border Classes="agent-surface">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ErrorText"
                           TextWrapping="Wrap"
                           Classes="terminal-mono agent-body-text"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
