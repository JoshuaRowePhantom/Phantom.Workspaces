<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />


    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- Issue #1035: the agent-chat detail region is hosted in a locked, tab-strip-less
         Dock.Avalonia DocumentDock (cache-N/show-one) built with the thread-agnostic Dock.Model.Mvvm
         model so the shared detail-content collection can mutate off the UI thread when sub-agents
         are added on a background scheduler. -->
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Markdig.Signed" />
    <PackageReference Include="System.CommandLine" />
    <!-- Referenced unconditionally so restore is configuration-independent and the
         #if DEBUG AttachDeveloperTools() call always resolves during no-restore parallel
         test builds. Conditioning asset metadata on $(Configuration) made restore output
         config-dependent and intermittently dropped the compile assets, silently skipping
         this project's test assembly (see #1050). The call is still #if DEBUG, so DevTools
         never attaches in Release. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Phantom.Workspaces.Llm.Core\Phantom.Workspaces.Llm.Core.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Llm.Echo\Phantom.Workspaces.Llm.Echo.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Gui.Shared\Phantom.Workspaces.Gui.Shared.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Logging\Phantom.Workspaces.Logging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\chat-output-shell.html" />
  </ItemGroup>
</Project>