<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.Agent.Gui.ViewModels"
             xmlns:controls="using:Phantom.Workspaces.Agent.Gui.Controls"
             x:Class="Phantom.Workspaces.Agent.Gui.Controls.AgentInputQueueControl"
             x:DataType="vm:InputQueueViewModel"
             Background="#1A1A1A">
    <Border BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="8,6">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Queues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:InputQueueGroupViewModel">
                        <Border Margin="0,0,0,8"
                                Padding="10,8"
                                Background="#202020"
                                BorderBrush="#303030"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel Spacing="6">
                                <DockPanel>
                                    <TextBlock Text="{Binding Name}"
                                               IsVisible="{Binding ShowName}"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E0E0"
                                               FontSize="12"/>
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                HorizontalAlignment="Right">
                                        <Button Command="{Binding ToggleComposerCommand}"
                                                Content="+"
                                                Classes="queue-glyph-button"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding CanToggleComposer}"/>
                                        <Button Command="{Binding RemoveQueueCommand}"
                                                IsVisible="{Binding CanRemoveQueue}"
                                                Classes="queue-glyph-button queue-danger-button"
                                                BorderThickness="1"
                                                CornerRadius="999"
                                                Content="✕"/>
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Items}"
                                              IsVisible="{Binding HasItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:InputQueueEntryViewModel">
                                            <Border Margin="0,0,0,4"
                                                    Padding="8,6"
                                                    Background="#262626"
                                                    CornerRadius="3">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      RowDefinitions="Auto,Auto"
                                                      ColumnSpacing="8"
                                                      RowSpacing="6">
                                                    <StackPanel IsVisible="{Binding IsEditing}"
                                                               Spacing="6">
                                                        <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                             x:Name="EditBox"
                                                             AcceptsReturn="False"
                                                             MinHeight="32"
                                                             FontSize="12"
                                                             Background="#2A2A2A"
                                                             Classes="terminal-mono terminal-editor"/>
                                                    <StackPanel Orientation="Horizontal"
                                                               HorizontalAlignment="Right"
                                                               Spacing="6">
                                                        <Button Command="{Binding SaveEditCommand}"
                                                                Content="Save"
                                                                Classes="queue-action-button"/>
                                                            <Button Command="{Binding CancelEditCommand}"
                                                                    Content="Cancel"
                                                                Classes="queue-action-button"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Button Command="{Binding EditCommand}"
                                                        Classes="queue-item-trigger"
                                                        IsVisible="{Binding IsNotEditing}"
                                                        Grid.Column="0"
                                                        Grid.Row="0">
                                                    <Button.KeyBindings>
                                                        <KeyBinding Gesture="F2"
                                                                    Command="{Binding EditCommand}"/>
                                                    </Button.KeyBindings>
                                                    <SelectableTextBlock Text="{Binding Text}"
                                                                         TextWrapping="Wrap"
                                                                         FontSize="12"
                                                                         Classes="terminal-mono terminal-content"/>
                                                </Button>

                                                <ItemsControl Grid.Row="1"
                                                              Grid.Column="0"
                                                              Grid.ColumnSpan="2"
                                                              Margin="0,6,0,0"
                                                                  ItemsSource="{Binding Attachments}"
                                                                  IsVisible="{Binding HasAttachments}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"
                                                                           Spacing="6"
                                                                           HorizontalAlignment="Left"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vm:InputQueueEntryAttachmentViewModel">
                                                                <Border Background="#5A3A1A"
                                                                        BorderBrush="#8A5A20"
                                                                        BorderThickness="1"
                                                                        CornerRadius="10"
                                                                        Padding="4">
                                                                    <StackPanel Orientation="Horizontal"
                                                                               Spacing="6"
                                                                               VerticalAlignment="Center">
                                                                        <Border Background="#2A2A2A"
                                                                                BorderBrush="#8A5A20"
                                                                                BorderThickness="1"
                                                                                CornerRadius="6"
                                                                                Width="28"
                                                                                Height="20"
                                                                                ClipToBounds="True">
                                                                            <Button Background="Transparent"
                                                                                    BorderThickness="0"
                                                                                    Padding="0"
                                                                                    Click="OnQueueAttachmentImageClicked"
                                                                                    IsVisible="{Binding HasPreview}">
                                                                                <Image Source="{Binding Preview}"
                                                                                       Width="28"
                                                                                       Height="20"
                                                                                       Stretch="UniformToFill"/>
                                                                            </Button>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Label}"
                                                                                  Foreground="#F6D7A7"
                                                                                  FontSize="11"
                                                                                  VerticalAlignment="Center"/>
                                                                        <Button Command="{Binding RemoveCommand}"
                                                                               Content="✕"
                                                                               Classes="queue-glyph-button queue-danger-button"
                                                                               BorderThickness="1"
                                                                               MinWidth="20"
                                                                               MinHeight="20"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="6"
                                                                VerticalAlignment="Center">
                                                        <Button Command="{Binding RemoveCommand}"
                                                                Content="✕"
                                                                Classes="queue-glyph-button queue-danger-button"
                                                                BorderThickness="1"
                                                                CornerRadius="999"
                                                                VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border IsVisible="{Binding HasComposer}">
                                    <controls:QueueComposerControl DataContext="{Binding Composer}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
