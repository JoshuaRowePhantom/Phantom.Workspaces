<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.Agent.Gui.ViewModels"
             xmlns:controls="using:Phantom.Workspaces.Agent.Gui.Controls"
             x:Class="Phantom.Workspaces.Agent.Gui.Controls.AgentInputQueueControl"
             x:DataType="vm:InputQueueViewModel"
             Background="#1A1A1A">

    <Border BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="8,6">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Queues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:InputQueueGroupViewModel">
                        <Border Margin="0,0,0,8"
                                Padding="10,8"
                                Background="#202020"
                                BorderBrush="#303030"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel Spacing="6">
                                <DockPanel>
                                    <TextBlock Text="{Binding Name}"
                                               IsVisible="{Binding ShowName}"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E0E0"
                                               FontSize="12"/>
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                        <Button Command="{Binding ToggleComposerCommand}"
                                                Content="+"
                                                MinWidth="24"
                                                MinHeight="24"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding CanToggleComposer}"/>
                                        <TextBlock Text="{Binding ItemCountText}"
                                                   Foreground="#8A8A8A"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox SelectedItem="{Binding SelectedImmediacyOption, Mode=TwoWay}"
                                                  ItemsSource="{Binding ImmediacyOptions}"
                                                  Width="110"
                                                  MinHeight="24">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="vm:QueueImmediacyOption">
                                                    <TextBlock Text="{Binding Label}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </DockPanel>

                                <Border IsVisible="{Binding HasComposer}">
                                    <controls:QueueComposerControl DataContext="{Binding Composer}"/>
                                </Border>

                                <TextBlock Text="No pending items"
                                           Foreground="#606060"
                                           FontSize="11"
                                           IsVisible="{Binding HasNoItems}"/>

                                <ItemsControl ItemsSource="{Binding Items}"
                                              IsVisible="{Binding HasItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:InputQueueEntryViewModel">
                                            <Border Margin="0,0,0,4"
                                                    Padding="8,6"
                                                    Background="#262626"
                                                    CornerRadius="3">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="8">
                                                    <StackPanel IsVisible="{Binding IsEditing}"
                                                                Spacing="6">
                                                        <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="False"
                                                                 MinHeight="32"
                                                                 FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                                                 FontSize="12"
                                                                 Background="#2A2A2A"
                                                                 Foreground="#E0E0E0"
                                                                 CaretBrush="#E0E0E0"
                                                                 BorderBrush="#3A3A3A"/>
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Spacing="6">
                                                            <Button Command="{Binding SaveEditCommand}"
                                                                    Content="Save"
                                                                    MinHeight="28"
                                                                    Padding="10,0"/>
                                                            <Button Command="{Binding CancelEditCommand}"
                                                                    Content="Cancel"
                                                                    MinHeight="28"
                                                                    Padding="10,0"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <SelectableTextBlock Text="{Binding Text}"
                                                                         IsVisible="{Binding IsNotEditing}"
                                                                         TextWrapping="Wrap"
                                                                         Foreground="#D0D0D0"
                                                                         FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                                                         FontSize="12"/>

                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="6"
                                                                VerticalAlignment="Top">
                                                        <Button Command="{Binding EditCommand}"
                                                                Content="Edit"
                                                                MinWidth="36"
                                                                MinHeight="24"
                                                                Padding="8,0"/>
                                                        <Button Command="{Binding RemoveCommand}"
                                                                Content="X"
                                                                MinWidth="24"
                                                                MinHeight="24"
                                                                Padding="0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
