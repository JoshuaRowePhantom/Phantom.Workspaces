<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.Agent.Gui.ViewModels"
             xmlns:ai="using:Microsoft.Extensions.AI"
             xmlns:llm="using:Phantom.Workspaces.Llm"
             xmlns:converters="using:Phantom.Workspaces.Agent.Gui.Converters"
             x:Class="Phantom.Workspaces.Agent.Gui.Controls.ChatAgentOutputControl"
             x:DataType="vm:AgentViewModel"
             Background="#1E1E1E">
    <UserControl.DataTemplates>
        <DataTemplate DataType="ai:TextContent">
            <SelectableTextBlock Text="{Binding Text}"
                                 TextWrapping="Wrap"
                                 Foreground="#D0D0D0"
                                 FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                 FontSize="13"/>
        </DataTemplate>
        <DataTemplate DataType="ai:DataContent">
            <SelectableTextBlock Text="{Binding MediaType, StringFormat=[{0}]}"
                                 TextWrapping="Wrap"
                                 Foreground="#D0D0D0"
                                 FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                 FontSize="13"/>
        </DataTemplate>
        <DataTemplate DataType="ai:UriContent">
            <SelectableTextBlock Text="{Binding Uri}"
                                 TextWrapping="Wrap"
                                 Foreground="#D0D0D0"
                                 FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                 FontSize="13"/>
        </DataTemplate>
        <DataTemplate DataType="ai:ErrorContent">
            <Border Background="#3A1F1F"
                    BorderBrush="#6B2A2A"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6">
                <SelectableTextBlock Text="{Binding Message}"
                                     TextWrapping="Wrap"
                                     Foreground="#FFB3B3"
                                     FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                     FontSize="13"/>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="ai:FunctionCallContent">
            <Border Background="#252525"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6">
                <StackPanel>
                    <TextBlock Text="{Binding Name, StringFormat=tool call: {0}}"
                               Foreground="#B8B8B8"
                               FontWeight="SemiBold"
                               FontSize="11"/>
                    <SelectableTextBlock Text="{Binding Arguments, Converter={x:Static converters:ObjectToPrettyJsonConverter.Instance}}"
                                         TextWrapping="Wrap"
                                         Foreground="#C8C8C8"
                                         FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                         FontSize="12"
                                         Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="ai:FunctionResultContent">
            <Border Background="#252525"
                    BorderBrush="#3A3A3A"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6">
                <StackPanel>
                    <TextBlock Text="{Binding CallId, StringFormat=tool result: {0}}"
                               Foreground="#B8B8B8"
                               FontWeight="SemiBold"
                               FontSize="11"/>
                    <SelectableTextBlock Text="{Binding Result, Converter={x:Static converters:ObjectToPrettyJsonConverter.Instance}}"
                                         TextWrapping="Wrap"
                                         Foreground="#C8C8C8"
                                         FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                         FontSize="12"
                                         Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="llm:AgentChatHistoryItem">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Contents, Converter={x:Static converters:RenderableContentFilterConverter.Instance}}"/>
                <ProgressBar IsVisible="{Binding IsInProgress}"
                             IsIndeterminate="True"
                             Height="2"
                             Margin="0,6,0,0"
                             Background="Transparent"
                             Foreground="#4080FF"/>

            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:ChatHistoryItemViewModel">
            <Border Padding="12,8"
                    BorderBrush="#2A2A2A"
                    BorderThickness="0,0,0,1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding RoleLabel}"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Margin="0,0,0,4"
                               Foreground="{Binding IsUser, Converter={x:Static converters:RoleToColorConverter.Instance}}"/>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding ReasoningDisplayText}"
                               IsVisible="{Binding HasReasoningLine}"
                               FontSize="11"
                               FontStyle="Italic"
                               Margin="0,0,0,4"
                               Foreground="#8F8F8F"/>
                    <ProgressBar DockPanel.Dock="Top"
                                IsVisible="{Binding IsInProgress}"
                                IsIndeterminate="True"
                                Height="2"
                                Margin="0,0,0,6"
                                Background="Transparent"
                                Foreground="#4080FF"/>
                    <ItemsControl ItemsSource="{Binding Contents, Converter={x:Static converters:RenderableContentFilterConverter.Instance}}"
                                 Margin="0,8,0,0"/>
                    <ItemsControl ItemsSource="{Binding Attachments}"
                                 IsVisible="{Binding HasAttachments}"
                                 Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ChatHistoryImageViewModel">
                                <Border Background="#303030"
                                        BorderBrush="#505050"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6">
                                    <StackPanel Spacing="4">
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Click="OnHistoryImageClicked"
                                                IsVisible="{Binding HasPreview}">
                                            <Image Source="{Binding Preview}"
                                                   Width="96"
                                                   Height="64"
                                                   Stretch="UniformToFill"/>
                                        </Button>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="11"
                                                   Foreground="#D0D0D0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer x:Name="HistoryScroll"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ItemsControl x:Name="HistoryList"
                          ItemsSource="{Binding History}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border Background="#232323"
                    BorderBrush="#2A2A2A"
                    BorderThickness="0,1,0,0"
                    Padding="8,6"
                    IsVisible="{Binding RunningItems.Count, Converter={x:Static converters:CountToBoolConverter.Instance}}">
                <ItemsControl ItemsSource="{Binding RunningItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:RunningItemViewModel">
                            <Border Padding="6,4">
                                <ItemsControl ItemsSource="{Binding HistoryItems}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
