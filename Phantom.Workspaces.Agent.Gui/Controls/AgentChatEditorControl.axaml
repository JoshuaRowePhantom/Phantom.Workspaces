<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.Agent.Gui.ViewModels"
             xmlns:controls="using:Phantom.Workspaces.Agent.Gui.Controls"
             xmlns:converters="using:Phantom.Workspaces.Agent.Gui.Converters"
             x:Class="Phantom.Workspaces.Agent.Gui.Controls.AgentChatEditorControl"
             x:CompileBindings="False"
             x:DataType="vm:AgentViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+T"
                   Command="{Binding ToggleReasoningVisibilityCommand}" />
        <KeyBinding Gesture="Ctrl+L"
                   Command="{Binding RequestOpenLogWindowCommand}" />
        <!-- Interrupt / queue hold work from anywhere in the agent chat (input box or output),
             so they are bound on this control which contains both.
             Windows turns the Pause/Break key into VK_CANCEL (Key.Cancel) whenever Ctrl is held, so
             Ctrl+Break and Ctrl+Shift+Break are matched as Ctrl+Cancel / Ctrl+Shift+Cancel — binding
             them as "Cancel" or "Ctrl+Shift+Pause" never fires because the real key is Cancel and the
             Ctrl modifier is present. -->
        <KeyBinding Gesture="Ctrl+Cancel" Command="{Binding InterruptCommand}" />
        <KeyBinding Gesture="Pause" Command="{Binding InputQueue.ToggleHoldAllQueuesCommand}" />
        <KeyBinding Gesture="Shift+Pause" Command="{Binding InputQueue.HoldAllQueuesCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Cancel" Command="{Binding InputQueue.UnholdAllQueuesCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Phantom.Workspaces.Agent.Gui/Controls/AgentChatToolTemplates.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:AgentChatConversationDetailViewModel">
            <DockPanel>
                <Border DockPanel.Dock="Bottom"
                        Classes="agent-chat-status-line"
                        IsVisible="{Binding StatusLine.HasVisibleContent}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="agent-chat-status-line-brain"
                                     Classes.thinking="{Binding StatusLine.IsThinking}"
                                     Classes.idle="{Binding !StatusLine.IsThinking}"
                                     Text="🧠"
                                     VerticalAlignment="Center"/>
                        <TextBlock Classes="agent-chat-status-line-value"
                                   Text="{Binding StatusLine.ModelDisplay}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding StatusLine.HasModel}"/>
                        <TextBlock Classes="agent-chat-status-line-label"
                                   Text="{Binding StatusLine.ProviderDisplay}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding StatusLine.HasProvider}"/>
                        <TextBlock Classes="agent-chat-status-line-label"
                                   Text="{Binding StatusLine.TokensDisplay}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding StatusLine.HasTokens}"/>
                        <CheckBox Classes="agent-chat-autoscroll-toggle"
                                  Content="Auto-scroll"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding Agent.AutoScrollEnabled, Mode=TwoWay}"
                                  Classes.scroll-locked="{Binding Agent.AutoScrollEnabled}"/>
                        <Button Classes="agent-chat-status-line-reasoning-toggle"
                                VerticalAlignment="Center"
                                Command="{Binding Agent.ToggleReasoningVisibilityCommand}"
                                ToolTip.Tip="Toggle reasoning text visibility (Ctrl+T)">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Panel>
                                    <TextBlock Text="🧠"
                                               Classes="agent-chat-status-line-brain-glyph" />
                                    <TextBlock Text="⃠"
                                               Classes="agent-chat-status-line-cancel-overlay"
                                               IsVisible="{Binding !Agent.IsReasoningVisible}" />
                                </Panel>
                                <TextBlock Text="Showing Reasoning"
                                           Classes="agent-chat-status-line-label"
                                           Margin="0"
                                           IsVisible="{Binding Agent.IsReasoningVisible}" />
                                <TextBlock Text="Not Showing Reasoning"
                                           Classes="agent-chat-status-line-label muted"
                                           Margin="0"
                                           IsVisible="{Binding !Agent.IsReasoningVisible}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <controls:AgentChatInputQueueControl DockPanel.Dock="Bottom"
                                                     DataContext="{Binding InputQueue}"
                                                     IsVisible="{Binding Agent.AcceptsUserInput}"/>
                <controls:AgentChatOutputControl DataContext="{Binding Agent}"/>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:AgentChatDetailsViewModel">
            <StackPanel Spacing="10">
                <TextBlock Text="Chat details"
                           Classes="agent-section-title"/>
                <StackPanel Spacing="4">
                    <TextBlock Text="Display name"
                               Classes="muted"/>
                    <TextBox Text="{Binding DisplayName}"
                             IsReadOnly="True"
                             Classes="agent-detail-value copyable-text"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Session ID"
                               Classes="muted"/>
                    <TextBox Text="{Binding AgentSessionId}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Classes="agent-detail-value copyable-text"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Provider"
                               Classes="muted"/>
                    <TextBox Text="{Binding ModelProvider}"
                             IsReadOnly="True"
                             Classes="agent-detail-value copyable-text"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Model"
                               Classes="muted"/>
                    <TextBox Text="{Binding ModelId}"
                             IsReadOnly="True"
                             Classes="agent-detail-value copyable-text"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="API type"
                               Classes="muted"/>
                    <TextBox Text="{Binding ModelApiType}"
                             IsReadOnly="True"
                             Classes="agent-detail-value copyable-text"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Connection type"
                               Classes="muted"/>
                    <TextBox Text="{Binding ModelConnectionType}"
                             IsReadOnly="True"
                             Classes="agent-detail-value copyable-text"/>
                </StackPanel>
                <CheckBox Content="Show reasoning text"
                          IsChecked="{Binding IsReasoningVisible}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:AgentChatToolsDetailViewModel">
            <controls:AgentChatToolsDetailControl/>
        </DataTemplate>
        <DataTemplate DataType="vm:AgentChatToolViewModel">
            <StackPanel Spacing="10">
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource AgentToolHeaderTemplate}"/>
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource AgentToolDetailTemplate}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:AgentChatPlaceholderDetailViewModel">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Title}"
                           Classes="agent-section-title"/>
                <TextBlock Text="{Binding Description}"
                           Classes="muted"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:SubAgentBrowserViewModel">
            <DockPanel Margin="12">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Sub-agents"
                               Classes="agent-section-title"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"/>
                    <CheckBox DockPanel.Dock="Right"
                              Content="Hide completed"
                              IsChecked="{Binding HideCompleted}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding VisibleItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="agent-surface compact"
                                    Margin="0,2">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="✔"
                                               Classes="muted"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding CompletionState, Converter={x:Static converters:CompletionStateConverters.IsSucceeded}}"/>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="✘"
                                               Classes="muted"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding CompletionState, Converter={x:Static converters:CompletionStateConverters.IsFailed}}"/>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="⟳"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding CompletionState, Converter={x:Static converters:CompletionStateConverters.IsRunning}}"/>
                                    <TextBlock Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No sub-agents yet."
                           Classes="muted"
                           IsVisible="{Binding !VisibleItems.Count}"
                           TextWrapping="Wrap"/>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:SubAgentsContainerViewModel">
            <Panel>
                <ContentControl Content="{Binding Browser}"
                                IsVisible="{Binding IsShowingBrowser}"/>
                <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:SubAgentSlotViewModel">
                            <controls:AgentChatEditorControl DataContext="{Binding SubAgentViewModel}"
                                                             IsVisible="{Binding IsSelected}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Panel>
        </DataTemplate>
        <DataTemplate DataType="vm:DiagnosticInspectorViewModel">
            <DockPanel>
                <StackPanel Spacing="4" Margin="12">
                    <TextBlock Text="Diagnostics"
                               Classes="agent-section-title"/>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:DiagnosticItemViewModel">
                                <Border Classes="agent-surface compact"
                                        Margin="0,2">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding InspectCommand}"
                                                Content="🔍"
                                                ToolTip.Tip="Inspect"
                                                Classes="queue-action-button"
                                                VerticalAlignment="Top"/>
                                        <TextBlock Text="{Binding ContentId}"
                                                   Classes="chat-monospace muted"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No diagnostic events recorded."
                               Classes="muted"
                               TextWrapping="Wrap"
                               IsVisible="{Binding !Items.Count}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Border Classes="agent-pane">
        <Grid x:Name="EditorGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"
                                  MinWidth="0"
                                  MaxWidth="480"/>
                <ColumnDefinition Width="24"
                                  MinWidth="24"
                                  MaxWidth="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TreeView x:Name="NavigationTree"
                      ItemsSource="{Binding EditorItems}"
                      ItemTemplate="{StaticResource AgentNavigationTreeHeaderItemTemplate}"
                      Classes="entity-card-tree entity-card-tree-sticky"
                      MinWidth="240"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.AllowAutoHide="False"
                      SelectionChanged="OnEditorSelectionChanged"
                      Grid.Column="0">
                <TreeView.Styles>
                    <Style Selector="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>
            </TreeView>

            <GridSplitter x:Name="SplitterHost"
                          Grid.Column="1"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          Classes="main-splitter"
                          ResizeBehavior="PreviousAndNext"/>
            <ToggleButton x:Name="TreeCollapseToggle"
                          Width="16"
                          Height="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Grid.Column="1"
                          Click="OnTreeCollapseToggleClicked"
                          Content="◀"/>
            <Panel Grid.Column="2">
                <ItemsControl ItemsSource="{Binding DetailContentSlots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:DetailContentSlot">
                            <ContentControl Content="{Binding Content}"
                                            IsVisible="{Binding IsVisible}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Panel>
        </Grid>
    </Border>
</UserControl>
