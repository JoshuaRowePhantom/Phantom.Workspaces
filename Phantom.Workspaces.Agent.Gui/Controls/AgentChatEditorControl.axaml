<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.Agent.Gui.ViewModels"
             xmlns:controls="using:Phantom.Workspaces.Agent.Gui.Controls"
             xmlns:converters="using:Phantom.Workspaces.Agent.Gui.Converters"
             xmlns:dock="using:Dock.Avalonia.Controls"
             xmlns:ts="using:Phantom.Dock.Avalonia.TabSwitching"
             x:Class="Phantom.Workspaces.Agent.Gui.Controls.AgentChatEditorControl"
             x:CompileBindings="False"
             x:DataType="vm:AgentViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+T"
                   Command="{Binding ToggleReasoningVisibilityCommand}" />
        <KeyBinding Gesture="Ctrl+L"
                   Command="{Binding RequestOpenLogWindowCommand}" />
        <!-- Interrupt / queue hold work from anywhere in the agent chat (input box or output),
             so they are bound on this control which contains both.
             Windows turns the Pause/Break key into VK_CANCEL (Key.Cancel) whenever Ctrl is held, so
             Ctrl+Break and Ctrl+Shift+Break are matched as Ctrl+Cancel / Ctrl+Shift+Cancel — binding
             them as "Cancel" or "Ctrl+Shift+Pause" never fires because the real key is Cancel and the
             Ctrl modifier is present. -->
        <KeyBinding Gesture="Ctrl+Cancel" Command="{Binding InterruptCommand}" />
        <KeyBinding Gesture="Pause" Command="{Binding ToggleHoldAllQueuesCommand}" />
        <KeyBinding Gesture="Shift+Pause" Command="{Binding HoldAllQueuesCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Cancel" Command="{Binding UnholdAllQueuesCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Phantom.Workspaces.Agent.Gui/Controls/AgentChatToolTemplates.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:AgentChatConversationDetailViewModel">
            <DockPanel>
                <Border DockPanel.Dock="Bottom"
                        Classes="agent-chat-status-line"
                        IsVisible="{Binding StatusLine.HasVisibleContent}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="agent-chat-status-line-brain"
                                     Classes.thinking="{Binding StatusLine.IsThinking}"
                                     Classes.idle="{Binding !StatusLine.IsThinking}"
                                     Text="🧠"
                                     VerticalAlignment="Center"/>
                        <TextBlock Classes="agent-chat-status-line-value"
                                   Text="{Binding StatusLine.ModelDisplay}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding StatusLine.HasModel}"/>
                        <TextBlock Classes="agent-chat-status-line-label"
                                   Text="{Binding StatusLine.ProviderDisplay}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding StatusLine.HasProvider}"/>
                        <TextBlock Classes="agent-chat-status-line-label"
                                   Text="{Binding StatusLine.TokensDisplay}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding StatusLine.HasTokens}"/>
                        <CheckBox Classes="agent-chat-autoscroll-toggle"
                                  Content="Auto-scroll"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="Toggle auto-scroll (Scroll Lock)"
                                  IsChecked="{Binding Agent.AutoScrollEnabled, Mode=TwoWay}"
                                  Classes.scroll-locked="{Binding Agent.AutoScrollEnabled}"/>
                        <Button Classes="agent-chat-status-line-reasoning-toggle"
                                VerticalAlignment="Center"
                                Command="{Binding Agent.ToggleReasoningVisibilityCommand}"
                                ToolTip.Tip="Toggle reasoning text visibility (Ctrl+T)">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Panel>
                                    <TextBlock Text="🧠"
                                               Classes="agent-chat-status-line-brain-glyph" />
                                    <TextBlock Text="⃠"
                                               Classes="agent-chat-status-line-cancel-overlay"
                                               IsVisible="{Binding !Agent.IsReasoningVisible}" />
                                </Panel>
                                <TextBlock Text="Showing Reasoning"
                                           Classes="agent-chat-status-line-label"
                                           Margin="0"
                                           IsVisible="{Binding Agent.IsReasoningVisible}" />
                                <TextBlock Text="Not Showing Reasoning"
                                           Classes="agent-chat-status-line-label muted"
                                           Margin="0"
                                           IsVisible="{Binding !Agent.IsReasoningVisible}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <controls:AgentChatInputQueueControl DockPanel.Dock="Bottom"
                                                     DataContext="{Binding InputQueue}"
                                                     IsVisible="{Binding InputQueue, Converter={x:Static converters:NotNullConverter.Instance}}"/>
                <controls:AgentChatOutputControl DataContext="{Binding Agent}"/>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:AgentChatDetailsViewModel">
            <StackPanel Spacing="10">
                <TextBlock Text="Chat details"
                           Classes="agent-section-title"/>
                <StackPanel Spacing="4">
                    <TextBlock Text="Display name"
                               Classes="muted"/>
                    <TextBox Text="{Binding DisplayName}"
                             IsReadOnly="True"
                             Classes="agent-detail-value copyable-text"/>
                </StackPanel>
                <StackPanel Spacing="4"
                            IsVisible="{Binding AgentName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="Agent name"
                               Classes="muted"/>
                    <TextBox Text="{Binding AgentName}"
                             IsReadOnly="True"
                             Classes="agent-detail-value copyable-text"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Session ID"
                               Classes="muted"/>
                    <TextBox Text="{Binding AgentSessionId}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Classes="agent-detail-value copyable-text"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Provider"
                               Classes="muted"/>
                    <TextBox Text="{Binding ModelProvider}"
                             IsReadOnly="True"
                             Classes="agent-detail-value copyable-text"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Model"
                               Classes="muted"/>
                    <TextBox Text="{Binding ModelId}"
                             IsReadOnly="True"
                             Classes="agent-detail-value copyable-text"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="API type"
                               Classes="muted"/>
                    <TextBox Text="{Binding ModelApiType}"
                             IsReadOnly="True"
                             Classes="agent-detail-value copyable-text"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Connection type"
                               Classes="muted"/>
                    <TextBox Text="{Binding ModelConnectionType}"
                             IsReadOnly="True"
                             Classes="agent-detail-value copyable-text"/>
                </StackPanel>
                <CheckBox Content="Show reasoning text"
                          IsChecked="{Binding IsReasoningVisible}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:AgentChatToolsDetailViewModel">
            <controls:AgentChatToolsDetailControl/>
        </DataTemplate>
        <DataTemplate DataType="vm:AgentChatToolViewModel">
            <StackPanel Spacing="10">
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource AgentToolHeaderTemplate}"/>
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource AgentToolDetailTemplate}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:AgentChatPlaceholderDetailViewModel">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Title}"
                           Classes="agent-section-title"/>
                <TextBlock Text="{Binding Description}"
                           Classes="muted"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:SubAgentBrowserViewModel">
            <DockPanel Margin="12">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Sub-agents"
                               Classes="agent-section-title"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"/>
                    <CheckBox DockPanel.Dock="Right"
                              Content="Hide completed"
                              IsChecked="{Binding HideCompleted}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding VisibleItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="agent-surface compact"
                                    Margin="0,2">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="✔"
                                               Classes="muted"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding CompletionState, Converter={x:Static converters:CompletionStateConverters.IsSucceeded}}"/>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="✘"
                                               Classes="muted"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding CompletionState, Converter={x:Static converters:CompletionStateConverters.IsFailed}}"/>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="⟳"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding CompletionState, Converter={x:Static converters:CompletionStateConverters.IsRunning}}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Classes="muted"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No sub-agents yet."
                           Classes="muted"
                           IsVisible="{Binding !VisibleItems.Count}"
                           TextWrapping="Wrap"/>
            </DockPanel>
        </DataTemplate>
        <!-- Fix #1112: the "Sub-agents (N)" group node's DetailContent is only ever the browser
             card. Individual sub-agent transcripts are hosted as their own DocumentDock Documents
             (each sub-agent nav item's DetailContent is its own ConversationDetail), so exactly one
             AgentChatOutputControl/WebView2 surface is materialised at a time — the overlapping
             Panel/ItemsControl deck that airspace-clobbered the transcripts is gone. -->
        <DataTemplate DataType="vm:SubAgentsContainerViewModel">
            <ContentControl Content="{Binding Browser}"/>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Border Classes="agent-pane">
        <Grid x:Name="EditorGrid">
            <Grid.ColumnDefinitions>
                <!-- Issue #1051: MinWidth=160 (was 0) so a drag can never collapse the tree pane
                     into the native output surface; relaxed to 0 by SetTreeCollapsed for the
                     intentional programmatic full-collapse. -->
                <ColumnDefinition Width="280"
                                  MinWidth="160"
                                  MaxWidth="480"/>
                <ColumnDefinition Width="24"
                                  MinWidth="24"
                                  MaxWidth="24"/>
                <!-- Issue #1051: MinWidth=240 so a drag can never squeeze the native HTML output
                     pane to ~0 and hide the splitter behind the WebView airspace. -->
                <ColumnDefinition Width="*"
                                  MinWidth="240"/>
            </Grid.ColumnDefinitions>
            <!-- Issue #1111: SelectedItem is two-way bound to AgentViewModel.SelectedEditorItem so
                 programmatic navigation (initial selection, tree collapse, sub-agent jump-button)
                 also drives TreeViewItem.IsSelected — the visual key for the blue .selected
                 recolour in the shared entity-card style. Code-behind expands ancestors on VM
                 selection changes so the target container is materialised. -->
            <TreeView x:Name="NavigationTree"
                      ItemsSource="{Binding EditorItems}"
                      SelectedItem="{Binding SelectedEditorItem, Mode=TwoWay}"
                      ItemTemplate="{StaticResource AgentNavigationTreeHeaderItemTemplate}"
                      Classes="entity-card-tree-view entity-card-tree-sticky"
                      MinWidth="160"
                      SelectionChanged="OnEditorSelectionChanged"
                      PointerEntered="OnNavigationTreePointerEntered"
                      PointerExited="OnNavigationTreePointerExited"
                      Grid.Column="0">
                <TreeView.Styles>
                    <Style Selector="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>
            </TreeView>

            <GridSplitter x:Name="SplitterHost"
                          Grid.Column="1"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          Classes="main-splitter"
                          ResizeBehavior="PreviousAndNext"/>
            <ToggleButton x:Name="TreeCollapseToggle"
                          Classes="pane-collapser"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Grid.Column="1"
                          Click="OnTreeCollapseToggleClicked"/>
            <!-- Issue #1035: the detail region is a locked, tab-strip-less Dock.Avalonia
                 DocumentDock (cache-N/show-one). Every nav node's DetailContent —
                 including every sub-agent child — is a first-class cached Document, so the panel is
                 never blank. Docking is fully disabled (IsDockingEnabled=False), the floating-window
                 layer is off, and the tab strip is hidden via the scoped DockDocumentControlTabStripVisible
                 resource. Tree selection drives the active document via AgentViewModel.SelectedEditorItem. -->
            <dock:DockControl Grid.Column="2"
                              Layout="{Binding DetailLayout}"
                              IsDockingEnabled="False"
                              EnableManagedWindowLayer="False"
                              ts:DockTabSwitch.InstallOnTopLevel="True"
                              ts:DockTabSwitch.Enabled="True">
                <ts:DockTabSwitch.Bindings>
                    <ts:DockTabSwitchBindings>
                        <ts:DockTabSwitchGestures Modifiers="Control,Alt"
                                                  Keys="Digits"
                                                  Scope="AllSwitchable" />
                    </ts:DockTabSwitchBindings>
                </ts:DockTabSwitch.Bindings>
                <dock:DockControl.Resources>
                    <x:Boolean x:Key="DockDocumentControlTabStripVisible">False</x:Boolean>
                </dock:DockControl.Resources>
                <dock:DockControl.DataTemplates>
                    <DataTemplate DataType="vm:AgentDetailDocument">
                        <ContentControl Content="{Binding DetailContent}"/>
                    </DataTemplate>
                </dock:DockControl.DataTemplates>
            </dock:DockControl>
        </Grid>
    </Border>
</UserControl>
