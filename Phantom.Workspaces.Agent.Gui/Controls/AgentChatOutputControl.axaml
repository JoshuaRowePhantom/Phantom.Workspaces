<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.Agent.Gui.ViewModels"
             x:Class="Phantom.Workspaces.Agent.Gui.Controls.AgentChatOutputControl"
             x:CompileBindings="False"
             x:DataType="vm:AgentViewModel"
             Classes="agent-chat-output-root">
    <UserControl.Styles>
        <StyleInclude Source="avares://Phantom.Workspaces.Agent.Gui/Styles/ChatDocumentStyles.axaml" />
        <StyleInclude Source="avares://Phantom.Workspaces.Agent.Gui/Styles/ChatSelectableTextBoxStyles.axaml" />
    </UserControl.Styles>
    <Grid>
        <FlowDocumentScrollViewer x:Name="HistoryDocument"
                                 Document="{Binding OutputDocument}"
                                 Foreground="{DynamicResource Theme.Class.normal.Foreground}"
                                  ShowPageBounds="False" />
        <Grid x:Name="SelectableOutputContainer" RowDefinitions="*,Auto">
            <ScrollViewer x:Name="SelectableOutputScrollViewer"
                          Grid.Row="0"
                          Classes="agent-chat-output-scrollviewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <SelectableTextBlock x:Name="SelectableOutputText"
                                    Classes="agent-chat-output-text copyable-text" />
            </ScrollViewer>
            <ProgressBar x:Name="SelectableOutputProgressBar"
                         Grid.Row="1"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsChatRunning}"
                         Classes="agent-chat-running-progress" />
        </Grid>
    </Grid>
</UserControl>
