<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.Agent.Gui.ViewModels"
             x:Class="Phantom.Workspaces.Agent.Gui.Controls.AgentChatOutputControl"
             x:CompileBindings="False"
             x:DataType="vm:AgentViewModel"
             Classes="agent-chat-output-root">
    <FlowDocumentScrollViewer x:Name="HistoryDocument"
                              Document="{Binding OutputDocument}"
                              Foreground="{DynamicResource Theme.Class.normal.Foreground}"
                              ShowPageBounds="False" />
</UserControl>
