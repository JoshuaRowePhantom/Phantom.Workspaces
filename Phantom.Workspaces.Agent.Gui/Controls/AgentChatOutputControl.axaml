<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.Agent.Gui.ViewModels"
             x:Class="Phantom.Workspaces.Agent.Gui.Controls.AgentChatOutputControl"
             x:CompileBindings="False"
             x:DataType="vm:AgentViewModel"
             Classes="agent-chat-output-root">
    <Grid RowDefinitions="*,Auto">
        <Border x:Name="BrowserHost"
                Grid.Row="0" />
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*">
            <CheckBox x:Name="AutoScrollToggle"
                      Grid.Column="0"
                      Content="Auto-scroll"
                      IsChecked="True"
                      Classes="agent-chat-autoscroll-toggle"
                      IsCheckedChanged="OnAutoScrollToggleChanged" />
            <ProgressBar x:Name="OutputProgressBar"
                         Grid.Column="1"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsChatRunning}"
                         Classes="agent-chat-running-progress" />
        </Grid>
    </Grid>
</UserControl>
