<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.Agent.Gui.ViewModels"
             x:Class="Phantom.Workspaces.Agent.Gui.Controls.QueueComposerControl"
             x:DataType="vm:QueueComposerViewModel"
             Background="Transparent">
    <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="8">
            <TextBox x:Name="InputBox"
                     Grid.Column="0"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding PlaceholderText}"
                     AcceptsReturn="True"
                     MinHeight="36"
                     FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                     FontSize="13"
                     Background="#242424"
                     Foreground="#E0E0E0"
                     CaretBrush="#E0E0E0"
                     BorderBrush="#3A3A3A"/>
            <Button Grid.Column="1"
                    Command="{Binding SubmitCommand}"
                    Content="{Binding SubmitButtonGlyph}"
                    Classes="queue-glyph-button"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    MinHeight="36"
                    Padding="12,0"
                    VerticalAlignment="Bottom"/>
            <Border Grid.Column="2"
                    Background="{Binding SubmitStatusOption.Background}"
                    BorderBrush="{Binding SubmitStatusOption.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="999"
                    MinHeight="36"
                    Padding="0"
                    VerticalAlignment="Bottom">
                <Button Background="Transparent"
                        BorderThickness="0"
                        Classes="queue-action-button"
                        HorizontalAlignment="Right">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Command="{Binding SetQueueImmediacyCommand}"
                                      CommandParameter="{Binding ImmediateImmediacyOption}"
                                      Padding="0">
                                <MenuItem.Header>
                                    <Border Background="{Binding ImmediateImmediacyOption.Background}"
                                            BorderBrush="{Binding ImmediateImmediacyOption.BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="999"
                                            Padding="10,4">
                                        <TextBlock Text="{Binding ImmediateImmediacyOption.Label}"
                                                   Foreground="{Binding ImmediateImmediacyOption.Foreground}"
                                                   FontSize="11"/>
                                    </Border>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Command="{Binding SetQueueImmediacyCommand}"
                                      CommandParameter="{Binding QueuedImmediacyOption}"
                                      Padding="0">
                                <MenuItem.Header>
                                    <Border Background="{Binding QueuedImmediacyOption.Background}"
                                            BorderBrush="{Binding QueuedImmediacyOption.BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="999"
                                            Padding="10,4">
                                        <TextBlock Text="{Binding QueuedImmediacyOption.Label}"
                                                   Foreground="{Binding QueuedImmediacyOption.Foreground}"
                                                   FontSize="11"/>
                                    </Border>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Command="{Binding SetQueueImmediacyCommand}"
                                      CommandParameter="{Binding HeldImmediacyOption}"
                                      Padding="0">
                                <MenuItem.Header>
                                    <Border Background="{Binding HeldImmediacyOption.Background}"
                                            BorderBrush="{Binding HeldImmediacyOption.BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="999"
                                            Padding="10,4">
                                        <TextBlock Text="{Binding HeldImmediacyOption.Label}"
                                                   Foreground="{Binding HeldImmediacyOption.Foreground}"
                                                   FontSize="11"/>
                                    </Border>
                                </MenuItem.Header>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding SubmitStatusOption.Label}"
                                   Foreground="{Binding SubmitStatusOption.Foreground}"
                                   FontSize="11"/>
                        <TextBlock Text="▾"
                                   Foreground="{Binding SubmitStatusOption.Foreground}"
                                   FontSize="10"/>
                    </StackPanel>
                </Button>
            </Border>
        </Grid>
        <ItemsControl ItemsSource="{Binding AttachmentPreviews}"
                      IsVisible="{Binding HasAttachments}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:QueueComposerAttachmentViewModel">
                    <Border Background="#303030"
                            BorderBrush="#505050"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6">
                        <StackPanel Spacing="4">
                            <Image Source="{Binding Preview}"
                                   Width="96"
                                   Height="64"
                                   Stretch="UniformToFill"/>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <TextBlock Text="{Binding Label}"
                                           FontSize="11"
                                           Foreground="#D0D0D0"/>
                                <Button Command="{Binding RemoveCommand}"
                                        CommandParameter="{Binding}"
                                        Content="✕"
                                        Classes="queue-glyph-button queue-danger-button"
                                        BorderThickness="1"
                                        MinWidth="20"
                                        MinHeight="20"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
