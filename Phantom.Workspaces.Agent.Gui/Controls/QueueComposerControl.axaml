<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.Agent.Gui.ViewModels"
             x:Class="Phantom.Workspaces.Agent.Gui.Controls.QueueComposerControl"
             x:DataType="vm:QueueComposerViewModel"
             Classes="queue-composer-root">
    <StackPanel Spacing="6">
        <Border IsVisible="{Binding Completions.IsVisible}" Classes="slash-completions-popup">
            <ItemsControl ItemsSource="{Binding Completions.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SlashCompletionItemViewModel">
                        <Border Classes="slash-completion-item"
                                Classes.selected="{Binding IsSelected}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Label}" FontWeight="{Binding LabelWeight}" />
                                <TextBlock Text="{Binding Description}" Classes="muted caption"
                                           IsVisible="{Binding HasDescription}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <Grid ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="8">
            <TextBox x:Name="InputBox"
                     Grid.Column="0"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{Binding PlaceholderText}"
                     AcceptsReturn="True"
                     MinHeight="36"
                     Classes="terminal-mono terminal-editor queue-text-editor"/>
            <Button Grid.Column="1"
                    Command="{Binding SubmitCommand}"
                    Content="{Binding SubmitButtonGlyph}"
                    Classes="queue-glyph-button queue-submit-button"
                    MinHeight="36"
                    VerticalAlignment="Bottom"
                    IsVisible="{Binding !CanCreateQueues}"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        IsVisible="{Binding CanCreateQueues}">
                <Button Command="{Binding SubmitCommand}"
                        Content="{Binding SubmitButtonGlyph}"
                        Classes="queue-glyph-button queue-submit-button"
                        MinHeight="36"
                        VerticalAlignment="Bottom" />
                <Button Content="▾"
                        Classes="queue-glyph-button queue-submit-dropdown-button"
                        MinHeight="36"
                        VerticalAlignment="Bottom">
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight">
                            <MenuItem Command="{Binding SubmitCommand}"
                                      Header="↵  Send" />
                            <MenuItem Command="{Binding SubmitToNewQueueCommand}"
                                      Header="⊕  Send to new queue" />
                            <MenuItem Command="{Binding CreateNewQueueCommand}"
                                      Header="＋  New queue" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <Border Grid.Column="2"
                    Classes="queue-status-pill dynamic"
                    IsVisible="{Binding IsDefaultComposer}">
                <Button Classes="queue-action-button queue-status-picker-button">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Command="{Binding SetQueueImmediacyCommand}"
                                      CommandParameter="{Binding ImmediateImmediacyOption}"
                                      Header="{Binding ImmediateImmediacyOption}"
                                      Classes="queue-immediacy-menu-item">
                            </MenuItem>
                            <MenuItem Command="{Binding SetQueueImmediacyCommand}"
                                      CommandParameter="{Binding QueuedImmediacyOption}"
                                      Header="{Binding QueuedImmediacyOption}"
                                      Classes="queue-immediacy-menu-item">
                            </MenuItem>
                            <MenuItem Command="{Binding SetQueueImmediacyCommand}"
                                      CommandParameter="{Binding HeldImmediacyOption}"
                                      Header="{Binding HeldImmediacyOption}"
                                      Classes="queue-immediacy-menu-item">
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding SubmitStatusOption.Label}"
                                   Classes="queue-immediacy-label queue-status-label"
                                   />
                        <TextBlock Text="▾"
                                   Classes="queue-immediacy-caret queue-status-caret"
                                   />
                    </StackPanel>
                </Button>
            </Border>
        </Grid>
        <TextBlock Text="{Binding FormattedModeHint}"
                   IsVisible="{Binding FormattedModeHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Classes="caption muted"
                   Margin="4,0,0,0" />
        <ItemsControl ItemsSource="{Binding AttachmentPreviews}"
                      IsVisible="{Binding HasAttachments}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:QueueComposerAttachmentViewModel">
                    <Border Classes="agent-chip">
                        <StackPanel Spacing="4">
                            <Image Source="{Binding Preview}"
                                   Width="96"
                                   Height="64"
                                   Stretch="UniformToFill"/>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <TextBlock Text="{Binding Label}"
                                           Classes="agent-chip-label"/>
                                <Button Command="{Binding RemoveCommand}"
                                        CommandParameter="{Binding}"
                                        Content="✕"
                                        Classes="queue-glyph-button queue-danger-button"
                                        BorderThickness="1"
                                        MinWidth="20"
                                        MinHeight="20"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
