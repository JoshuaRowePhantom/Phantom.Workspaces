<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.Agent.Gui.ViewModels"
             xmlns:controls="using:Phantom.Workspaces.Agent.Gui.Controls"
             xmlns:sharedControls="using:Phantom.Workspaces.Gui.Shared.Controls"
             x:Class="Phantom.Workspaces.Agent.Gui.Controls.AgentChatInputQueueControl"
             x:CompileBindings="False"
             x:DataType="vm:InputQueueViewModel"
             Classes="agent-chat-input-queue-root">
    <Border Classes="agent-chat-input-queue-container">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Queues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:InputQueueGroupViewModel">
                        <Border Classes="queue-group-card">
                            <StackPanel Spacing="6">
                                <DockPanel>
                                    <TextBlock Text="{Binding Name}"
                                               IsVisible="{Binding ShowName}"
                                               FontWeight="SemiBold"
                                               Classes="queue-group-title"/>
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                HorizontalAlignment="Right">
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource QueueImmediacyPickerTemplate}"
                                                        IsVisible="{Binding !IsDefault}"/>
                                        <Button Command="{Binding ToggleComposerCommand}"
                                                Content="+"
                                                Classes="queue-glyph-button"
                                                IsVisible="{Binding CanToggleComposer}"/>
                                        <Button Command="{Binding RemoveQueueCommand}"
                                                IsVisible="{Binding CanRemoveQueue}"
                                                Classes="queue-glyph-button queue-danger-button"
                                                BorderThickness="1"
                                                CornerRadius="999"
                                                Content="✕"/>
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Items}"
                                              IsVisible="{Binding HasItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:InputQueueEntryViewModel">
                                            <Border Classes="queue-item-card">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      RowDefinitions="Auto,Auto"
                                                      ColumnSpacing="8"
                                                      RowSpacing="6">
                                                    <StackPanel IsVisible="{Binding IsEditing}"
                                                               Spacing="6">
                                                        <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                                 x:Name="EditBox"
                                                                 AcceptsReturn="True"
                                                                 MinHeight="32"
                                                                 Classes="terminal-mono terminal-editor queue-entry-editor queue-text-editor"/>
                                                    <StackPanel Orientation="Horizontal"
                                                               HorizontalAlignment="Right"
                                                               Spacing="6">
                                                        <Button Command="{Binding SaveEditCommand}"
                                                                Content="Save"
                                                                Classes="queue-action-button"/>
                                                            <Button Command="{Binding CancelEditCommand}"
                                                                    Content="Cancel"
                                                                Classes="queue-action-button"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Button Command="{Binding EditCommand}"
                                                        Classes="queue-item-trigger"
                                                        IsVisible="{Binding IsNotEditing}"
                                                        Grid.Column="0"
                                                        Grid.Row="0">
                                                    <Button.KeyBindings>
                                                        <KeyBinding Gesture="F2"
                                                                    Command="{Binding EditCommand}"/>
                                                    </Button.KeyBindings>
                                                    <sharedControls:SafeSelectableTextBlock Text="{Binding Text}"
                                                                                          TextWrapping="Wrap"
                                                                                          Classes="terminal-mono terminal-content queue-entry-content"/>
                                                </Button>

                                                <ItemsControl Grid.Row="1"
                                                              Grid.Column="0"
                                                              Grid.ColumnSpan="2"
                                                              Classes="queue-entry-attachments"
                                                                  ItemsSource="{Binding Attachments}"
                                                                  IsVisible="{Binding HasAttachments}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"
                                                                           Spacing="6"
                                                                           HorizontalAlignment="Left"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vm:InputQueueEntryAttachmentViewModel">
                                                                <Border Classes="queue-attachment-pill">
                                                                    <StackPanel Orientation="Horizontal"
                                                                               Spacing="6"
                                                                               VerticalAlignment="Center">
                                                                        <Border Classes="queue-attachment-preview"
                                                                                Width="28"
                                                                                Height="20"
                                                                                ClipToBounds="True">
                                                                            <Button Classes="queue-preview-image-button"
                                                                                    Click="OnQueueAttachmentImageClicked"
                                                                                    IsVisible="{Binding HasPreview}">
                                                                                <Image Source="{Binding Preview}"
                                                                                       Width="28"
                                                                                       Height="20"
                                                                                       Stretch="UniformToFill"/>
                                                                            </Button>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Label}"
                                                                                  Classes="queue-attachment-label"
                                                                                  VerticalAlignment="Center"/>
                                                                        <Button Command="{Binding RemoveCommand}"
                                                                               Content="✕"
                                                                               Classes="queue-glyph-button queue-danger-button queue-danger-pill"
                                                                               MinWidth="20"
                                                                               MinHeight="20"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="6"
                                                                VerticalAlignment="Center">
                                                        <Button Command="{Binding RemoveCommand}"
                                                                Content="✕"
                                                                Classes="queue-glyph-button queue-danger-button queue-danger-pill"
                                                                VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border IsVisible="{Binding HasComposer}">
                                    <controls:QueueComposerControl DataContext="{Binding Composer}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
