<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.Agent.Gui.ViewModels"
             xmlns:controls="using:Phantom.Workspaces.Agent.Gui.Controls"
             x:Class="Phantom.Workspaces.Agent.Gui.Controls.AgentChatToolsDetailControl"
             x:CompileBindings="False"
             x:DataType="vm:AgentChatToolsDetailViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Phantom.Workspaces.Agent.Gui/Controls/AgentChatToolTemplates.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Issue #1064: no inline ScrollViewer.* setters; inherit the two-regime entity-card-tree
         wrapper (H=Auto + items-region MinWidth/viewport cap) so content wraps and a horizontal
         scrollbar appears only below the minimum width instead of clipping. -->
    <TreeView ItemsSource="{Binding DisplayedRootItems}"
              ItemTemplate="{StaticResource AgentNavigationTreeDetailItemTemplate}"
              Classes="entity-card-tree entity-card-tree-sticky">
        <TreeView.Styles>
            <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
        </TreeView.Styles>
    </TreeView>
</UserControl>
