<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Phantom.Workspaces.Agent.Gui"
        xmlns:sharedControls="using:Phantom.Workspaces.Gui.Shared.Controls"
        x:Class="Phantom.Workspaces.Agent.Gui.LogWindow"
        x:Name="Root"
        x:DataType="local:LogWindow"
        Width="1000"
        Height="600"
        MinWidth="400"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        Title="Agent Log"
        Classes="agent-window">
    <DockPanel Classes="agent-dialog-root">
        <StackPanel DockPanel.Dock="Bottom"
                    Classes="agent-dialog-actions">
            <Button Content="Clear"
                    Click="OnClearClicked"
                    Classes="queue-action-button"/>
            <Button Content="Close"
                    Click="OnCloseClicked"
                    Classes="queue-action-button"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="Log"
                   Classes="agent-dialog-title"/>
        <CheckBox DockPanel.Dock="Top"
                  Content="Word wrap"
                  IsChecked="{Binding IsWordWrapEnabled, Mode=TwoWay}"
                  Classes="agent-option-toggle"/>

        <Border Classes="agent-surface">
            <ListBox x:Name="LogItems"
                     ScrollViewer.HorizontalScrollBarVisibility="{Binding LogHorizontalScrollBarVisibility}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <sharedControls:SafeSelectableTextBlock Text="{Binding}"
                                             TextWrapping="{Binding LogTextWrapping, ElementName=Root}"
                                             Classes="terminal-mono terminal-detail agent-log-line"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
