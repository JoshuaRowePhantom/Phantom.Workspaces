<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Phantom.Workspaces.Agent.Gui.ImagePreviewWindow"
        Width="1000"
        Height="800"
        MinWidth="320"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        Title="Image preview"
        Classes="agent-window">
    <DockPanel Classes="agent-dialog-root compact">
        <StackPanel DockPanel.Dock="Bottom"
                    Classes="agent-dialog-actions">
            <Button Content="Copy"
                    Click="OnCopyClicked"
                    Classes="queue-action-button"/>
            <Button Content="Close"
                    Click="OnCloseClicked"
                    Classes="queue-action-button"/>
        </StackPanel>

        <Border Classes="agent-surface compact">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Image x:Name="PreviewImage"
                       Stretch="None"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
