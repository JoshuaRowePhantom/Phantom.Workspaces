<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Phantom.Workspaces.Agent.Gui.ViewModels"
        xmlns:controls="using:Phantom.Workspaces.Agent.Gui.Controls"
        x:Class="Phantom.Workspaces.Agent.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Agent.DisplayName}"
        Width="1200" Height="800"
        MinWidth="600" MinHeight="400"
        Classes="agent-window">
    <Window.KeyBindings>
        <KeyBinding Gesture="Cancel"         Command="{Binding Agent.InterruptCommand}"/>
        <KeyBinding Gesture="Pause"          Command="{Binding Agent.InputQueue.ToggleHoldAllQueuesCommand}"/>
        <KeyBinding Gesture="Shift+Pause"    Command="{Binding Agent.InputQueue.HoldAllQueuesCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Pause" Command="{Binding Agent.InputQueue.UnholdAllQueuesCommand}"/>
    </Window.KeyBindings>

    <DockPanel>
        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Classes="agent-titlebar">
            <TextBlock Text="{Binding Agent.DisplayName}"
                       Classes="agent-main-title"/>
        </Border>

        <!-- Main content area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="80"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Runtime browser (placeholder) -->
            <Border Grid.Column="0" Classes="agent-pane">
                <StackPanel Spacing="12" Margin="12" VerticalAlignment="Top">
                    <TextBlock Text="Agent Details"
                               Classes="agent-section-title"/>
                    <TextBlock Text="Agent Session ID" Classes="muted"/>
                    <TextBox Text="{Binding Agent.AgentSessionId, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Classes="agent-detail-value copyable-text"/>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Classes="main-splitter"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Right: Agent chat -->
            <DockPanel Grid.Column="2">
                <controls:AgentInputQueueControl DockPanel.Dock="Bottom"
                                                 DataContext="{Binding Agent.InputQueue}"/>
                <controls:ChatAgentOutputControl DataContext="{Binding Agent}"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
