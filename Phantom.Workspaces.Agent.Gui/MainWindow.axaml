<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Phantom.Workspaces.Agent.Gui.ViewModels"
        xmlns:controls="using:Phantom.Workspaces.Agent.Gui.Controls"
        x:Class="Phantom.Workspaces.Agent.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Agent.DisplayName}"
        Width="1200" Height="800"
        MinWidth="600" MinHeight="400"
        Classes="agent-window">
    <Window.KeyBindings>
        <!-- Windows reports the Pause/Break key as VK_CANCEL (Key.Cancel) whenever Ctrl is held, so
             Ctrl+Break is Ctrl+Cancel and Ctrl+Shift+Break is Ctrl+Shift+Cancel. -->
        <KeyBinding Gesture="Ctrl+Cancel"    Command="{Binding Agent.InterruptCommand}"/>
        <KeyBinding Gesture="Pause"          Command="{Binding Agent.InputQueue.ToggleHoldAllQueuesCommand}"/>
        <KeyBinding Gesture="Shift+Pause"    Command="{Binding Agent.InputQueue.HoldAllQueuesCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Cancel" Command="{Binding Agent.InputQueue.UnholdAllQueuesCommand}"/>
    </Window.KeyBindings>

    <DockPanel>
        <!-- Title bar -->
        <Border DockPanel.Dock="Top" Classes="agent-titlebar">
            <TextBlock Text="{Binding Agent.DisplayName}"
                       Classes="agent-main-title"/>
        </Border>

        <!-- Main content area -->
        <controls:AgentChatEditorControl DataContext="{Binding Agent}"/>
    </DockPanel>
</Window>
