<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Phantom.Workspaces.Agent.Gui.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Light"
                                 Source="avares://Phantom.Workspaces.Gui.Shared/Themes/Light.axaml" />
                <ResourceInclude x:Key="Dark"
                                 Source="avares://Phantom.Workspaces.Gui.Shared/Themes/Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Phantom.Workspaces.Agent.Gui/Styles/QueueStyles.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />

        <StyleInclude Source="avares://Phantom.Workspaces.Gui.Shared/Styles/SharedStyles.axaml" />
        <StyleInclude Source="avares://Phantom.Workspaces.Gui.Shared/Styles/AgentChatStatusLineStyles.axaml" />
        <StyleInclude Source="avares://Phantom.Workspaces.Gui.Shared/Styles/SlashCompletionsStyles.axaml" />
    </Application.Styles>
</Application>
