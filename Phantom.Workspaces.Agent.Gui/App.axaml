<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Phantom.Workspaces.Agent.Gui.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button.queue-action-button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="Button.queue-glyph-button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.queue-danger-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#666666" />
            <Setter Property="Foreground" Value="#9A9A9A" />
        </Style>
        <Style Selector="Button.queue-danger-button:pointerover">
            <Setter Property="BorderBrush" Value="#8A3A3A" />
            <Setter Property="Foreground" Value="#FF6666" />
        </Style>
        <Style Selector="Button.queue-item-trigger">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Border.queue-status-pill">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </Application.Styles>
</Application>
