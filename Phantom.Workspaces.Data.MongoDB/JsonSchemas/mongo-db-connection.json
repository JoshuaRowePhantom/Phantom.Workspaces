{
  "$id": "https://schemas.workspaces.phantom.to/mongo-db-connection.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "const": "container"
        },
        "container-name": {
          "type": "string",
          "minLength": 1
        },
        "data-directory": {
          "type": "string",
          "minLength": 1
        },
        "host-port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database-name": {
          "type": "string",
          "minLength": 1
        },
        "collection-name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "container-name",
        "data-directory",
        "database-name",
        "collection-name"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "const": "external"
        },
        "connection-string": {
          "type": "string",
          "minLength": 1
        },
        "database-name": {
          "type": "string",
          "minLength": 1
        },
        "collection-name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "connection-string",
        "database-name",
        "collection-name"
      ],
      "additionalProperties": false
    }
  ]
}