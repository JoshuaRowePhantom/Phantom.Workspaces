<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AgentSchema" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="GitHub.Copilot.SDK" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Meziantou.Framework.Win32.CredentialManager" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Phantom.Workspaces.Data.Core\Phantom.Workspaces.Data.Core.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Data.Web.Client\Phantom.Workspaces.Data.Web.Client.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Llm.Interfaces\Phantom.Workspaces.Llm.Interfaces.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Llm.Echo\Phantom.Workspaces.Llm.Echo.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Data.MongoDB\Phantom.Workspaces.Data.MongoDB.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Transport\Phantom.Workspaces.Transport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="JsonSchemas\*.json" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="JsonSchemas\*.json" />
  </ItemGroup>
  <!-- Issue #1376: the GitHub.Copilot.SDK targets copy only the CLI binary (and optional
       runtime.node) to runtimes\<rid>\native, NOT the tarball's LICENSE.md. The GitHub Copilot
       CLI License requires shipping a copy of that LICENSE.md and retaining its notices whenever
       the (unmodified) CLI binary is redistributed. Register the downloaded LICENSE.md as content
       alongside the binary so it flows transitively to the GUI publish/installer payload. The
       source path mirrors the SDK's own cache layout (see GitHub.Copilot.SDK.targets). -->
  <Target Name="RegisterCopilotCliLicense"
          BeforeTargets="GetCopyToOutputDirectoryItems"
          DependsOnTargets="_DownloadCopilotCli"
          Condition="'$(TargetFramework)' != '' And '$(CopilotSkipCliDownload)' != 'true' And '$(_CopilotPlatform)' != ''">
    <PropertyGroup>
      <_CopilotLicenseCacheDir>$(IntermediateOutputPath)copilot-cli\$(CopilotCliVersion)\$(_CopilotPlatform)</_CopilotLicenseCacheDir>
      <_CopilotLicensePath>$(_CopilotLicenseCacheDir)\LICENSE.md</_CopilotLicensePath>
    </PropertyGroup>
    <Error Condition="!Exists('$(_CopilotLicensePath)')"
           Text="GitHub Copilot CLI LICENSE.md not found at '$(_CopilotLicensePath)'. The redistributed CLI must ship its LICENSE.md unmodified (issue #1376)." />
    <ItemGroup>
      <ContentWithTargetPath Include="$(_CopilotLicensePath)"
                             TargetPath="runtimes\$(_CopilotRid)\native\LICENSE.md"
                             CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>