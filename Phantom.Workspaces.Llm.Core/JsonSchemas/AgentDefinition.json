{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom-workspaces/schemas/agent-definition.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "name",
    "model"
  ],
  "properties": {
    "kind": {
      "const": "prompt"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "additionalInstructions": {
      "type": "string"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "enum": [
            "echo",
            "github-models",
            "github-copilot",
            "github-copilot-subagent",
            "sub-agent-dispatcher",
            "ollama",
            "openai",
            "azure-openai"
          ]
        },
        "apiType": {
          "type": "string",
          "minLength": 1
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string"
            },
            "apiKey": {
              "type": "string"
            },
            "providerType": {
              "type": "string",
              "description": "Provider type understood by the Copilot runtime. Defaults to 'openai'."
            },
            "wireApi": {
              "type": "string",
              "description": "Wire API the endpoint speaks. Defaults to 'chat-completions'."
            },
            "wireModel": {
              "type": "string",
              "description": "Wire model name when it differs from the model id."
            },
            "headers": {
              "type": "object",
              "description": "Extra request headers forwarded to the custom endpoint.",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "temperature": {
              "type": "number"
            },
            "topP": {
              "type": "number"
            },
            "topK": {
              "type": "integer"
            },
            "frequencyPenalty": {
              "type": "number"
            },
            "presencePenalty": {
              "type": "number"
            },
            "maxOutputTokens": {
              "type": "integer"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/mcpTool"
          },
          {
            "$ref": "#/$defs/githubCliBuiltinToolsTool"
          },
          {
            "$ref": "#/$defs/tool"
          },
          {
            "$ref": "#/$defs/agentDefinitionTool"
          }
        ]
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "description": "Tool kind. Recognized provider-specific kinds include mcp, agent-definition, and github-cli-builtin-tools."
        },
        "description": {
          "type": "string"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "not": {
        "properties": {
          "kind": {
            "enum": [
              "github-cli-builtin-tools",
              "mcp"
            ]
          }
        },
        "required": [
          "kind"
        ]
      }
    },
    "mcpTool": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "connection",
        "serverName"
      ],
      "examples": [
        {
          "name": "example-oauth",
          "kind": "mcp",
          "description": "Example OAuth-authenticated MCP server",
          "connection": {
            "kind": "oauth",
            "endpoint": "https://mcp.example.com/",
            "clientId": "${SECRET:ExampleClientId}",
            "scopes": [
              "read",
              "write"
            ]
          },
          "serverName": "example",
          "serverDescription": "Example remote MCP server authenticated with OAuth",
          "approvalMode": {
            "kind": "never"
          }
        }
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "const": "mcp"
        },
        "description": {
          "type": "string"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "connection": {
          "type": "object",
          "required": [
            "kind"
          ],
          "description": "MCP server connection. Discriminated by 'kind'. Supported kinds: Anonymous, key, oauth.",
          "oneOf": [
            {
              "title": "Anonymous",
              "additionalProperties": false,
              "required": [
                "kind",
                "endpoint"
              ],
              "properties": {
                "kind": {
                  "const": "Anonymous"
                },
                "endpoint": {
                  "type": "string",
                  "minLength": 1,
                  "description": "http(s):// MCP URL, or stdio://?command=<exe>&arg=<a>&cwd=<dir> for a local process."
                }
              },
              "examples": [
                {
                  "kind": "Anonymous",
                  "endpoint": "https://example.com/mcp/"
                },
                {
                  "kind": "Anonymous",
                  "endpoint": "stdio://?command=uvx&arg=some-mcp-server"
                }
              ]
            },
            {
              "title": "ApiKey",
              "additionalProperties": false,
              "required": [
                "kind",
                "endpoint",
                "apiKey"
              ],
              "properties": {
                "kind": {
                  "const": "key"
                },
                "endpoint": {
                  "type": "string",
                  "minLength": 1,
                  "description": "http(s):// MCP URL (stdio:// with an apiKey is rejected at runtime)."
                },
                "apiKey": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Bearer token. Supports ${ENV_VAR} and ${SECRET:Name}. Special-case ${GITHUB_TOKEN} falls back to gh auth token."
                }
              },
              "examples": [
                {
                  "kind": "key",
                  "endpoint": "https://api.githubcopilot.com/mcp/",
                  "apiKey": "${GITHUB_TOKEN}"
                }
              ]
            },
            {
              "title": "OAuth",
              "additionalProperties": false,
              "required": [
                "kind",
                "endpoint"
              ],
              "properties": {
                "kind": {
                  "const": "oauth"
                },
                "endpoint": {
                  "type": "string",
                  "minLength": 1,
                  "description": "http(s):// MCP resource endpoint. OAuth metadata is discovered from it (RFC 9728/8414)."
                },
                "clientId": {
                  "type": "string",
                  "description": "Optional. Omit to use dynamic client registration (RFC 7591). Supports ${ENV_VAR}/${SECRET:Name}."
                },
                "clientSecret": {
                  "type": "string",
                  "description": "Optional. Omit for a public client (PKCE). Supports ${SECRET:Name}."
                },
                "tokenUrl": {
                  "type": "string",
                  "description": "Optional explicit token endpoint; normally discovered automatically."
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "OAuth scopes to request."
                }
              },
              "examples": [
                {
                  "kind": "oauth",
                  "endpoint": "https://mcp.example.com/",
                  "scopes": [
                    "read",
                    "write"
                  ]
                },
                {
                  "kind": "oauth",
                  "endpoint": "https://mcp.example.com/",
                  "clientId": "${SECRET:ExampleClientId}",
                  "scopes": [
                    "api://example/.default"
                  ]
                }
              ]
            }
          ]
        },
        "serverName": {
          "type": "string",
          "minLength": 1
        },
        "serverDescription": {
          "type": "string"
        },
        "approvalMode": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "always"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "never"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "specify"
                },
                "alwaysRequireApprovalTools": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "neverRequireApprovalTools": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "allowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "agentDefinitionTool": {
      "type": "object",
      "description": "A named sub-agent that a dispatcher can instantiate.",
      "required": [
        "kind",
        "name",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "agent-definition"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "$ref": "https://phantom-workspaces/schemas/agent-definition.json",
          "description": "Inline agent definition. Mutually exclusive with manifest-reference."
        },
        "manifest-reference": {
          "$ref": "#/$defs/entityReference",
          "x-entity-types": [
            "agent-manifest"
          ],
          "description": "Entity reference to an existing agent-manifest entity. Mutually exclusive with definition."
        }
      }
    },
    "entityReference": {
      "description": "A reference to a workspace entity, either by entity id (uuid) or by entity name (path components). Mirrors core.json#/$defs/entity-reference for standalone evaluation.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ]
    },
    "builtinToolSet": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "tools"
          ]
        },
        {
          "required": [
            "isolated"
          ]
        }
      ],
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*|[a-zA-Z0-9_-]+|(builtin|custom|mcp):(\\*|[a-zA-Z0-9_-]+))$"
          }
        },
        "isolated": {
          "const": true
        }
      }
    },
    "githubCliBuiltinToolsTool": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "const": "github-cli-builtin-tools"
        },
        "description": {
          "type": "string"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "available-tools": {
          "$ref": "#/$defs/builtinToolSet"
        },
        "excluded-tools": {
          "$ref": "#/$defs/builtinToolSet"
        },
        "client-mode": {
          "enum": [
            "empty",
            "copilot-cli"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "client-mode": {
                "const": "empty"
              }
            },
            "required": [
              "client-mode"
            ]
          },
          "then": {
            "required": [
              "available-tools"
            ],
            "properties": {
              "available-tools": {
                "not": {
                  "properties": {
                    "tools": {
                      "maxItems": 0
                    }
                  },
                  "required": [
                    "tools"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
