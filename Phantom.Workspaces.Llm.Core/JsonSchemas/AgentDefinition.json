{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom-workspaces/schemas/agent-definition.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "name",
    "model"
  ],
  "properties": {
    "kind": {
      "const": "prompt"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "additionalInstructions": {
      "type": "string"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "enum": [
            "echo",
            "github",
            "ollama",
            "openai",
            "azure"
          ]
        },
        "apiType": {
          "type": "string",
          "minLength": 1
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string"
            },
            "apiKey": {
              "type": "string"
            }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "temperature": {
              "type": "number"
            },
            "topP": {
              "type": "number"
            },
            "topK": {
              "type": "integer"
            },
            "frequencyPenalty": {
              "type": "number"
            },
            "presencePenalty": {
              "type": "number"
            },
            "maxOutputTokens": {
              "type": "integer"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/mcpTool"
          },
          {
            "$ref": "#/$defs/tool"
          }
        ]
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "mcpTool": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "connection",
        "serverName"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "const": "mcp"
        },
        "description": {
          "type": "string"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "connection": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string"
            }
          }
        },
        "serverName": {
          "type": "string",
          "minLength": 1
        },
        "serverDescription": {
          "type": "string"
        },
        "approvalMode": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "always"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "never"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "specify"
                },
                "alwaysRequireApprovalTools": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "neverRequireApprovalTools": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "allowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
