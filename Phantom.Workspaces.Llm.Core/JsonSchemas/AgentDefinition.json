{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom-workspaces/schemas/agent-definition.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "name",
    "model"
  ],
  "properties": {
    "kind": {
      "const": "prompt"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "additionalInstructions": {
      "type": "string"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "enum": [
            "echo",
            "github-models",
            "github-copilot",
            "github-copilot-subagent",
            "ollama",
            "openai",
            "azure-openai"
          ]
        },
        "apiType": {
          "type": "string",
          "minLength": 1
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string"
            },
            "apiKey": {
              "type": "string"
            },
            "providerType": {
              "type": "string",
              "description": "Provider type understood by the Copilot runtime. Defaults to 'openai'."
            },
            "wireApi": {
              "type": "string",
              "description": "Wire API the endpoint speaks. Defaults to 'chat-completions'."
            },
            "wireModel": {
              "type": "string",
              "description": "Wire model name when it differs from the model id."
            },
            "headers": {
              "type": "object",
              "description": "Extra request headers forwarded to the custom endpoint.",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "temperature": {
              "type": "number"
            },
            "topP": {
              "type": "number"
            },
            "topK": {
              "type": "integer"
            },
            "frequencyPenalty": {
              "type": "number"
            },
            "presencePenalty": {
              "type": "number"
            },
            "maxOutputTokens": {
              "type": "integer"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/mcpTool"
          },
          {
            "$ref": "#/$defs/tool"
          },
          {
            "$ref": "#/$defs/agentDefinitionTool"
          }
        ]
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "mcpTool": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "connection",
        "serverName"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "const": "mcp"
        },
        "description": {
          "type": "string"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "connection": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string"
            }
          }
        },
        "serverName": {
          "type": "string",
          "minLength": 1
        },
        "serverDescription": {
          "type": "string"
        },
        "approvalMode": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "always"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "never"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "specify"
                },
                "alwaysRequireApprovalTools": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "neverRequireApprovalTools": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "allowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "agentDefinitionTool": {
      "type": "object",
      "description": "A named sub-agent that a dispatcher can instantiate.",
      "required": [
        "kind",
        "name",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "agent-definition"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "$ref": "https://phantom-workspaces/schemas/agent-definition.json",
          "description": "Inline agent definition. Mutually exclusive with manifest-reference."
        },
        "manifest-reference": {
          "$ref": "#/$defs/entityReference",
          "x-entity-types": [
            "agent-manifest"
          ],
          "description": "Entity reference to an existing agent-manifest entity. Mutually exclusive with definition."
        }
      }
    },
    "entityReference": {
      "description": "A reference to a workspace entity, either by entity id (uuid) or by entity name (path components). Mirrors core.json#/$defs/entity-reference for standalone evaluation.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ]
    }
  }
}
