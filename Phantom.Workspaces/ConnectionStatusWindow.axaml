<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Phantom.Workspaces.ViewModels"
        x:Class="Phantom.Workspaces.ConnectionStatusWindow"
        x:DataType="vm:ConnectionStatusViewModel"
        Width="600"
        Height="400"
        MinWidth="400"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Title="Network Connection Status">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
          Margin="16">
        <StackPanel Grid.Row="0"
                    IsVisible="{Binding HasLocalAccessPoint}"
                    Margin="0,0,0,16">
            <TextBlock Text="Local Access Point"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBox Text="{Binding LocalAccessPoint, Mode=OneWay}"
                     Classes="copyable-text"
                     ToolTip.Tip="The address this instance is reachable at on this machine" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    IsVisible="{Binding HasDevTunnel}"
                    Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                <TextBlock Text="Dev Tunnel" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="❗"
                           Foreground="Red"
                           Opacity="0.55"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasProblem}"
                           ToolTip.Tip="{Binding ProblemText}" />
            </StackPanel>

            <TextBlock Text="Name" Classes="muted" Margin="0,0,0,2" />
            <TextBox Text="{Binding TunnelName, Mode=OneWay}"
                     Classes="copyable-text"
                     Margin="0,0,0,8"
                     ToolTip.Tip="The dev tunnel name" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                <TextBlock Text="Status:" Classes="muted" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DevTunnelStatusText}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasProblem}" Margin="0,0,0,8">
                <TextBlock Text="Error" Classes="muted" Margin="0,0,0,2" />
                <TextBox Text="{Binding ProblemText, Mode=OneWay}"
                         Classes="copyable-text"
                         Foreground="Red"
                         TextWrapping="Wrap"
                         ToolTip.Tip="The dev tunnel error detail" />
            </StackPanel>

            <StackPanel IsVisible="{Binding HasAccessPoint}">
                <TextBlock Text="Dev Tunnel Access Point"
                           Classes="muted"
                           Margin="0,0,0,2" />
                <TextBox Text="{Binding AccessPoint, Mode=OneWay}"
                         Classes="copyable-text"
                         ToolTip.Tip="Select and copy this address to reach this instance remotely" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="Inbound Connections (instances connected to us)"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <Border Grid.Row="3" Classes="pane-container" Margin="0,0,0,16">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Inbound}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:InboundConnectionViewModel">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding ClientInstanceId}"
                                           FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Connected:" Classes="muted" />
                                    <TextBlock Text="{Binding ConnectedAt}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="In-flight:" Classes="muted" />
                                    <TextBlock Text="{Binding InFlightCount}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4"
                    IsVisible="{Binding HasRecentErrors}"
                    Margin="0,0,0,16">
            <TextBlock Text="Recent Errors (outbound request failures)"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <Border Classes="pane-container" MaxHeight="120">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding RecentErrors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentConnectivityErrorViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,4">
                                    <TextBlock Text="{Binding Timestamp}" Classes="muted" />
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="Red"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <Button Grid.Row="5"
                Content="Close"
                HorizontalAlignment="Right"
                Click="OnCloseClick" />
    </Grid>
</Window>
