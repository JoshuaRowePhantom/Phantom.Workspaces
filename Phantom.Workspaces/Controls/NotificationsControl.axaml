<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.ViewModels"
             xmlns:controls="using:Phantom.Workspaces.Controls"
             x:Class="Phantom.Workspaces.Controls.NotificationsControl"
             x:CompileBindings="False"
             Focusable="False">
    <controls:TransientPopupControl>
    <Border Classes="notifications-panel"
            Width="360"
            MaxHeight="480">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" 
                    Padding="12,8">
                <TextBlock Text="Notifications" 
                           FontWeight="SemiBold" />
            </Border>
            
            <!-- Empty state message -->
            <TextBlock Grid.Row="1"
                       Text="There are no notifications."
                       Classes="muted"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="16"
                       IsVisible="{Binding !HasRows}" />
            
            <!-- Notification list -->
            <ScrollViewer Grid.Row="1" 
                          MaxHeight="420"
                          IsVisible="{Binding HasRows}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotificationRowViewModel">
                            <Border Classes="interactive-row"
                                    Classes.highlighted="{Binding IsHighlighted}"
                                    Padding="8,4" Margin="4,2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0"
                                            Command="{Binding NavigateCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <!-- Bell slot — always present, visible only when running -->
                                            <Border Width="20" Height="20" VerticalAlignment="Center">
                                                <TextBlock Text="🔔"
                                                           Classes.notification-bell-ringing="{Binding IsRunning}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           IsVisible="{Binding IsRunning}" />
                                            </Border>
                                            <!-- Exclamation slot — always present, visible only when interesting -->
                                            <Border Width="20" Height="20" VerticalAlignment="Center">
                                                <TextBlock Text="!"
                                                           Classes="notification-unread-indicator"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           IsVisible="{Binding IsInteresting}" />
                                            </Border>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding TabTitle}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Heading}"
                                                           Classes="muted"
                                                           TextWrapping="NoWrap"
                                                           IsVisible="{Binding IsRunning}" />
                                                <TextBlock Text="{Binding Description}"
                                                           Classes="muted"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding HasDescription}" />
                                                <TextBlock Text="{Binding RelativeTime}" 
                                                           Classes="caption" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Command="{Binding SnoozeCommand}"
                                            Content="💤"
                                            VerticalAlignment="Top"
                                            Padding="6,4" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
    </controls:TransientPopupControl>
</UserControl>
