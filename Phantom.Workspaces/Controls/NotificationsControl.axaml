<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.ViewModels"
             x:Class="Phantom.Workspaces.Controls.NotificationsControl"
             x:CompileBindings="False">
    <Border Classes="notifications-panel"
            Background="{DynamicResource Theme.Notifications.Panel.Background}"
            CornerRadius="{DynamicResource Theme.Notifications.Panel.CornerRadius}"
            BoxShadow="{DynamicResource Theme.Notifications.Panel.BoxShadow}"
            Width="360"
            MaxHeight="480">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" 
                    Padding="12,8">
                <TextBlock Text="Notifications" 
                           FontWeight="SemiBold" />
            </Border>
            
            <!-- Empty state message -->
            <TextBlock Grid.Row="1"
                       Text="There are no notifications."
                       Classes="muted"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="16"
                       IsVisible="{Binding !HasRows}" />
            
            <!-- Notification list -->
            <ScrollViewer Grid.Row="1" 
                          MaxHeight="420"
                          IsVisible="{Binding HasRows}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotificationRowViewModel">
                            <Border Padding="8,4" Margin="0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Grid.Column="0"
                                            Command="{Binding NavigateCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="4">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding TabTitle}" />
                                                <TextBlock Text=" · " />
                                                <TextBlock Text="{Binding Reason}" 
                                                           Opacity="{DynamicResource Theme.Notifications.Row.ReasonOpacity}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding RelativeTime}" 
                                                       Opacity="{DynamicResource Theme.Notifications.Row.TimestampOpacity}" 
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Command="{Binding SnoozeCommand}"
                                            Content="💤"
                                            VerticalAlignment="Top"
                                            Padding="6,4" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
