<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.ViewModels"
             x:Class="Phantom.Workspaces.Controls.StatusControl"
             x:CompileBindings="False">
    <ProgressBar Classes="running-indicator"
                 Classes.succeeded="{Binding ErrorStatus, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ErrorStatus.Successful}}"
                 Classes.failed="{Binding ErrorStatus, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ErrorStatus.Error}}"
                 IsIndeterminate="{Binding RunningStatus, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:RunningStatus.Running}}" />
</UserControl>
