<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.ViewModels"
             x:Class="Phantom.Workspaces.Controls.StatusControl"
             x:CompileBindings="False">
    <Panel>
        <!-- Running indicator: visible when RunningStatus == Running -->
        <TextBlock Text="🧠"
                   Classes="agent-tab-header-brain thinking"
                   IsVisible="{Binding RunningStatus, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:RunningStatus.Running}}" />
        <!-- Success indicator: visible when ErrorStatus == Successful -->
        <TextBlock Text="✅"
                   IsHitTestVisible="False"
                   IsVisible="{Binding ErrorStatus, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ErrorStatus.Successful}}" />
        <!-- Error indicator: visible when ErrorStatus == Error -->
        <TextBlock Text="❗"
                   IsHitTestVisible="False"
                   IsVisible="{Binding ErrorStatus, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ErrorStatus.Error}}" />
    </Panel>
</UserControl>
