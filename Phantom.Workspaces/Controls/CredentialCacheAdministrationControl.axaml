<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.ViewModels"
             xmlns:access="using:Phantom.Workspaces.Llm.Interfaces.Access"
             x:Class="Phantom.Workspaces.Controls.CredentialCacheAdministrationControl"
             x:DataType="vm:CredentialCacheAdministrationViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="Local credential caches" FontWeight="Bold" />
        <TextBlock Text="Delete invalidates the selected local generation. Release memory and provider grants are unchanged." TextWrapping="Wrap" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        <TextBlock Text="{Binding SafeStatus}" AutomationProperties.LiveSetting="Polite" />
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="access:CredentialCacheDescriptor">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding SafeDisplayName}" />
                        <Button Grid.Column="1" Content="Delete"
                                Command="{Binding $parent[UserControl].((vm:CredentialCacheAdministrationViewModel)DataContext).RemoveCommand}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
