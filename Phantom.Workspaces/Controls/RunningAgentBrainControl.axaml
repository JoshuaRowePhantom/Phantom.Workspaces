<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.ViewModels"
             x:Class="Phantom.Workspaces.Controls.RunningAgentBrainControl"
             x:CompileBindings="False"
             Focusable="False">
    <Border Classes="notifications-panel"
            Width="380"
            MaxHeight="480">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Padding="12,8">
                <TextBlock Text="Running agents"
                           FontWeight="SemiBold" />
            </Border>

            <!-- Empty state message -->
            <TextBlock Grid.Row="1"
                       Text="No agent sessions are currently active."
                       Classes="muted"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="16"
                       IsVisible="{Binding !HasRows}" />

            <!-- Running agents list -->
            <ScrollViewer Grid.Row="1"
                          MaxHeight="420"
                          IsVisible="{Binding HasRows}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RunningAgentRowViewModel">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="6"
                                  Margin="4">
                                <Button Command="{Binding ActivateCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="agent-chat-status-line-brain"
                                                   Classes.thinking="{Binding IsThinking}"
                                                   Classes.idle="{Binding IsThinking, Converter={x:Static BoolConverters.Not}}"
                                                   Text="🧠"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Spacing="1"
                                                    IsVisible="{Binding HasOpenTab}">
                                            <TextBlock Text="{Binding WorkspacePaneTitle}"
                                                       Classes="muted"
                                                       FontSize="11"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TabTitle}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Spacing="1"
                                                    IsVisible="{Binding !HasOpenTab}">
                                            <TextBlock Text="No Open Tab"
                                                       Classes="muted"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding EntityName}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <CheckBox Grid.Column="1"
                                          Content="Continue in background"
                                          AutomationProperties.Name="Continue in background"
                                          ToolTip.Tip="Keep this agent running when the last viewer disconnects."
                                          IsChecked="{Binding ContinueInBackground, Mode=OneWay}"
                                          IsEnabled="{Binding IsBackgroundOptionEnabled}"
                                          Command="{Binding SetContinueInBackgroundCommand}"
                                          CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />
                                <Button Grid.Column="2"
                                        Content="X"
                                        Background="Red"
                                        Foreground="White"
                                        HorizontalAlignment="Right"
                                        Command="{Binding InterruptCommand}"
                                        IsEnabled="{Binding IsInterruptEnabled}"
                                        ToolTip.Tip="Interrupt agent"
                                        AutomationProperties.Name="Interrupt agent" />
                                <Button Grid.Column="3"
                                        Content="Terminate"
                                        HorizontalAlignment="Right"
                                        Command="{Binding TerminateCommand}"
                                        IsEnabled="{Binding IsTerminateEnabled}"
                                        ToolTip.Tip="Terminate agent session"
                                        AutomationProperties.Name="Terminate agent session" />
                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="4"
                                           Text="{Binding LastOperationError}"
                                           Foreground="Red"
                                           Classes="caption"
                                           IsVisible="{Binding LastOperationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
