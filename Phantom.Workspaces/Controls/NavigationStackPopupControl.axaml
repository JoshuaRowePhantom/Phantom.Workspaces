<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.ViewModels"
             xmlns:controls="using:Phantom.Workspaces.Controls"
             x:Class="Phantom.Workspaces.Controls.NavigationStackPopupControl"
             x:CompileBindings="False">
    <controls:TransientPopupControl>
        <Border Classes="notifications-panel"
                MinWidth="200"
                MaxWidth="400"
                MaxHeight="320">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        Padding="12,8">
                    <TextBlock Text="Navigation history"
                               FontWeight="SemiBold" />
                </Border>

                <!-- Empty state -->
                <TextBlock Grid.Row="1"
                           Text="No navigation history."
                           Classes="muted"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="16"
                           IsVisible="{Binding !Rows.Count}" />

                <!-- History list -->
                <ScrollViewer Grid.Row="1"
                              MaxHeight="280"
                              IsVisible="{Binding Rows.Count}">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationStackRowViewModel">
                                <Border Classes="interactive-row"
                                        Classes.highlighted="{Binding IsSelected}"
                                        Padding="12,6"
                                        Margin="4,1">
                                    <controls:WorkspaceTabItemControl />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </controls:TransientPopupControl>
</UserControl>
