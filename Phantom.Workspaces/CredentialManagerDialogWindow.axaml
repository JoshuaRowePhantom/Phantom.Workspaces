<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Phantom.Workspaces.ViewModels"
        xmlns:sharedControls="using:Phantom.Workspaces.Gui.Shared.Controls"
        x:Class="Phantom.Workspaces.CredentialManagerDialogWindow"
        x:DataType="vm:CredentialManagerDialogViewModel"
        Width="760"
        Height="560"
        MinWidth="640"
        MinHeight="420"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Memorized secrets and credentials">
    <DockPanel Margin="20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="Delete Selected Memories"
                    IsEnabled="{Binding HasSelection}"
                    Click="OnDeleteSelectedClicked" />
            <Button Content="Close"
                    Click="OnCloseClicked" />
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <TextBlock Text="Review remembered secret uses and saved credentials. Secret values are never displayed."
                           TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding CredentialGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CredentialGroupViewModel">
                            <Border BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,8">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <sharedControls:SafeSelectableTextBlock Text="{Binding DisplayLabel}"
                                                                                FontWeight="SemiBold" />
                                        <Button Content="…"
                                                IsVisible="{Binding IsSavedCredential}"
                                                Command="{Binding EditCommand}"
                                                ToolTip.Tip="Select or enter a saved credential" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding UsePlaces}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MemorizedUsePlaceViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                                    <CheckBox IsChecked="{Binding IsMarkedForDelete, Mode=TwoWay}" />
                                                    <sharedControls:SafeSelectableTextBlock Text="{Binding DisplayString}" />
                                                    <TextBlock Text="{Binding Scope}" Opacity="0.7" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Unused saved credentials"
                           FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding UnusedSavedCredentials}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UnusedSavedCredentialViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <CheckBox IsChecked="{Binding IsMarkedForDelete, Mode=TwoWay}" />
                                <sharedControls:SafeSelectableTextBlock Text="{Binding CredentialName}" />
                                <Button Content="…"
                                        Command="{Binding EditCommand}"
                                        ToolTip.Tip="Select or enter a saved credential" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
