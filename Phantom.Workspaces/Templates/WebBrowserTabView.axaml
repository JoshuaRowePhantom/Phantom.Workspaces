<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.ViewModels"
             xmlns:entityControls="using:Phantom.Workspaces.Controls"
             x:Class="Phantom.Workspaces.Templates.WebBrowserTabView"
             x:DataType="vm:WebViewModel">
    <Grid RowDefinitions="Auto,*">
        <!-- Navigation toolbar -->
        <Border Grid.Row="0" Classes="workspace-field-row" Padding="8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <!-- Back/Forward/Home buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
                    <Button Command="{Binding NavigateHomeCommand}"
                            Content="🏠"
                            ToolTip.Tip="{Binding HomeUrlTooltip}"
                            IsVisible="{Binding HasHomeUrl}"
                            Width="32" />
                    <Button Command="{Binding GoBackCommand}"
                            Content="←"
                            ToolTip.Tip="Go back"
                            Width="32" />
                    <Button Command="{Binding GoForwardCommand}"
                            Content="→"
                            ToolTip.Tip="Go forward"
                            Width="32" />
                </StackPanel>

                <!-- Address bar -->
                <TextBox Grid.Column="2"
                         x:Name="AddressBar"
                         Text="{Binding AddressBarUrl}"
                         PlaceholderText="Enter URL..."
                         VerticalAlignment="Center">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding NavigateCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <!-- Open in browser button -->
                <Button Grid.Column="3"
                        Command="{Binding OpenInExternalBrowserCommand}"
                        Content="Open in browser"
                        ToolTip.Tip="Open in external browser"
                        Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- Alt+D: focus and select-all the address bar -->
        <Grid.KeyBindings>
            <KeyBinding Gesture="Alt+D" Command="{Binding FocusUrlBarCommand}" />
        </Grid.KeyBindings>

        <!-- WebView control host (factory-created in code-behind) -->
        <Border
            x:Name="WebViewHost"
            Grid.Row="1"
            IsVisible="{Binding !HasError}" />

        <!-- Error state -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasError}"
                Classes="entity-card"
                Padding="16">
            <StackPanel Spacing="8">
                <TextBlock Text="Failed to load browser" Classes="heading" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                <Button Command="{Binding OpenInExternalBrowserCommand}"
                        Content="Open in external browser" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
