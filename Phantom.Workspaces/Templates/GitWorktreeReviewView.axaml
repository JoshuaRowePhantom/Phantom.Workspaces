<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.ViewModels"
             xmlns:converters="using:Phantom.Workspaces.Converters"
             x:Class="Phantom.Workspaces.Templates.GitWorktreeReviewView"
             x:DataType="vm:GitWorktreeReviewWorkspaceTabViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header row: target branch -->
        <Border Grid.Row="0" Classes="workspace-field-row" Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Target branch:" VerticalAlignment="Center" />
                <TextBox Text="{Binding TargetBranch}"
                         Width="200"
                         VerticalAlignment="Center" />
                <TextBlock Text="Refreshing…"
                           IsVisible="{Binding IsRefreshing}"
                           Classes="muted"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Commit list -->
        <ListBox Grid.Row="1"
                 MaxHeight="200"
                 ItemsSource="{Binding CommitList.Commits}"
                 SelectedItems="{Binding CommitList.SelectedCommits}"
                 SelectionMode="Multiple">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:GitCommitModel">
                    <Grid ColumnDefinitions="100,60,24,*,120,24" Margin="4,2">
                        <!-- Date column -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding AuthorDate, Converter={x:Static converters:DateTimeOffsetToStringConverter.Instance}}"
                                   Classes="muted"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        
                        <!-- SHA column -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ShortOid}"
                                   FontFamily="Consolas,Monospace"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />
                        
                        <!-- Copy button -->
                        <Button Grid.Column="2"
                                Content="📋"
                                Click="OnCopyCommitShaClick"
                                Padding="2"
                                ToolTip.Tip="Copy full SHA"
                                VerticalAlignment="Center" />
                        
                        <!-- Message column -->
                        <TextBlock Grid.Column="3"
                                   Text="{Binding ShortMessage}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="8,0,8,0" />
                        
                        <!-- Author column -->
                        <TextBlock Grid.Column="4"
                                   Text="{Binding AuthorName}"
                                   Classes="muted"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,8,0" />
                        
                        <!-- Details button -->
                        <Button Grid.Column="5"
                                Content="..."
                                Padding="2"
                                ToolTip.Tip="Show full commit details"
                                VerticalAlignment="Center">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Width="400" Spacing="8">
                                        <TextBlock Text="Commit Details" FontWeight="Bold" FontSize="14" />
                                        <Border BorderThickness="0,0,0,1" BorderBrush="#33888888" Margin="0,4" />
                                        
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="SHA:" Width="60" />
                                            <TextBlock Text="{Binding Oid}"
                                                       FontFamily="Consolas,Monospace"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Author:" Width="60" />
                                            <TextBlock Text="{Binding AuthorName}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Date:" Width="60" />
                                            <TextBlock Text="{Binding AuthorDate}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Message:" />
                                            <TextBlock Text="{Binding ShortMessage}"
                                                       TextWrapping="Wrap"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Main content: file list + diff pane -->
        <Grid Grid.Row="2" ColumnDefinitions="200,Auto,*">
            <!-- File list -->
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding FileList.Files}"
                     SelectedItems="{Binding FileList.SelectedFiles}"
                     SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GitWorktreeFileEntryViewModel">
                        <StackPanel>
                            <TextBlock Text="{Binding RelativePath}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding RelativePath}" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Foreground="Green">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="+{0}">
                                            <Binding Path="LinesAdded" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Foreground="Red">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="-{0}">
                                            <Binding Path="LinesRemoved" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" ResizeBehavior="PreviousAndNext" />

            <!-- Diff pane -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <!-- Controls strip -->
                <Border Grid.Row="0" Classes="workspace-field-row" Padding="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox Content="Side-by-side" IsChecked="{Binding SideBySide}" />
                        <CheckBox Content="Full file" IsChecked="{Binding FullFile}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Context lines:" VerticalAlignment="Center" />
                            <NumericUpDown Value="{Binding ContextLines}"
                                          Minimum="0"
                                          Maximum="100"
                                          Width="80" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Diff content -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FileDiffs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GitDiffViewModel">
                                <Border Margin="0,4" BorderThickness="1" BorderBrush="#33888888">
                                    <!-- File header -->
                                    <StackPanel>
                                        <Border Background="#22888888" Padding="8,4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding RelativePath}" FontWeight="Bold" FontFamily="Consolas,Monospace" />
                                                <TextBlock Foreground="Green">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="+{0}">
                                                            <Binding Path="LinesAdded" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Foreground="Red">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="-{0}">
                                                            <Binding Path="LinesRemoved" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <!-- Hunks -->
                                        <ItemsControl ItemsSource="{Binding Hunks}" FontFamily="Consolas,Monospace" FontSize="12">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GitDiffHunk">
                                                    <ItemsControl ItemsSource="{Binding Lines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:GitDiffLine">
                                                                <Grid ColumnDefinitions="40,40,*">
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding OldLineNumber}"
                                                                               Foreground="#888888"
                                                                               TextAlignment="Right"
                                                                               Padding="0,0,4,0" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding NewLineNumber}"
                                                                               Foreground="#888888"
                                                                               TextAlignment="Right"
                                                                               Padding="0,0,4,0" />
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding Content}"
                                                                               TextWrapping="NoWrap" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
