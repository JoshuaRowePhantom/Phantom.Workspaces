<DataTemplates xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:Phantom.Workspaces.ViewModels"
               xmlns:converters="using:Phantom.Workspaces.Converters"
               xmlns:templates="using:Phantom.Workspaces.Templates"
               xmlns:agentControls="using:Phantom.Workspaces.Agent.Gui.Controls"
               xmlns:entityControls="using:Phantom.Workspaces.Controls"
               xmlns:controls="using:Phantom.Workspaces.Gui.Shared.Controls"
               x:Class="Phantom.Workspaces.Templates.WorkspaceDataTemplates">
    <DataTemplate DataType="vm:EntityListNodeViewModel">
        <StackPanel Classes="workspace-entity-node-root">
            <entityControls:EntityCardControl DataContext="{Binding Card}" />
            <Border IsVisible="{Binding HasChildren}"
                    Classes="entity-card-expand-section"
                    CornerRadius="{Binding ExpandSectionCornerRadius}">
                <Button Classes="entity-card-expand-button"
                        Content="{Binding ExpandArrow}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding ToggleExpandCommand}" />
            </Border>
            <ItemsControl ItemsSource="{Binding VisibleChildren}" Classes="workspace-visible-children" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:EntityListItemViewModel">
        <StackPanel Margin="{Binding IndentMargin}" Classes="workspace-entity-node-root"
                   controls:StickyItem.Row="{Binding StickyRow}">
            <entityControls:EntityCardControl DataContext="{Binding Node.Card}" />
            <Border IsVisible="{Binding HasChildren}"
                    Classes="entity-card-expand-section"
                    CornerRadius="{Binding ExpandSectionCornerRadius}">
                <Button Classes="entity-card-expand-button"
                        Content="{Binding ExpandArrow}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding ToggleExpandCommand}" />
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:EntityWorkspaceTabViewModel">
        <ContentControl Content="{Binding EntityCardNode}" />
    </DataTemplate>

    <!-- DataTemplate for WebViewModel: embedded web browser with navigation -->
    <DataTemplate DataType="vm:WebViewModel">
        <templates:WebBrowserTabView />
    </DataTemplate>

    <DataTemplate DataType="vm:StartAgentSessionOnProfileViewModel">
        <templates:StartAgentSessionOnProfileView />
    </DataTemplate>

    <DataTemplate DataType="vm:AgentManifestLaunchpadViewModel">
        <templates:AgentManifestLaunchpadView />
    </DataTemplate>

    <DataTemplate DataType="vm:AgentManifestEditorViewModel">
        <templates:AgentManifestEditorView />
    </DataTemplate>

    <DataTemplate DataType="vm:CloneEntityWorkspaceTabViewModel">
        <templates:CloneEntityEditorView DataContext="{Binding Editor}" />
    </DataTemplate>

    <DataTemplate DataType="vm:AgentSessionWorkspaceTabViewModel">
        <Panel>
            <!-- Loading state -->
            <StackPanel IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AgentTabState.Loading}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <TextBlock Text="Loading agent session…"
                           Classes="muted"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Ready state: wrap in Panel so IsVisible binds to AgentSessionWorkspaceTabViewModel,
                 not to the AgentViewModel set as DataContext on the inner control -->
            <Panel IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AgentTabState.Ready}}">
                <agentControls:AgentChatEditorControl DataContext="{Binding Agent}" />
            </Panel>

            <!-- Failed state -->
            <StackPanel IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AgentTabState.Failed}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        MaxWidth="400">
                <TextBlock Text="Failed to load agent session"
                           Classes="heading"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding LoadError}"
                           Classes="muted"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Panel>
    </DataTemplate>

    <DataTemplate DataType="vm:ShellTabViewModel">
        <controls:TerminalControl Session="{Binding TerminalSession}" />
    </DataTemplate>

    <DataTemplate x:DataType="vm:EntityDisplayItemViewModel">
        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
    </DataTemplate>

    <DataTemplate DataType="vm:EntityReferenceFieldEditorViewModel">
        <Grid Classes="workspace-field-row"
              ColumnDefinitions="200,*"
              RowDefinitions="Auto,Auto">
            <TextBlock Text="{Binding FieldName}" Classes="muted workspace-field-label" />
            <!-- Read mode: navigable link to the referenced entity (resolved display name). -->
            <Button Grid.Column="1" Grid.Row="0"
                    Content="{Binding ResolvedDisplayName}"
                    ToolTip.Tip="{Binding TooltipText}"
                    Command="{Binding OpenCommand}"
                    IsEnabled="{Binding CanOpen}"
                    Classes="workspace-entity-reference-link"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding IsReadMode}" />
            <!-- Edit mode: search box plus candidate results. -->
            <TextBox Grid.Column="1" Grid.Row="0"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     Watermark="{Binding ResolvedDisplayName}"
                     IsVisible="{Binding IsEditMode}"
                     Classes="workspace-field-value" />
            <ItemsControl Grid.Column="1" Grid.Row="1"
                          ItemsSource="{Binding Results}"
                          IsVisible="{Binding IsEditMode}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding SelectCommand}"
                                ToolTip.Tip="{Binding Names}"
                                Content="{Binding DisplayName}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Classes="workspace-entity-reference-candidate" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:EntityListFieldEditorViewModel">
        <Grid Classes="workspace-field-row"
              ColumnDefinitions="200,*"
              RowDefinitions="Auto">
            <TextBlock Text="{Binding FieldName}" Classes="muted workspace-field-label" />
            <ItemsControl Grid.Column="1"
                          ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding DisplayName}"
                                ToolTip.Tip="{Binding TooltipText}"
                                Command="{Binding OpenCommand}"
                                IsEnabled="{Binding CanOpen}"
                                Classes="workspace-entity-reference-link"
                                HorizontalAlignment="Left" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:StringFieldEditorViewModel">
        <Grid Classes="workspace-field-row"
              ColumnDefinitions="200,*"
              RowDefinitions="Auto">
            <TextBlock Text="{Binding FieldName}" Classes="muted workspace-field-label" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Value}"
                       Classes="workspace-field-read-value"
                       IsVisible="{Binding IsReadMode}" />
            <TextBox Grid.Column="1"
                     Text="{Binding Value, Mode=TwoWay}"
                     IsVisible="{Binding IsEditMode}"
                     Classes="workspace-field-value" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:BooleanToggleFieldEditorViewModel">
        <Grid Classes="workspace-field-row"
              ColumnDefinitions="200,*"
              RowDefinitions="Auto">
            <TextBlock Text="{Binding FieldName}" Classes="muted workspace-field-label" />
            <TextBlock Grid.Column="1"
                       Text="{Binding DisplayValue}"
                       Classes="workspace-field-read-value"
                       IsVisible="{Binding IsReadMode}" />
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding Value, Mode=TwoWay}"
                          OnContent="true"
                          OffContent="false"
                          IsVisible="{Binding IsEditMode}"
                          Classes="workspace-field-value" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:LocalStringFieldEditorViewModel">
        <Grid Classes="workspace-field-row"
              ColumnDefinitions="200,*,Auto"
              RowDefinitions="Auto,Auto">
            <TextBlock Text="{Binding FieldName}" Classes="muted workspace-field-label" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Value}"
                       Classes="workspace-field-read-value"
                       IsVisible="{Binding IsReadMode}" />
            <TextBox Grid.Column="1"
                     Text="{Binding Value, Mode=TwoWay}"
                     IsVisible="{Binding IsEditMode}"
                     Classes="workspace-field-value" />
            <Button Grid.Column="2"
                    Content="+"
                    Classes="workspace-edit-action-button"
                    IsVisible="{Binding ShowAddLocaleButton}"
                    Command="{Binding AddLocaleCommand}" />
            <Expander Grid.Row="1"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Header="Other locales"
                      IsVisible="{Binding ShowOtherLocalesExpander}"
                      Classes="workspace-field-expander">
                <ItemsControl ItemsSource="{Binding OtherLocalizedValues}" Classes="workspace-field-items">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:LocalizedTextValueViewModel">
                            <Grid Classes="workspace-field-row" ColumnDefinitions="120,*">
                                <TextBox Text="{Binding Locale, Mode=TwoWay}" Classes="workspace-field-value" />
                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Classes="workspace-field-value" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:JsonSchemaFieldEditorViewModel">
        <Grid Classes="workspace-field-row"
              ColumnDefinitions="200,*"
              RowDefinitions="Auto">
            <TextBlock Text="{Binding FieldName}" Classes="muted workspace-field-label" />
            <SelectableTextBlock Grid.Column="1"
                         Text="{Binding MarkdownText}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding IsReadMode}"
                         Classes="workspace-markdown-viewer workspace-json-schema-viewer" />
            <TextBox Grid.Column="1"
                     Text="{Binding JsonText, Mode=TwoWay}"
                     IsVisible="{Binding IsEditMode}"
                     Classes="workspace-field-value workspace-markdown-content workspace-json-schema-editor" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:PlainMimeAttachmentFieldEditorViewModel">
        <Expander Header="{Binding FieldName}" Classes="workspace-field-expander">
            <StackPanel Classes="workspace-mime-content">
                <Grid Classes="workspace-field-row"
                      ColumnDefinitions="200,*">
                    <TextBlock Text="mime-type" Classes="muted workspace-field-label" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding MimeType}"
                               Classes="workspace-field-read-value"
                               IsVisible="{Binding IsReadMode}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding MimeType, Mode=TwoWay}"
                             IsVisible="{Binding IsEditMode}"
                             Classes="workspace-field-value" />
                </Grid>
                <Grid Classes="workspace-field-row"
                      ColumnDefinitions="200,*">
                    <TextBlock Text="url" Classes="muted workspace-field-label" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Url}"
                               Classes="workspace-field-read-value"
                               IsVisible="{Binding IsReadMode}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding Url, Mode=TwoWay}"
                             IsVisible="{Binding IsEditMode}"
                             Classes="workspace-field-value" />
                </Grid>
                <Grid Classes="workspace-field-row"
                      ColumnDefinitions="200,*"
                      IsVisible="{Binding ShowPlainTextReadMode}">
                    <TextBlock Text="content.text" Classes="muted workspace-field-label" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding TextContent}"
                               Classes="workspace-field-read-value workspace-markdown-content" />
                </Grid>
                <Grid Classes="workspace-field-row"
                      ColumnDefinitions="200,*"
                      IsVisible="{Binding ShowPlainTextEditMode}">
                    <TextBlock Text="content.text" Classes="muted workspace-field-label" />
                    <TextBox Grid.Column="1"
                             Text="{Binding TextContent, Mode=TwoWay}"
                             Classes="workspace-field-value workspace-markdown-content" />
                </Grid>
            </StackPanel>
        </Expander>
    </DataTemplate>

    <DataTemplate DataType="vm:MarkdownMimeAttachmentFieldEditorViewModel">
        <Panel>
            <SelectableTextBlock Text="{Binding TextContent}"
                         TextWrapping="Wrap"
                         Classes="workspace-markdown-viewer"
                         IsVisible="{Binding ShowInlineMarkdownReadMode}" />
            <Expander Header="{Binding FieldName}"
                      Classes="workspace-field-expander"
                      IsVisible="{Binding ShowChrome}">
                <StackPanel Classes="workspace-mime-content">
                    <Grid Classes="workspace-field-row"
                          ColumnDefinitions="200,*">
                        <TextBlock Text="mime-type" Classes="muted workspace-field-label" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MimeType}"
                                   Classes="workspace-field-read-value"
                                   IsVisible="{Binding IsReadMode}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding MimeType, Mode=TwoWay}"
                                 IsVisible="{Binding IsEditMode}"
                                 Classes="workspace-field-value" />
                    </Grid>
                    <Grid Classes="workspace-field-row"
                          ColumnDefinitions="200,*">
                        <TextBlock Text="url" Classes="muted workspace-field-label" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Url}"
                                   Classes="workspace-field-read-value"
                                   IsVisible="{Binding IsReadMode}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding Url, Mode=TwoWay}"
                                 IsVisible="{Binding IsEditMode}"
                                 Classes="workspace-field-value" />
                    </Grid>
                    <Grid Classes="workspace-field-row"
                          ColumnDefinitions="200,*"
                          IsVisible="{Binding ShowMarkdownReadMode}">
                        <TextBlock Text="content.text" Classes="muted workspace-field-label" />
                        <SelectableTextBlock Grid.Column="1"
                                     Text="{Binding TextContent}"
                                     TextWrapping="Wrap"
                                     Classes="workspace-markdown-viewer" />
                    </Grid>
                    <Grid Classes="workspace-field-row"
                          ColumnDefinitions="200,*"
                          IsVisible="{Binding ShowMarkdownEditMode}">
                        <TextBlock Text="content.text" Classes="muted workspace-field-label" />
                        <SelectableTextBlock Grid.Column="1"
                                     Text="{Binding TextContent, Mode=TwoWay}"
                                     TextWrapping="Wrap"
                                     Classes="workspace-markdown-editor" />
                    </Grid>
                </StackPanel>
            </Expander>
        </Panel>
    </DataTemplate>

    <DataTemplate DataType="vm:LocalizedMimeAttachmentFieldEditorViewModel">
        <Panel>
            <ContentControl Content="{Binding ActiveEditor}"
                            IsVisible="{Binding ShowInlineReadMode}" />
            <Grid Classes="workspace-field-row"
                  ColumnDefinitions="200,*,Auto"
                  RowDefinitions="Auto,Auto"
                  IsVisible="{Binding ShowChrome}">
                <TextBlock Text="{Binding FieldName}" Classes="muted workspace-field-label" />
                <ContentControl Grid.Column="1" Content="{Binding ActiveEditor}" />
                <Button Grid.Column="2"
                        Content="+"
                        Classes="workspace-edit-action-button"
                        IsVisible="{Binding ShowAddLocaleButton}"
                        Command="{Binding AddLocaleCommand}" />
                <Expander Grid.Row="1"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Header="Other locales"
                          IsVisible="{Binding ShowOtherLocalesExpander}"
                          Classes="workspace-field-expander">
                    <ItemsControl ItemsSource="{Binding OtherLocalizedValues}" Classes="workspace-field-items">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:LocalizedMimeAttachmentValueViewModel">
                                <StackPanel>
                                    <TextBox Text="{Binding Locale, Mode=TwoWay}" Classes="workspace-field-value" />
                                    <ContentControl Content="{Binding Editor}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </Grid>
        </Panel>
    </DataTemplate>

    <DataTemplate DataType="vm:ArrayFieldEditorViewModel">
        <Expander Header="{Binding FieldName}" Classes="workspace-field-expander">
            <ItemsControl ItemsSource="{Binding Items}" Classes="workspace-field-items" />
        </Expander>
    </DataTemplate>

    <DataTemplate DataType="vm:ObjectFieldEditorViewModel">
        <Expander Header="{Binding FieldName}" Classes="workspace-field-expander">
            <ItemsControl ItemsSource="{Binding Fields}" Classes="workspace-field-items" />
        </Expander>
    </DataTemplate>

    <DataTemplate DataType="vm:EntityBrowserWorkspaceTabViewModel">
        <templates:EntityBrowserWorkspaceTabView />
    </DataTemplate>


    <DataTemplate DataType="vm:WorkspacePaneViewModel">
        <Grid RowDefinitions="Auto,*">
            <Border Classes="pane-header">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Classes="heading" />
                    <TextBlock Text="{Binding Entity.EntityType}" Classes="muted" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Border Classes="entity-card"
                        IsVisible="{Binding HasNoRegions}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Empty workspace" Classes="heading" />
                        <TextBlock Text="See the guidance note for how to add regions and tabs to this workspace."
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Documentation entity: documentation/empty-workspace"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding SelectedRegion}"
                                IsVisible="{Binding HasRegions}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:WorkspaceRegionViewModel">
                            <Border Classes="workspace-region-card">
                                <Grid RowDefinitions="Auto,*">
                                    <StackPanel Classes="workspace-region-header-row">
                                        <TextBlock Text="{Binding Title}" Classes="section-title" />
                                        <TextBlock Text="{Binding DockRegion}" Classes="muted" />
                                        <TextBlock Text="{Binding RelativeSize, StringFormat='x{0}'}" Classes="muted" />
                                    </StackPanel>
                                    <TabControl Grid.Row="1"
                                                MinHeight="0"
                                                Classes="workspace-tabs"
                                                ItemsSource="{Binding Tabs}"
                                                SelectedItem="{Binding SelectedTab}">
                                        <TabControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WorkspaceTabViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Title}" />
                                                    <Button Content="✕"
                                                            Classes="workspace-tab-close-button"
                                                            Command="{Binding $parent[TabControl].DataContext.CloseTabCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </TabControl.ItemTemplate>
                                    </TabControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Grid>
    </DataTemplate>
    <!-- Tab header item templates (top-level so they are individually testable and visible to the full
         template-resolution chain inside ItemsControl after Dock pane moves) -->
    <DataTemplate DataType="vm:FaviconTabHeaderItemViewModel">
        <!-- Show the globe glyph; favicon image loading is a future enhancement -->
        <TextBlock Text="🌐" />
    </DataTemplate>

    <DataTemplate DataType="vm:IconTabHeaderItemViewModel">
        <TextBlock Text="{Binding Icon}" />
    </DataTemplate>

    <DataTemplate DataType="vm:AgentRunningIndicatorTabHeaderItemViewModel">
        <ProgressBar Classes="glyph-indicator pulsating-brain"
                     IsIndeterminate="{Binding IsRunning}" />
    </DataTemplate>

    <DataTemplate DataType="vm:NotificationIndicatorTabHeaderItemViewModel">
        <!-- Always occupies space; empty bar hides it when there is no unread notification -->
        <ProgressBar Classes="notification-indicator"
                     Value="{Binding HasUnread, Converter={x:Static converters:BoolTo100Converter.Instance}}" />
    </DataTemplate>

    <DataTemplate DataType="vm:StatusTabHeaderItemViewModel">
        <entityControls:StatusControl Item="{Binding Status}" />
    </DataTemplate>

    <DataTemplate DataType="vm:TabHeaderViewModel">
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Title}" />
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <!-- Alt+N shortcut badge: visible only for tabs 1–10; fades in when Alt is held -->
            <Border Classes="alt-index-badge"
                    Classes.alt-held="{Binding IsAltHeld}"
                    IsVisible="{Binding AltShortcutLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    ZIndex="10">
                <TextBlock Text="{Binding AltShortcutLabel}"
                           Classes="caption"
                           HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:GitWorktreeReviewWorkspaceTabViewModel">
        <templates:GitWorktreeReviewView />
    </DataTemplate>

    <DataTemplate DataType="vm:ExternalEntityCardViewModel">
        <ItemsControl ItemsSource="{Binding Urls}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ExternalUrlViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Key}"
                                   IsVisible="{Binding ShowKey}"
                                   Classes="muted workspace-field-label" />
                        <Button Content="{Binding Url}"
                                Classes="workspace-url-link"
                                Command="{Binding OpenCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>
</DataTemplates>
