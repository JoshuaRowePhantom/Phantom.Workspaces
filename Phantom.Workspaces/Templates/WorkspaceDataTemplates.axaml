<DataTemplates xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:Phantom.Workspaces.ViewModels"
               xmlns:templates="using:Phantom.Workspaces.Templates"
               xmlns:md="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.Markdown"
               xmlns:controls="using:Phantom.Workspaces.Gui.Styles.Controls"
               x:Class="Phantom.Workspaces.Templates.WorkspaceDataTemplates">
    <DataTemplate DataType="vm:EntityListNodeViewModel">
        <StackPanel Classes="workspace-entity-node-root">
            <Border Classes="entity-card"
                    CornerRadius="{Binding ContentCornerRadius}">
                <StackPanel Classes="workspace-entity-card-content">
                    <StackPanel Classes="workspace-entity-header-row">
                        <TextBlock Text="{Binding DisplayName}" Classes="workspace-entity-title" />
                        <TextBlock Text="{Binding EntityType}" Classes="muted" />
                        <Button Content="{Binding EditModeGlyph}"
                                Classes="workspace-edit-indicator-button"
                                IsVisible="{Binding ShowEditIndicator}"
                                Command="{Binding ToggleEditModeCommand}" />
                        <Button Content="💾"
                                Classes="workspace-edit-action-button"
                                IsVisible="{Binding ShowEditActions}"
                                Command="{Binding SaveEditModeCommand}" />
                        <Button Content="✖"
                                Classes="workspace-edit-action-button"
                                IsVisible="{Binding ShowEditActions}"
                                Command="{Binding DiscardEditModeCommand}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding FieldEditors}"
                                  Classes="workspace-field-editor-list" />
                </StackPanel>
            </Border>
            <Border IsVisible="{Binding HasChildren}"
                    Classes="entity-card-expand-section"
                    CornerRadius="{Binding ExpandSectionCornerRadius}">
                <Button Classes="entity-card-expand-button"
                        Content="{Binding ExpandArrow}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding ToggleExpandCommand}" />
            </Border>
            <ItemsControl ItemsSource="{Binding VisibleChildren}" Classes="workspace-visible-children" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:EntityListItemViewModel">
        <StackPanel Margin="{Binding IndentMargin}" Classes="workspace-entity-node-root"
                    controls:StickyItem.Row="{Binding StickyRow}">
            <Border Classes="entity-card"
                    CornerRadius="{Binding ContentCornerRadius}">
                <StackPanel Classes="workspace-entity-card-content">
                    <StackPanel Classes="workspace-entity-header-row">
                        <TextBlock Text="{Binding DisplayName}" Classes="workspace-entity-title" />
                        <TextBlock Text="{Binding EntityType}" Classes="muted" />
                        <Button Content="{Binding EditModeGlyph}"
                                Classes="workspace-edit-indicator-button"
                                IsVisible="{Binding ShowEditIndicator}"
                                Command="{Binding ToggleEditModeCommand}" />
                        <Button Content="💾"
                                Classes="workspace-edit-action-button"
                                IsVisible="{Binding ShowEditActions}"
                                Command="{Binding SaveEditModeCommand}" />
                        <Button Content="✖"
                                Classes="workspace-edit-action-button"
                                IsVisible="{Binding ShowEditActions}"
                                Command="{Binding DiscardEditModeCommand}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding FieldEditors}"
                                  Classes="workspace-field-editor-list" />
                </StackPanel>
            </Border>
            <Border IsVisible="{Binding HasChildren}"
                    Classes="entity-card-expand-section"
                    CornerRadius="{Binding ExpandSectionCornerRadius}">
                <Button Classes="entity-card-expand-button"
                        Content="{Binding ExpandArrow}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding ToggleExpandCommand}" />
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:EntityWorkspaceTabViewModel">
        <Border Classes="entity-card">
            <StackPanel Classes="workspace-template-browser-root">
                <TextBlock Text="{Binding Entity.DisplayName}" Classes="heading" />
                <TextBlock Text="{Binding Entity.EntityType}" Classes="muted" />
                <ItemsControl ItemsSource="{Binding Entity.DisplayItems}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:DataType="vm:EntityDisplayItemViewModel">
        <md:Markdown Text="{Binding Text}" />
    </DataTemplate>

    <DataTemplate DataType="vm:StringFieldEditorViewModel">
        <Grid Classes="workspace-field-row"
              ColumnDefinitions="200,*"
              RowDefinitions="Auto">
            <TextBlock Text="{Binding FieldName}" Classes="muted workspace-field-label" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Value}"
                       Classes="workspace-field-read-value"
                       IsVisible="{Binding IsReadMode}" />
            <TextBox Grid.Column="1"
                     Text="{Binding Value, Mode=TwoWay}"
                     IsVisible="{Binding IsEditMode}"
                     Classes="workspace-field-value" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:LocalStringFieldEditorViewModel">
        <Grid Classes="workspace-field-row"
              ColumnDefinitions="200,*,Auto"
              RowDefinitions="Auto,Auto">
            <TextBlock Text="{Binding FieldName}" Classes="muted workspace-field-label" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Value}"
                       Classes="workspace-field-read-value"
                       IsVisible="{Binding IsReadMode}" />
            <TextBox Grid.Column="1"
                     Text="{Binding Value, Mode=TwoWay}"
                     IsVisible="{Binding IsEditMode}"
                     Classes="workspace-field-value" />
            <Button Grid.Column="2"
                    Content="+"
                    Classes="workspace-edit-action-button"
                    IsVisible="{Binding ShowAddLocaleButton}"
                    Command="{Binding AddLocaleCommand}" />
            <Expander Grid.Row="1"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Header="Other locales"
                      IsVisible="{Binding ShowOtherLocalesExpander}"
                      Classes="workspace-field-expander">
                <ItemsControl ItemsSource="{Binding OtherLocalizedValues}" Classes="workspace-field-items">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:LocalizedTextValueViewModel">
                            <Grid Classes="workspace-field-row" ColumnDefinitions="120,*">
                                <TextBox Text="{Binding Locale, Mode=TwoWay}" Classes="workspace-field-value" />
                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Classes="workspace-field-value" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:JsonSchemaFieldEditorViewModel">
        <Grid Classes="workspace-field-row"
              ColumnDefinitions="200,*"
              RowDefinitions="Auto">
            <TextBlock Text="{Binding FieldName}" Classes="muted workspace-field-label" />
            <md:Markdown Grid.Column="1"
                         Text="{Binding MarkdownText}"
                         IsVisible="{Binding IsReadMode}"
                         Classes="workspace-markdown-viewer workspace-json-schema-viewer" />
            <TextBox Grid.Column="1"
                     Text="{Binding JsonText, Mode=TwoWay}"
                     IsVisible="{Binding IsEditMode}"
                     Classes="workspace-field-value workspace-markdown-content workspace-json-schema-editor" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:PlainMimeAttachmentFieldEditorViewModel">
        <Expander Header="{Binding FieldName}" Classes="workspace-field-expander">
            <StackPanel Classes="workspace-mime-content">
                <Grid Classes="workspace-field-row"
                      ColumnDefinitions="200,*">
                    <TextBlock Text="mime-type" Classes="muted workspace-field-label" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding MimeType}"
                               Classes="workspace-field-read-value"
                               IsVisible="{Binding IsReadMode}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding MimeType, Mode=TwoWay}"
                             IsVisible="{Binding IsEditMode}"
                             Classes="workspace-field-value" />
                </Grid>
                <Grid Classes="workspace-field-row"
                      ColumnDefinitions="200,*">
                    <TextBlock Text="url" Classes="muted workspace-field-label" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Url}"
                               Classes="workspace-field-read-value"
                               IsVisible="{Binding IsReadMode}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding Url, Mode=TwoWay}"
                             IsVisible="{Binding IsEditMode}"
                             Classes="workspace-field-value" />
                </Grid>
                <Grid Classes="workspace-field-row"
                      ColumnDefinitions="200,*"
                      IsVisible="{Binding ShowPlainTextReadMode}">
                    <TextBlock Text="content.text" Classes="muted workspace-field-label" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding TextContent}"
                               Classes="workspace-field-read-value workspace-markdown-content" />
                </Grid>
                <Grid Classes="workspace-field-row"
                      ColumnDefinitions="200,*"
                      IsVisible="{Binding ShowPlainTextEditMode}">
                    <TextBlock Text="content.text" Classes="muted workspace-field-label" />
                    <TextBox Grid.Column="1"
                             Text="{Binding TextContent, Mode=TwoWay}"
                             Classes="workspace-field-value workspace-markdown-content" />
                </Grid>
            </StackPanel>
        </Expander>
    </DataTemplate>

    <DataTemplate DataType="vm:MarkdownMimeAttachmentFieldEditorViewModel">
        <Expander Header="{Binding FieldName}" Classes="workspace-field-expander">
            <StackPanel Classes="workspace-mime-content">
                <Grid Classes="workspace-field-row"
                      ColumnDefinitions="200,*">
                    <TextBlock Text="mime-type" Classes="muted workspace-field-label" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding MimeType}"
                               Classes="workspace-field-read-value"
                               IsVisible="{Binding IsReadMode}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding MimeType, Mode=TwoWay}"
                             IsVisible="{Binding IsEditMode}"
                             Classes="workspace-field-value" />
                </Grid>
                <Grid Classes="workspace-field-row"
                      ColumnDefinitions="200,*">
                    <TextBlock Text="url" Classes="muted workspace-field-label" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Url}"
                               Classes="workspace-field-read-value"
                               IsVisible="{Binding IsReadMode}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding Url, Mode=TwoWay}"
                             IsVisible="{Binding IsEditMode}"
                             Classes="workspace-field-value" />
                </Grid>
                <Grid Classes="workspace-field-row"
                      ColumnDefinitions="200,*"
                      IsVisible="{Binding ShowMarkdownReadMode}">
                    <TextBlock Text="content.text" Classes="muted workspace-field-label" />
                    <md:Markdown Grid.Column="1"
                                 Text="{Binding TextContent}"
                                 Classes="workspace-markdown-viewer" />
                </Grid>
                <Grid Classes="workspace-field-row"
                      ColumnDefinitions="200,*"
                      IsVisible="{Binding ShowMarkdownEditMode}">
                    <TextBlock Text="content.text" Classes="muted workspace-field-label" />
                    <md:Markdown Grid.Column="1"
                                 Text="{Binding TextContent, Mode=TwoWay}"
                                 Classes="workspace-markdown-editor" />
                </Grid>
            </StackPanel>
        </Expander>
    </DataTemplate>

    <DataTemplate DataType="vm:LocalizedMimeAttachmentFieldEditorViewModel">
        <Grid Classes="workspace-field-row"
              ColumnDefinitions="200,*,Auto"
              RowDefinitions="Auto,Auto">
            <TextBlock Text="{Binding FieldName}" Classes="muted workspace-field-label" />
            <ContentControl Grid.Column="1" Content="{Binding ActiveEditor}" />
            <Button Grid.Column="2"
                    Content="+"
                    Classes="workspace-edit-action-button"
                    IsVisible="{Binding ShowAddLocaleButton}"
                    Command="{Binding AddLocaleCommand}" />
            <Expander Grid.Row="1"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Header="Other locales"
                      IsVisible="{Binding ShowOtherLocalesExpander}"
                      Classes="workspace-field-expander">
                <ItemsControl ItemsSource="{Binding OtherLocalizedValues}" Classes="workspace-field-items">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:LocalizedMimeAttachmentValueViewModel">
                            <StackPanel>
                                <TextBox Text="{Binding Locale, Mode=TwoWay}" Classes="workspace-field-value" />
                                <ContentControl Content="{Binding Editor}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:ArrayFieldEditorViewModel">
        <Expander Header="{Binding FieldName}" Classes="workspace-field-expander">
            <ItemsControl ItemsSource="{Binding Items}" Classes="workspace-field-items" />
        </Expander>
    </DataTemplate>

    <DataTemplate DataType="vm:ObjectFieldEditorViewModel">
        <Expander Header="{Binding FieldName}" Classes="workspace-field-expander">
            <ItemsControl ItemsSource="{Binding Fields}" Classes="workspace-field-items" />
        </Expander>
    </DataTemplate>

    <DataTemplate DataType="vm:EntityBrowserWorkspaceTabViewModel">
        <templates:EntityBrowserWorkspaceTabView />
    </DataTemplate>

    <DataTemplate DataType="vm:BrowserWorkspaceTabViewModel">
        <StackPanel Classes="workspace-template-browser-root">
            <TextBlock Text="Browser" Classes="heading" />
            <TextBlock Text="{Binding Url}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:WorkspacePaneViewModel">
        <Grid RowDefinitions="Auto,*">
            <Border Classes="pane-header">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Classes="heading" />
                    <TextBlock Text="{Binding Entity.EntityType}" Classes="muted" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Border Classes="entity-card"
                        IsVisible="{Binding HasNoRegions}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Empty workspace" Classes="heading" />
                        <TextBlock Text="See the guidance note for how to add regions and tabs to this workspace."
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Documentation entity: documentation/empty-workspace"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding SelectedRegion}"
                                IsVisible="{Binding HasRegions}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:WorkspaceRegionViewModel">
                            <Border Classes="workspace-region-card">
                                <Grid RowDefinitions="Auto,*">
                                    <StackPanel Classes="workspace-region-header-row">
                                        <TextBlock Text="{Binding Title}" Classes="section-title" />
                                        <TextBlock Text="{Binding DockRegion}" Classes="muted" />
                                        <TextBlock Text="{Binding RelativeSize, StringFormat='x{0}'}" Classes="muted" />
                                    </StackPanel>
                                    <TabControl Grid.Row="1"
                                                MinHeight="0"
                                                Classes="workspace-tabs"
                                                ItemsSource="{Binding Tabs}"
                                                SelectedItem="{Binding SelectedTab}">
                                        <TabControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WorkspaceTabViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Title}" />
                                                    <Button Content="✕"
                                                            Classes="workspace-tab-close-button"
                                                            Command="{Binding $parent[TabControl].DataContext.CloseTabCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </TabControl.ItemTemplate>
                                    </TabControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Grid>
    </DataTemplate>
</DataTemplates>
