<DataTemplates xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:Phantom.Workspaces.ViewModels"
               x:Class="Phantom.Workspaces.Templates.WorkspaceDataTemplates">
    <DataTemplate DataType="vm:EntityListNodeViewModel">
        <StackPanel Spacing="4">
            <Border Classes="entity-card"
                    CornerRadius="{Binding ContentCornerRadius}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EntityType}" Classes="muted" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding DisplayItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding .}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border IsVisible="{Binding HasChildren}"
                    Classes="entity-card-expand-section"
                    CornerRadius="{Binding ExpandSectionCornerRadius}">
                <Button Classes="entity-card-expand-button"
                        Content="{Binding ExpandArrow}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding ToggleExpandCommand}" />
            </Border>
            <ItemsControl ItemsSource="{Binding VisibleChildren}" Margin="22,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:EntityListItemViewModel">
        <StackPanel Margin="{Binding IndentMargin}" Spacing="4">
            <Border Classes="entity-card"
                    CornerRadius="{Binding ContentCornerRadius}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EntityType}" Classes="muted" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding DisplayItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding .}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border IsVisible="{Binding HasChildren}"
                    Classes="entity-card-expand-section"
                    CornerRadius="{Binding ExpandSectionCornerRadius}">
                <Button Classes="entity-card-expand-button"
                        Content="{Binding ExpandArrow}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding ToggleExpandCommand}" />
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:EntityWorkspaceTabViewModel">
        <Border Classes="entity-card">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding Entity.DisplayName}" Classes="heading" />
                <TextBlock Text="{Binding Entity.EntityType}" Classes="muted" />
                <ItemsControl ItemsSource="{Binding Entity.DisplayItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding .}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="vm:EntityBrowserWorkspaceTabViewModel">
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding EntityList.Items}" />
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="vm:BrowserWorkspaceTabViewModel">
        <StackPanel Spacing="6">
            <TextBlock Text="Browser" Classes="heading" />
            <TextBlock Text="{Binding Url}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:WorkspacePaneViewModel">
        <Grid RowDefinitions="Auto,*">
            <Border Classes="pane-header">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Classes="heading" />
                    <TextBlock Text="{Binding Entity.EntityType}" Classes="muted" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Regions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkspaceRegionViewModel">
                            <Border Classes="workspace-region-card">
                                <Grid RowDefinitions="Auto,*">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Title}" Classes="section-title" />
                                        <TextBlock Text="{Binding DockRegion}" Classes="muted" />
                                        <TextBlock Text="{Binding RelativeSize, StringFormat='x{0}'}" Classes="muted" />
                                    </StackPanel>
                                    <TabControl Grid.Row="1"
                                                ItemsSource="{Binding Tabs}"
                                                SelectedItem="{Binding SelectedTab}">
                                        <TabControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WorkspaceTabViewModel">
                                                <TextBlock Text="{Binding Title}" />
                                            </DataTemplate>
                                        </TabControl.ItemTemplate>
                                    </TabControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DataTemplate>
</DataTemplates>
