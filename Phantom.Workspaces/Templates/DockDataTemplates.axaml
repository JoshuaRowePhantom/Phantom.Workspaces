<DataTemplates xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:Phantom.Workspaces.ViewModels"
               xmlns:dock="using:Dock.Avalonia.Controls"
               xmlns:dmc="using:Dock.Model.Controls"
               xmlns:ts="using:Phantom.Dock.Avalonia.TabSwitching"
               x:Class="Phantom.Workspaces.Templates.DockDataTemplates">
    <!-- Supply root dock template (normally auto-created). -->
    <DataTemplate DataType="dmc:IRootDock">
        <dock:RootDockControl />
    </DataTemplate>

    <!-- Supply proportional (split) dock template (normally auto-created).
         Required because AutoCreateDataTemplates="False" on the hosting
         DockControls; without it a "New Horizontal/Vertical Dock"
         ProportionalDock renders as its raw type name
         (Dock.Model.Mvvm.Controls.ProportionalDock). See #1130. -->
    <DataTemplate DataType="dmc:IProportionalDock">
        <dock:ProportionalDockControl />
    </DataTemplate>

    <!-- Supply proportional-dock splitter template (normally auto-created).
         Required because AutoCreateDataTemplates="False"; without it a
         ProportionalDockSplitter (produced by "New Horizontal/Vertical Dock"
         or any SplitToDock) renders as its raw type name
         (Dock.Model.Mvvm.Controls.ProportionalDockSplitter). Mirrors the
         default DockDataTemplateHelper mapping, including the CanResize /
         ResizePreview bindings on ProportionalStackPanelSplitter. See #1130. -->
    <DataTemplate DataType="dmc:IProportionalDockSplitter">
        <ProportionalStackPanelSplitter
            IsResizingEnabled="{Binding CanResize}"
            PreviewResize="{Binding ResizePreview}" />
    </DataTemplate>

    <!-- Supply base DocumentDock template (normally auto-created).
         Required because the app's typed subclasses (WorkspaceContentDock /
         WorkspacesPaneDock) do not cover the plain Dock.Model.Mvvm.Controls.DocumentDock
         that WorkspaceDockFactory (inherits from Dock.Model.Mvvm.Factory) creates
         via CreateDocumentDock() during a runtime split. Without it the newly
         created dock half renders as its raw type name
         (Dock.Model.Mvvm.Controls.DocumentDock). See #1130. -->
    <DataTemplate DataType="dmc:IDocumentDock">
        <dock:DocumentDockControl />
    </DataTemplate>

    <!-- WorkspaceContentDock is our typed subclass of DocumentDock.
         Using a concrete subtype means Dock's FuncDataTemplate<IDocumentDock>
         (on PART_ContentControl) is bypassed, so AutoCreateDataTemplates=False
         lets our DataTemplate on DockControl be found first. Setting
         HeaderTemplate here is a local value (priority 1), which beats the
         ControlTheme setter (priority 3). -->
    <DataTemplate DataType="vm:WorkspaceContentDock">
        <dock:DocumentControl>
            <dock:DocumentControl.HeaderTemplate>
                <DataTemplate x:DataType="vm:WorkspaceDocument">
                    <ContentControl Content="{Binding EffectiveTabHeader}" />
                </DataTemplate>
            </dock:DocumentControl.HeaderTemplate>
        </dock:DocumentControl>
    </DataTemplate>

    <!-- Content-level tab: shows the tab's ViewModel -->
    <DataTemplate DataType="vm:WorkspaceDocument">
        <ContentControl Content="{Binding TabViewModel}" />
    </DataTemplate>

    <!-- WorkspacesPaneDock is our typed subclass of DocumentDock for workspace-level tabs.
         Setting HeaderTemplate here enables custom tab header rendering with running
         and notification indicators, mirroring the inner WorkspaceContentDock pattern. -->
    <DataTemplate DataType="vm:WorkspacesPaneDock">
        <dock:DocumentControl>
            <dock:DocumentControl.HeaderTemplate>
                <DataTemplate x:DataType="vm:WorkspacePaneDocument">
                    <ContentControl Content="{Binding EffectiveTabHeader}" />
                </DataTemplate>
            </dock:DocumentControl.HeaderTemplate>
        </dock:DocumentControl>
    </DataTemplate>

    <!-- Workspace-level tab: shows the workspace's ContentLayout.
         The inner WorkspaceContentDock and WorkspaceDocument DataTemplates are placed directly on
         DockControl.DataTemplates so they are found before any ancestor FuncDataTemplate<IDocumentDock>
         that Dock auto-registers on PART_ContentControl, which would otherwise shadow the top-level
         templates and cause tab icons to go missing (regression from #374). -->
    <DataTemplate DataType="vm:WorkspacePaneDocument">
        <dock:DockControl Layout="{Binding WorkspacePane.ContentLayout}"
                          AutoCreateDataTemplates="False"
                          ts:DockTabSwitch.Enabled="True">
            <ts:DockTabSwitch.Bindings>
                <ts:DockTabSwitchBindings>
                    <ts:DockTabSwitchGestures Modifiers="Alt"
                                              Keys="Digits"
                                              Scope="FocusedDockOnly" />
                </ts:DockTabSwitchBindings>
            </ts:DockTabSwitch.Bindings>
            <dock:DockControl.DataTemplates>
                <DataTemplate DataType="vm:WorkspaceContentDock">
                    <dock:DocumentControl>
                        <dock:DocumentControl.HeaderTemplate>
                            <DataTemplate x:DataType="vm:WorkspaceDocument">
                                <ContentControl Content="{Binding EffectiveTabHeader}" />
                            </DataTemplate>
                        </dock:DocumentControl.HeaderTemplate>
                    </dock:DocumentControl>
                </DataTemplate>
                <DataTemplate DataType="vm:WorkspaceDocument">
                    <ContentControl Content="{Binding TabViewModel}" />
                </DataTemplate>
                <!-- Supply proportional (split) dock template within the inner pane
                     DockControl too, since it has its own scoped, non-inheriting
                     template set (#1130). -->
                <DataTemplate DataType="dmc:IProportionalDock">
                    <dock:ProportionalDockControl />
                </DataTemplate>
                <!-- Supply splitter and base DocumentDock templates within the inner
                     pane DockControl too, since AutoCreateDataTemplates="False" and its
                     template lookup does not walk up to ancestor scopes (#1130). -->
                <DataTemplate DataType="dmc:IProportionalDockSplitter">
                    <ProportionalStackPanelSplitter
                        IsResizingEnabled="{Binding CanResize}"
                        PreviewResize="{Binding ResizePreview}" />
                </DataTemplate>
                <DataTemplate DataType="dmc:IDocumentDock">
                    <dock:DocumentDockControl />
                </DataTemplate>
            </dock:DockControl.DataTemplates>
        </dock:DockControl>
    </DataTemplate>

    <!-- These DataTemplates are duplicated from WorkspaceDataTemplates.axaml so that they are
         reachable from within Dock.Avalonia's tab-header rendering scope, which does not walk
         up to the App-level DataTemplates collection (same class of issue as #374). -->
    <DataTemplate DataType="vm:TabHeaderViewModel">
        <Grid HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Title}"
                           ToolTip.Tip="{Binding Title}" />
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <!-- #1196: Dock.Avalonia tab-strip scope does not walk up to
                         ancestor DataTemplates. Reference the keyed DataTemplate
                         resources from App.axaml so the pulsating-brain / exclamation
                         indicators materialise inside the tab header. -->
                    <ItemsControl.DataTemplates>
                        <StaticResource ResourceKey="AgentRunningIndicatorTabHeaderItemTemplate" />
                        <StaticResource ResourceKey="NotificationIndicatorTabHeaderItemTemplate" />
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </DataTemplate>
</DataTemplates>
