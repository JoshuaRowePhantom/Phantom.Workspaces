<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.ViewModels"
             x:Class="Phantom.Workspaces.Templates.AgentManifestLaunchpadView"
             x:DataType="vm:AgentManifestLaunchpadViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,20">
      <TextBlock Text="{Binding ManifestEntity.DisplayName}"
                 FontSize="24"
                 FontWeight="Bold" />
      <TextBlock Text="Configure parameters and start a session."
                 FontSize="14"
                 Opacity="0.7" />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Parameters}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:AgentManifestParameterRowViewModel">
            <StackPanel Spacing="4" Margin="0,0,0,12">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Description}"
                         Opacity="0.7"
                         IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBox Text="{Binding Value}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10"
                Margin="0,20,0,0">
      <Button Content="Edit Manifest"
              Command="{Binding EditManifestCommand}" />
      <Button Content="Start Session"
              Command="{Binding StartSessionCommand}"
              IsEnabled="{Binding CanStart}"
              Classes="accent" />
    </StackPanel>
  </Grid>
</UserControl>
