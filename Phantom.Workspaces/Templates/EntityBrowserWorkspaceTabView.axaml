<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.ViewModels"
             xmlns:controls="using:Phantom.Workspaces.Gui.Shared.Controls"
             x:Class="Phantom.Workspaces.Templates.EntityBrowserWorkspaceTabView"
             x:DataType="vm:EntityBrowserWorkspaceTabViewModel">
    <ScrollViewer x:Name="BrowserScrollViewer"
                  AllowAutoHide="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  controls:StickyScroll.IsEnabled="True">
        <TreeView x:Name="BrowserTreeView"
                  Classes="entity-card-tree entity-card-tree-entity"
                  ItemsSource="{Binding EntityList.Items}" />
    </ScrollViewer>
</UserControl>
