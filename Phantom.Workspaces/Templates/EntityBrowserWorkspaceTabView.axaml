<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Phantom.Workspaces.ViewModels"
             xmlns:controls="using:Phantom.Workspaces.Gui.Styles.Controls"
             x:Class="Phantom.Workspaces.Templates.EntityBrowserWorkspaceTabView"
             x:DataType="vm:EntityBrowserWorkspaceTabViewModel">
    <ScrollViewer x:Name="BrowserScrollViewer"
                  AllowAutoHide="False"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  controls:StickyScroll.IsEnabled="True">
        <ItemsControl x:Name="BrowserItemsControl"
                      Classes="browser-entity-items"
                      ItemsSource="{Binding EntityList.Items}" />
    </ScrollViewer>
</UserControl>
