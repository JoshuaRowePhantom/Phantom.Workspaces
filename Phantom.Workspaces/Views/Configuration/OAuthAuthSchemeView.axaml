<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Phantom.Workspaces.ViewModels.Configuration"
             mc:Ignorable="d"
             x:Class="Phantom.Workspaces.Views.Configuration.OAuthAuthSchemeView"
             x:DataType="vm:OAuthAuthSchemeViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.7" />
        <StackPanel Spacing="4">
            <TextBlock Text="Trusted authority" />
            <TextBox PlaceholderText="Explicit HTTPS provider authority" Text="{Binding Authority}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Authorization endpoint" />
            <TextBox PlaceholderText="https://example.com/oauth/authorize" Text="{Binding AuthorizationEndpoint}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Token endpoint" />
            <TextBox PlaceholderText="https://example.com/oauth/token" Text="{Binding TokenEndpoint}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Trusted account endpoint" />
            <TextBox PlaceholderText="Explicit HTTPS account endpoint" Text="{Binding AccountEndpoint}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Account claim (Subject = sub; Identifier = id)" />
            <ComboBox ItemsSource="{Binding AccountIdentifierClaims}" SelectedItem="{Binding AccountIdentifierClaim}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Resource audience" />
            <TextBox PlaceholderText="Explicit provider resource audience" Text="{Binding Audience}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Resource endpoint pin (optional)" />
            <TextBox PlaceholderText="https://resource.example/" Text="{Binding Endpoint}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Client id" />
            <TextBox PlaceholderText="client-id" Text="{Binding ClientId}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Client secret (optional, ${SECRET:...} placeholder only)" />
            <TextBox PlaceholderText="${SECRET:my-oauth-secret}" Text="{Binding ClientSecret}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Scopes (optional, space-separated)" />
            <TextBox PlaceholderText="openid profile" Text="{Binding Scopes}" />
        </StackPanel>
    </StackPanel>
</UserControl>
