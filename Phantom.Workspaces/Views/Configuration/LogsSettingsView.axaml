<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Phantom.Workspaces.ViewModels.Configuration"
             mc:Ignorable="d"
             x:Class="Phantom.Workspaces.Views.Configuration.LogsSettingsView"
             x:DataType="vm:LogsSettingsViewModel">
    <StackPanel Spacing="12">
        <TextBlock Text="Logs" FontWeight="Bold" />

        <StackPanel Spacing="4">
            <TextBlock Text="Log directory" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding LogDirectory}"
                           FontFamily="Consolas,monospace"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Content="Open folder"
                        Command="{Binding OpenLogDirectoryCommand}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
