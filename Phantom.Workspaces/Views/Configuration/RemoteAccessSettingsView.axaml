<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Phantom.Workspaces.ViewModels.Configuration"
             mc:Ignorable="d"
             x:Class="Phantom.Workspaces.Views.Configuration.RemoteAccessSettingsView"
             x:DataType="vm:RemoteAccessSettingsViewModel">
    <StackPanel Spacing="12">
        <TextBlock Text="Remote access" FontWeight="Bold" />

        <CheckBox Content="Host the web data-access endpoint from this instance"
                  IsChecked="{Binding HostingEnabled}" />

        <CheckBox Content="Accept reverse execution from connected peers"
                  IsChecked="{Binding AcceptReverseExecution}" />

        <StackPanel Spacing="4">
            <TextBlock Text="Listen URL" />
            <TextBox PlaceholderText="http://localhost:5280" Text="{Binding ListenUrl}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Dev tunnel name" />
            <TextBox PlaceholderText="my-workspace-tunnel or auto" Text="{Binding TunnelName}" />
            <TextBlock Text="Name of the dev tunnel to host/connect by; the forwarded port is discovered automatically. When connecting, use &quot;auto&quot; to discover the single Workspaces tunnel without naming it."
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Dev tunnel access mode" />
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AvailableAccessModes}"
                      SelectedItem="{Binding DevTunnelAccessMode}" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding IsAnonymousAccessWarningVisible}">
            <TextBlock Text="Warning: anonymous tunnel access exposes workspace data without authentication."
                       Foreground="#B00020"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="User-computer-profile override (testing)" />
            <TextBox PlaceholderText="Leave blank for normal use" Text="{Binding UserComputerProfileOverride}" />
            <TextBlock Text="Testing only: set a unique value to run a second instance on this machine with its own profile, tunnel, and sessions."
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
