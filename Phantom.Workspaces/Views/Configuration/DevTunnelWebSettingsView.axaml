<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Phantom.Workspaces.ViewModels.Configuration"
             mc:Ignorable="d"
             x:Class="Phantom.Workspaces.Views.Configuration.DevTunnelWebSettingsView"
             x:DataType="vm:DevTunnelWebSettingsViewModel">
    <StackPanel Spacing="8">
        <StackPanel Spacing="4">
            <TextBlock Text="Dev tunnel endpoint" />
            <TextBox PlaceholderText="https://host.devtunnels.ms/" Text="{Binding Endpoint}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Access-token source (env var name)" />
            <TextBox PlaceholderText="DEVTUNNEL_TOKEN" Text="{Binding AccessTokenSource}" />
        </StackPanel>
    </StackPanel>
</UserControl>
