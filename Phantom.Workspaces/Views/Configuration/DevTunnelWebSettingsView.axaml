<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Phantom.Workspaces.ViewModels.Configuration"
             mc:Ignorable="d"
             x:Class="Phantom.Workspaces.Views.Configuration.DevTunnelWebSettingsView"
             x:DataType="vm:DevTunnelWebSettingsViewModel">
    <StackPanel Spacing="8">
        <StackPanel Spacing="4">
            <TextBlock Text="Dev tunnel name" />
            <TextBox x:Name="DevTunnelWebTunnelNameTextBox"
                     PlaceholderText="my-workspace-tunnel or auto"
                     Text="{Binding TunnelName}" />
            <TextBlock x:Name="DevTunnelWebTunnelNameHelperText"
                       Text="{Binding TunnelNameHelperText}"
                       TextWrapping="Wrap"
                       Opacity="0.7" />
        </StackPanel>
        <TextBlock Text="The dev tunnel endpoint is autodiscovered from the tunnel name. Authorizes automatically with your GitHub auth token (GITHUB_TOKEN or 'gh auth token')."
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
