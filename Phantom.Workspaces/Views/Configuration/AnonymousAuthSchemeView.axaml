<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Phantom.Workspaces.ViewModels.Configuration"
             mc:Ignorable="d"
             x:Class="Phantom.Workspaces.Views.Configuration.AnonymousAuthSchemeView"
             x:DataType="vm:AnonymousAuthSchemeViewModel">
    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.7" />
</UserControl>
