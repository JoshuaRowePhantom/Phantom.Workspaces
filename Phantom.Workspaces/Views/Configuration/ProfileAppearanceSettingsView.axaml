<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Phantom.Workspaces.ViewModels.Configuration"
             mc:Ignorable="d"
             x:Class="Phantom.Workspaces.Views.Configuration.ProfileAppearanceSettingsView"
             x:DataType="vm:ProfileAppearanceSettingsViewModel">
    <StackPanel Spacing="12">
        <TextBlock Text="Profile" FontWeight="Bold" />

        <StackPanel Spacing="4">
            <TextBlock Text="Theme" />
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Controller.ThemeNames}"
                      SelectedItem="{Binding Controller.SelectedThemeName}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Debugging" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="On"
                        Command="{Binding Controller.SetDebuggingCommand}"
                        CommandParameter="True"
                        IsEnabled="{Binding Controller.IsDebuggingDisabled}" />
                <Button Content="Off"
                        Command="{Binding Controller.SetDebuggingCommand}"
                        CommandParameter="False"
                        IsEnabled="{Binding Controller.IsDebuggingEnabled}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
