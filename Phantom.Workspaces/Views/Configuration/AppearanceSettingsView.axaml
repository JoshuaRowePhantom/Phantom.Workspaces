<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Phantom.Workspaces.ViewModels.Configuration"
             mc:Ignorable="d"
             x:Class="Phantom.Workspaces.Views.Configuration.AppearanceSettingsView"
             x:DataType="vm:AppearanceSettingsViewModel">
    <StackPanel Spacing="12">
        <TextBlock Text="Appearance" FontWeight="Bold" />
        <StackPanel Spacing="4">
            <TextBlock Text="Theme" />
            <TextBox Text="{Binding Theme}" />
        </StackPanel>
    </StackPanel>
</UserControl>
