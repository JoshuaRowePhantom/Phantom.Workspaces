<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Phantom.Workspaces.ViewModels.Configuration"
        xmlns:views="using:Phantom.Workspaces.Views.Configuration"
        mc:Ignorable="d"
        x:Class="Phantom.Workspaces.InstallationWizardWindow"
        x:DataType="vm:WorkspacesSettingsViewModel"
        SizeToContent="WidthAndHeight"
        MinWidth="480"
        MaxWidth="900"
        MinHeight="480"
        MaxHeight="820"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Title="Phantom.Workspaces Setup">
    <Window.DataTemplates>
        <DataTemplate DataType="vm:LocalMongoContainerSettingsViewModel">
            <views:LocalMongoContainerSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:RemoteMongoSettingsViewModel">
            <views:RemoteMongoSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:WebSettingsViewModel">
            <views:WebSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:DevTunnelWebSettingsViewModel">
            <views:DevTunnelWebSettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0"
                   Text="Welcome — choose how Phantom.Workspaces connects to its data."
                   TextWrapping="Wrap"
                   FontSize="16"
                   Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <TextBlock Text="Repository" FontWeight="Bold" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Data-access mode" />
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Repository.AvailableModes}"
                              SelectedItem="{Binding Repository.Mode}" />
                    <TextBlock Text="{Binding Repository.ActiveSettings.Description}"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ContentControl Content="{Binding Repository.ActiveSettings}" />

                <TextBlock Text="Remote access" FontWeight="Bold" Margin="0,8,0,0" />

                <StackPanel Spacing="4">
                    <CheckBox Content="Host the web data-access endpoint from this instance"
                              IsChecked="{Binding RemoteAccess.HostingEnabled}" />
                    <TextBlock Text="Turn on only if you want other peers/machines to connect to this instance. Off is correct for a solo/local user."
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                </StackPanel>

                <CheckBox Content="Accept reverse execution from connected peers"
                          IsChecked="{Binding RemoteAccess.AcceptReverseExecution}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Listen URL" />
                    <TextBox x:Name="WizardListenUrlTextBox"
                             PlaceholderText="http://localhost:5280"
                             Text="{Binding RemoteAccess.ListenUrl}"
                             IsEnabled="{Binding RemoteAccess.HostingEnabled}" />
                    <TextBlock Text="URL this instance listens on when hosting the data-access endpoint. Default http://localhost:5280 is fine for local development."
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Dev tunnel name" />
                    <TextBox PlaceholderText="my-workspace-tunnel or auto" Text="{Binding RemoteAccess.TunnelName}" />
                    <TextBlock x:Name="WizardTunnelNameHelperText"
                               Text="{Binding RemoteAccess.TunnelNameHelperTextValue}"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Dev tunnel access mode" />
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding RemoteAccess.AvailableAccessModes}"
                              SelectedItem="{Binding RemoteAccess.DevTunnelAccessMode}" />
                </StackPanel>

                <TextBlock Text="Warning: anonymous tunnel access exposes workspace data without authentication."
                           Foreground="#B00020"
                           TextWrapping="Wrap"
                           IsVisible="{Binding RemoteAccess.IsAnonymousAccessWarningVisible}" />

                <TextBlock Text="Advanced/testing options are available in Settings after setup."
                           Opacity="0.6"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Vertical"
                    Spacing="8"
                    Margin="0,16,0,0">
            <ItemsControl ItemsSource="{Binding ValidationMessages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="#B00020"
                                   TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="Cancel" Click="OnCancelClicked" />
                <Button Content="Complete setup"
                        IsEnabled="{Binding CanSave}"
                        Click="OnCompleteClicked" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
