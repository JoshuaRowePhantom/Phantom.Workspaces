<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Phantom.Workspaces.ViewModels"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:dmc="using:Dock.Model.Controls"

        xmlns:controls="using:Phantom.Workspaces.Controls"
        mc:Ignorable="d"
        x:Class="Phantom.Workspaces.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Classes="main-window-root"
        Width="1400"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        FontFamily="{DynamicResource Theme.FontFamily}"
        Title="Phantom.Workspaces">
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+W"         Command="{Binding CloseActiveTabCommand}" />
        <KeyBinding Gesture="Ctrl+Tab"       Command="{Binding CycleTabForwardCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding CycleTabBackwardCommand}" />
        <KeyBinding Gesture="F7" Command="{Binding NavigatePreviousNotificationCommand}" />
        <KeyBinding Gesture="F8" Command="{Binding NavigateNextNotificationCommand}" />
        <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding NavigateBackCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+OemMinus" Command="{Binding NavigateForwardCommand}" />
    </Window.KeyBindings>
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="window-header">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="{Binding RepositoryStatusText}" />
                    <TextBlock Classes="accent"
                               Text="Debug mode enabled"
                               IsVisible="{Binding IsDebuggingEnabled}" />
                </StackPanel>

                <ListBox Grid.Column="1"
                         Classes="top-view-list"
                         ItemsSource="{Binding TopLevelViews}"
                         SelectedItem="{Binding SelectedTopLevelView}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ViewDefinitionViewModel">
                            <Border Classes="top-view-item">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding IconGlyph}" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Panel Grid.Column="2"
                       IsVisible="{Binding ConnectionStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Button Classes="settings-gear"
                            Content="🌐"
                            ToolTip.Tip="Network connections"
                            Click="OnOpenConnectionStatusClicked" />
                    <TextBlock Text="❗"
                               Foreground="Red"
                               Opacity="0.6"
                               FontWeight="Bold"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,-2,-2,0"
                               IsVisible="{Binding ConnectionStatus.HasProblem, FallbackValue=False}"
                               ToolTip.Tip="{Binding ConnectionStatus.ProblemText}" />
                </Panel>

                <Button Grid.Column="3"
                        Classes="settings-gear"
                        Content="{Binding ScheduledToolsPause.ButtonGlyph, FallbackValue=⏱, TargetNullValue=⏱}"
                        ToolTip.Tip="{Binding ScheduledToolsPause.ToolTip, FallbackValue=Scheduled tasks, TargetNullValue=Scheduled tasks}"
                        Click="OnOpenScheduledTasksClicked" />

                <Panel Grid.Column="4">
                    <Button x:Name="NotificationBellButton"
                            Classes="settings-gear"
                            Content="🔔"
                            ToolTip.Tip="Notifications"
                            Command="{Binding NotificationsViewModel.ToggleOpenCommand}" />
                    <TextBlock Text="{Binding NotificationsViewModel.UnreadCount}"
                               IsVisible="{Binding NotificationsViewModel.HasUnread, FallbackValue=False}"
                               Foreground="{DynamicResource Theme.Notifications.Badge.Foreground}"
                               FontSize="9"
                               FontWeight="Bold"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,-2,-2,0" />
                    <Popup IsOpen="{Binding NotificationsViewModel.IsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding #NotificationBellButton}"
                           IsLightDismissEnabled="True">
                        <controls:NotificationsControl DataContext="{Binding NotificationsViewModel}" />
                    </Popup>
                </Panel>

                <Button Grid.Column="5"
                        Classes="settings-gear"
                        Content="⚙"
                        ToolTip.Tip="Settings"
                        Click="OnOpenSettingsClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,2*">
            <Grid Grid.Column="0"
                  Classes="entity-pane"
                  RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="pane-header">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTopLevelView.Title}" Classes="heading" />
                        <TextBlock Text="{Binding SelectedTopLevelView.Description}" Classes="muted" />
                        <TextBlock Text="{Binding StickyParentContextText}"
                                   FontStyle="Italic"
                                   Classes="accent sticky-context-note"
                                   IsVisible="{Binding HasStickyParentContext}" />
                        <CheckBox Content="Show hidden items"
                                  IsChecked="{Binding ShowHiddenItems}" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding SelectedTopLevelView.Entities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ViewEntityViewModel">
                                <StackPanel Margin="{Binding IndentMargin}"
                                            Spacing="6">
                                    <ContentControl Content="{Binding EntityCardNode}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" Classes="main-splitter" />

            <dock:DockControl Grid.Column="2" Layout="{Binding Layout}">
                <dock:DockControl.DataTemplates>
                    <!-- Workspace-level tab: shows the workspace's ContentLayout -->
                    <DataTemplate DataType="vm:WorkspacePaneDocument">
                        <dock:DockControl Layout="{Binding WorkspacePane.ContentLayout}"
                                         AutoCreateDataTemplates="False">
                            <dock:DockControl.DataTemplates>
                                <!-- Supply root dock template (normally auto-created). -->
                                <DataTemplate DataType="dmc:IRootDock">
                                    <dock:RootDockControl />
                                </DataTemplate>
                                <!-- WorkspaceContentDock is our typed subclass of DocumentDock.
                                     Using a concrete subtype means Dock's FuncDataTemplate<IDocumentDock>
                                     (on PART_ContentControl) is bypassed, so AutoCreateDataTemplates=False
                                     lets our DataTemplate on DockControl be found first. Setting
                                     HeaderTemplate here is a local value (priority 1), which beats the
                                     ControlTheme setter (priority 3). -->
                                <DataTemplate DataType="vm:WorkspaceContentDock">
                                    <dock:DocumentControl>
                                        <dock:DocumentControl.HeaderTemplate>
                                            <DataTemplate x:DataType="vm:WorkspaceDocument">
                                                <ContentControl Content="{Binding EffectiveTabHeader}" />
                                            </DataTemplate>
                                        </dock:DocumentControl.HeaderTemplate>
                                    </dock:DocumentControl>
                                </DataTemplate>
                                <!-- Content-level tab: shows the tab's ViewModel -->
                                <DataTemplate DataType="vm:WorkspaceDocument">
                                    <ContentControl Content="{Binding TabViewModel}" />
                                </DataTemplate>
                            </dock:DockControl.DataTemplates>
                        </dock:DockControl>
                    </DataTemplate>
                </dock:DockControl.DataTemplates>
            </dock:DockControl>
        </Grid>
    </Grid>
</Window>
