<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Phantom.Workspaces.ViewModels"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:ts="using:Phantom.Dock.Avalonia.TabSwitching"

        xmlns:controls="using:Phantom.Workspaces.Controls"
        mc:Ignorable="d"
        x:Class="Phantom.Workspaces.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Classes="main-window-root"
        Width="1400"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        FontFamily="{DynamicResource Theme.FontFamily}"
        Title="Phantom.Workspaces">
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+W"         Command="{Binding CloseActiveTabCommand}" />
        <KeyBinding Gesture="Ctrl+Tab"       Command="{Binding CycleTabForwardCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding CycleTabBackwardCommand}" />
        <KeyBinding Gesture="F7" Command="{Binding NavigatePreviousNotificationCommand}" />
        <KeyBinding Gesture="F8" Command="{Binding NavigateNextNotificationCommand}" />
        <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding NavigateBackCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+OemMinus" Command="{Binding NavigateForwardCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SelectedWorkspacePane.SaveCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding Find.OpenCommand}" />
    </Window.KeyBindings>
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Classes="window-header">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="{Binding RepositoryStatusText}" />
                    <TextBlock Classes="accent"
                               Text="Debug mode enabled"
                               IsVisible="{Binding IsDebuggingEnabled}" />
                </StackPanel>

                <ListBox Grid.Column="1"
                         Classes="top-view-list"
                         ItemsSource="{Binding TopLevelViews}"
                         SelectedItem="{Binding SelectedTopLevelView}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ViewDefinitionViewModel">
                            <Border Classes="top-view-item">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding IconGlyph}" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="TopRightBar"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Panel VerticalAlignment="Stretch"
                           IsVisible="{Binding ConnectionStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Button Classes="settings-gear top-right"
                                Content="🌐"
                                ToolTip.Tip="Network connections"
                                Click="OnOpenConnectionStatusClicked" />
                        <TextBlock Text="❗"
                                   Foreground="Red"
                                   Opacity="0.6"
                                   FontWeight="Bold"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Margin="0,-2,-2,0"
                                   IsVisible="{Binding ConnectionStatus.HasProblem, FallbackValue=False}"
                                   ToolTip.Tip="{Binding ConnectionStatus.ProblemText}" />
                    </Panel>

                    <Button Classes="settings-gear top-right"
                            ToolTip.Tip="{Binding ScheduledToolsPause.ToolTip, FallbackValue=Scheduled tasks, TargetNullValue=Scheduled tasks}"
                            Click="OnOpenScheduledTasksClicked">
                        <ProgressBar Classes="glyph-indicator vibrating-alarm-clock"
                                     IsIndeterminate="{Binding ScheduledToolsRunning.HasRunningTools, FallbackValue=False}"
                                     Classes.failed="{Binding ScheduledToolsRunning.HasFailure, FallbackValue=False}"
                                     Classes.paused="{Binding ScheduledToolsPause.IsPaused, FallbackValue=False}" />
                    </Button>

                    <Panel VerticalAlignment="Stretch"
                           IsVisible="{Binding RunningAgentBrain, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Button x:Name="RunningAgentBrainButton"
                                Classes="settings-gear top-right"
                                ToolTip.Tip="Running agents"
                                Command="{Binding RunningAgentBrain.ToggleOpenCommand}">
                            <ProgressBar Classes="glyph-indicator pulsating-brain"
                                         IsIndeterminate="{Binding RunningAgentBrain.IsAnyRunning, FallbackValue=False}" />
                        </Button>
                        <Popup IsOpen="{Binding RunningAgentBrain.IsOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding #RunningAgentBrainButton}"
                               IsLightDismissEnabled="True"
                               Focusable="False">
                            <controls:RunningAgentBrainControl DataContext="{Binding RunningAgentBrain}" />
                        </Popup>
                    </Panel>

                    <Panel VerticalAlignment="Stretch"
                           IsVisible="{Binding UsageTracker.TopRightLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Button x:Name="UsageTrackerButton"
                                Classes="settings-gear top-right"
                                ToolTip.Tip="AI Usage"
                                Command="{Binding UsageTracker.ToggleOpenCommand}">
                            <TextBlock Text="{Binding UsageTracker.TopRightLabel}"
                                       FontSize="11" />
                        </Button>
                        <Popup IsOpen="{Binding UsageTracker.IsOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding #UsageTrackerButton}"
                               IsLightDismissEnabled="True"
                               Focusable="False">
                            <controls:UsageTrackerControl DataContext="{Binding UsageTracker}" />
                        </Popup>
                    </Panel>

                    <Panel VerticalAlignment="Stretch">
                        <Button x:Name="NotificationBellButton"
                                Classes="settings-gear top-right"
                                ToolTip.Tip="Notifications"
                                Command="{Binding NotificationsViewModel.ToggleOpenCommand}">
                            <ProgressBar Classes="glyph-indicator swinging-bell"
                                         IsIndeterminate="{Binding NotificationsViewModel.HasActiveRun}" />
                        </Button>
                        <TextBlock Text="{Binding NotificationsViewModel.UnreadCount}"
                                   IsVisible="{Binding NotificationsViewModel.HasUnread, FallbackValue=False}"
                                   Foreground="{DynamicResource Theme.Notifications.Badge.Foreground}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Margin="0,-2,-2,0" />
                        <Popup IsOpen="{Binding NotificationsViewModel.IsOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding #NotificationBellButton}"
                               IsLightDismissEnabled="True"
                               Focusable="False">
                            <controls:NotificationsControl DataContext="{Binding NotificationsViewModel}" />
                        </Popup>
                    </Panel>

                    <Button Classes="settings-gear top-right save-workspace"
                            Content="💾"
                            ToolTip.Tip="Save workspace (Ctrl+S)"
                            Command="{Binding SelectedWorkspacePane.SaveCommand}"
                            IsVisible="{Binding SelectedWorkspacePane.CanSaveWorkspace, FallbackValue=False}" />

                    <Button Classes="settings-gear top-right"
                            Content="⚙"
                            ToolTip.Tip="Settings"
                            Click="OnOpenSettingsClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Classes="entity-find-bar"
                HorizontalAlignment="Left"
                IsVisible="{Binding Find.IsOpen}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox x:Name="FindTextBox"
                         Classes="entity-find-input"
                         Text="{Binding Find.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Watermark="Find entities…">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter"        Command="{Binding Find.NextCommand}" />
                        <KeyBinding Gesture="Shift+Enter"  Command="{Binding Find.PreviousCommand}" />
                        <KeyBinding Gesture="Ctrl+F"       Command="{Binding Find.NextCommand}" />
                        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding Find.PreviousCommand}" />
                        <KeyBinding Gesture="Escape"       Command="{Binding Find.CloseCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <TextBlock Classes="muted"
                           VerticalAlignment="Center"
                           Text="{Binding Find.MatchStatusText}" />
                <CheckBox Content="_Hide unmatched"
                          IsChecked="{Binding Find.HideUnmatched, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding LeftPaneColumnWidth}" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0"
                  Classes="entity-pane"
                  HorizontalAlignment="Stretch"
                  IsVisible="{Binding !IsLeftPaneCollapsed}"
                  RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="pane-header">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTopLevelView.Title}" Classes="heading" />
                        <TextBlock Text="{Binding SelectedTopLevelView.Description}" Classes="muted" />
                        <TextBlock Text="{Binding StickyParentContextText}"
                                   FontStyle="Italic"
                                   Classes="accent sticky-context-note"
                                   IsVisible="{Binding HasStickyParentContext}" />
                        <CheckBox Content="Show hidden items"
                                  IsChecked="{Binding ShowHiddenItems}" />
                    </StackPanel>
                </Border>

                <!-- Issue #1064: no surrounding ScrollViewer; the entity-card-tree two-regime
                     wrapper makes the tree's own inner scroller the single scroller (vertical
                     scroll plus below-minimum horizontal scroll), and wraps content to the viewport. -->
                <TreeView Grid.Row="1"
                          Classes="entity-card-tree entity-card-tree-entity"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding CurrentViewPopulation.RootEntities}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="vm:ViewEntityViewModel"
                                          ItemsSource="{Binding Children}">
                            <ContentControl Content="{Binding EntityCardNode}" />
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <GridSplitter Grid.Column="1" Classes="main-splitter" />

            <!-- Issue #1120: left-pane collapser mirrors the agent-chat one; positioned on the
                 right (inner) edge of the left column via the splitter column. Auto-expands on
                 top-level navigation (see MainWindowViewModel.SelectedTopLevelView). -->
            <ToggleButton Grid.Column="1"
                          Classes="pane-collapser"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsLeftPaneCollapsed, Mode=TwoWay}" />

            <dock:DockControl x:Name="TopLevelDockControl"
                              Grid.Column="2"
                              Layout="{Binding Layout}"
                              AutoCreateDataTemplates="False"
                              ts:DockTabSwitch.InstallOnTopLevel="True"
                              ts:DockTabSwitch.Enabled="True">
                <ts:DockTabSwitch.Bindings>
                    <ts:DockTabSwitchBindings>
                        <ts:DockTabSwitchGestures Modifiers="Alt,Shift"
                                                  Keys="Digits"
                                                  Scope="AllSwitchable" />
                    </ts:DockTabSwitchBindings>
                </ts:DockTabSwitch.Bindings>
            </dock:DockControl>
        </Grid>

        <!-- Anchor for the navigation-stack popup in the lower-left corner -->
        <Border x:Name="NavStackPopupAnchor"
                Grid.Row="2"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                IsHitTestVisible="False" />
        <Popup Grid.Row="2"
               IsOpen="{Binding NavStackPopup.IsOpen, Mode=TwoWay}"
               PlacementTarget="{Binding #NavStackPopupAnchor}"
               Placement="Top"
               HorizontalOffset="8"
               VerticalOffset="-8"
               IsLightDismissEnabled="False"
               Focusable="False">
            <controls:NavigationStackPopupControl DataContext="{Binding NavStackPopup}" />
        </Popup>
    </Grid>
</Window>



