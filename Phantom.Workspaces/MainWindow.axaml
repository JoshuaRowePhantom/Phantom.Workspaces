<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Phantom.Workspaces.ViewModels"
        mc:Ignorable="d"
        x:Class="Phantom.Workspaces.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1400"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSize.Base}"
        Foreground="{DynamicResource Theme.Class.normal.Foreground}"
        Title="Phantom.Workspaces">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="window-header">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="{Binding RepositoryStatusText}" />
                    <TextBlock Classes="accent"
                               Text="Debug mode enabled"
                               IsVisible="{Binding IsDebuggingEnabled}" />
                </StackPanel>

                <ListBox Grid.Column="1"
                         Classes="top-view-list"
                         ItemsSource="{Binding TopLevelViews}"
                         SelectedItem="{Binding SelectedTopLevelView}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ViewDefinitionViewModel">
                            <Border Classes="top-view-item">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding IconGlyph}" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Column="2"
                        Classes="settings-gear"
                        Content="⚙"
                        ToolTip.Tip="Settings"
                        Click="OnOpenSettingsClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,2*">
            <Grid Grid.Column="0"
                  Classes="entity-pane"
                  RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="pane-header">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTopLevelView.Title}" Classes="heading" />
                        <TextBlock Text="{Binding SelectedTopLevelView.Description}" Classes="muted" />
                        <TextBlock Text="{Binding StickyParentContextText}"
                                   Margin="0,6,0,0"
                                   FontStyle="Italic"
                                   Classes="accent"
                                   IsVisible="{Binding HasStickyParentContext}" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding SelectedTopLevelView.Entities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ViewEntityViewModel">
                                <Border Margin="{Binding IndentMargin}"
                                        Classes="entity-card"
                                        >
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding EntityType}" Classes="muted" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Open"
                                                    Command="{Binding $parent[Window].DataContext.ActivateEntityCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding DisplayItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:EntityDisplayItemViewModel">
                                                    <TextBlock Text="{Binding Text}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" Classes="main-splitter" />

            <TabControl Grid.Column="2"
                        ItemsSource="{Binding WorkspacePanes}"
                        SelectedItem="{Binding SelectedWorkspacePane}">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkspacePaneViewModel">
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </Grid>
    </Grid>
</Window>
