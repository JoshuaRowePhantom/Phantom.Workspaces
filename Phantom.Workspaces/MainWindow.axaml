<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Phantom.Workspaces.ViewModels"
        xmlns:dock="using:Dock.Avalonia.Controls"
        mc:Ignorable="d"
        x:Class="Phantom.Workspaces.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Classes="main-window-root"
        Width="1400"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        FontFamily="{DynamicResource Theme.FontFamily}"
        Title="Phantom.Workspaces">
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+W"         Command="{Binding CloseActiveTabCommand}" />
        <KeyBinding Gesture="Ctrl+Tab"       Command="{Binding CycleTabForwardCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding CycleTabBackwardCommand}" />
        <KeyBinding Gesture="Alt+1" Command="{Binding GoToTabAtIndexCommand}" CommandParameter="0" />
        <KeyBinding Gesture="Alt+2" Command="{Binding GoToTabAtIndexCommand}" CommandParameter="1" />
        <KeyBinding Gesture="Alt+3" Command="{Binding GoToTabAtIndexCommand}" CommandParameter="2" />
        <KeyBinding Gesture="Alt+4" Command="{Binding GoToTabAtIndexCommand}" CommandParameter="3" />
        <KeyBinding Gesture="Alt+5" Command="{Binding GoToTabAtIndexCommand}" CommandParameter="4" />
        <KeyBinding Gesture="Alt+6" Command="{Binding GoToTabAtIndexCommand}" CommandParameter="5" />
        <KeyBinding Gesture="Alt+7" Command="{Binding GoToTabAtIndexCommand}" CommandParameter="6" />
        <KeyBinding Gesture="Alt+8" Command="{Binding GoToTabAtIndexCommand}" CommandParameter="7" />
        <KeyBinding Gesture="Alt+9" Command="{Binding GoToTabAtIndexCommand}" CommandParameter="8" />
        <KeyBinding Gesture="Alt+0" Command="{Binding GoToTabAtIndexCommand}" CommandParameter="9" />
        <KeyBinding Gesture="Ctrl+1" Command="{Binding GoToWorkspacePaneAtIndexCommand}" CommandParameter="0" />
        <KeyBinding Gesture="Ctrl+2" Command="{Binding GoToWorkspacePaneAtIndexCommand}" CommandParameter="1" />
        <KeyBinding Gesture="Ctrl+3" Command="{Binding GoToWorkspacePaneAtIndexCommand}" CommandParameter="2" />
        <KeyBinding Gesture="Ctrl+4" Command="{Binding GoToWorkspacePaneAtIndexCommand}" CommandParameter="3" />
        <KeyBinding Gesture="Ctrl+5" Command="{Binding GoToWorkspacePaneAtIndexCommand}" CommandParameter="4" />
        <KeyBinding Gesture="Ctrl+6" Command="{Binding GoToWorkspacePaneAtIndexCommand}" CommandParameter="5" />
        <KeyBinding Gesture="Ctrl+7" Command="{Binding GoToWorkspacePaneAtIndexCommand}" CommandParameter="6" />
        <KeyBinding Gesture="Ctrl+8" Command="{Binding GoToWorkspacePaneAtIndexCommand}" CommandParameter="7" />
        <KeyBinding Gesture="Ctrl+9" Command="{Binding GoToWorkspacePaneAtIndexCommand}" CommandParameter="8" />
        <KeyBinding Gesture="Ctrl+0" Command="{Binding GoToWorkspacePaneAtIndexCommand}" CommandParameter="9" />
        <KeyBinding Gesture="F7" Command="{Binding NavigatePreviousNotificationCommand}" />
        <KeyBinding Gesture="F8" Command="{Binding NavigateNextNotificationCommand}" />
    </Window.KeyBindings>
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="window-header">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="{Binding RepositoryStatusText}" />
                    <TextBlock Classes="accent"
                               Text="Debug mode enabled"
                               IsVisible="{Binding IsDebuggingEnabled}" />
                </StackPanel>

                <ListBox Grid.Column="1"
                         Classes="top-view-list"
                         ItemsSource="{Binding TopLevelViews}"
                         SelectedItem="{Binding SelectedTopLevelView}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ViewDefinitionViewModel">
                            <Border Classes="top-view-item">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding IconGlyph}" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Panel Grid.Column="2"
                       IsVisible="{Binding ConnectionStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Button Classes="settings-gear"
                            Content="🌐"
                            ToolTip.Tip="Network connections"
                            Click="OnOpenConnectionStatusClicked" />
                    <TextBlock Text="❗"
                               Foreground="Red"
                               Opacity="0.6"
                               FontWeight="Bold"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,-2,-2,0"
                               IsVisible="{Binding ConnectionStatus.HasProblem, FallbackValue=False}"
                               ToolTip.Tip="{Binding ConnectionStatus.ProblemText}" />
                </Panel>

                <Button Grid.Column="3"
                        Classes="settings-gear"
                        Content="{Binding ScheduledToolsPause.ButtonGlyph, FallbackValue=⏱, TargetNullValue=⏱}"
                        ToolTip.Tip="{Binding ScheduledToolsPause.ToolTip, FallbackValue=Scheduled tasks, TargetNullValue=Scheduled tasks}"
                        Click="OnOpenScheduledTasksClicked" />

                <Panel Grid.Column="4">
                    <Button Classes="settings-gear"
                            Content="🔔"
                            ToolTip.Tip="Notifications"
                            Command="{Binding NotificationsViewModel.ToggleOpenCommand}" />
                    <TextBlock Text="{Binding NotificationsViewModel.UnreadCount}"
                               IsVisible="{Binding NotificationsViewModel.HasUnread, FallbackValue=False}"
                               Foreground="Gold"
                               FontSize="9"
                               FontWeight="Bold"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,-2,-2,0" />
                </Panel>

                <Button Grid.Column="5"
                        Classes="settings-gear"
                        Content="⚙"
                        ToolTip.Tip="Settings"
                        Click="OnOpenSettingsClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,2*">
            <Grid Grid.Column="0"
                  Classes="entity-pane"
                  RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="pane-header">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTopLevelView.Title}" Classes="heading" />
                        <TextBlock Text="{Binding SelectedTopLevelView.Description}" Classes="muted" />
                        <TextBlock Text="{Binding StickyParentContextText}"
                                   FontStyle="Italic"
                                   Classes="accent sticky-context-note"
                                   IsVisible="{Binding HasStickyParentContext}" />
                        <CheckBox Content="Show hidden items"
                                  IsChecked="{Binding ShowHiddenItems}" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding SelectedTopLevelView.Entities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ViewEntityViewModel">
                                <StackPanel Margin="{Binding IndentMargin}"
                                            Spacing="6">
                                    <ContentControl Content="{Binding EntityCardNode}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" Classes="main-splitter" />

            <dock:DockControl Grid.Column="2" Layout="{Binding Layout}">
                <dock:DockControl.DataTemplates>
                    <!-- Workspace-level tab: shows the workspace's ContentLayout -->
                    <DataTemplate DataType="vm:WorkspacePaneDocument">
                        <dock:DockControl Layout="{Binding WorkspacePane.ContentLayout}">
                            <dock:DockControl.DataTemplates>
                                <!-- Content-level tab: shows the tab's ViewModel -->
                                <DataTemplate DataType="vm:WorkspaceDocument">
                                    <ContentControl Content="{Binding TabViewModel}" />
                                </DataTemplate>
                            </dock:DockControl.DataTemplates>
                        </dock:DockControl>
                    </DataTemplate>
                </dock:DockControl.DataTemplates>
            </dock:DockControl>

            <Border Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsVisible="{Binding NotificationsViewModel.IsOpen, FallbackValue=False}"
                    ZIndex="100"
                    Width="360"
                    MaxHeight="480"
                    Background="#E0202020"
                    CornerRadius="6"
                    BoxShadow="0 4 16 0 #80000000">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12,8">
                        <TextBlock Text="Notifications" FontWeight="SemiBold" />
                    </Border>
                    <ScrollViewer Grid.Row="1" MaxHeight="420">
                        <ItemsControl ItemsSource="{Binding NotificationsViewModel.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NotificationRowViewModel">
                                    <Border Padding="8,4" Margin="0,1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0"
                                                    Command="{Binding NavigateCommand}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Padding="4">
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{Binding TabTitle}" />
                                                        <TextBlock Text=" · " />
                                                        <TextBlock Text="{Binding Reason}" Opacity="0.7" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding RelativeTime}" Opacity="0.5" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Command="{Binding SnoozeCommand}"
                                                    Content="💤"
                                                    VerticalAlignment="Top"
                                                    Padding="6,4" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
