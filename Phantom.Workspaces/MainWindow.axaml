<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Phantom.Workspaces.ViewModels"
        mc:Ignorable="d"
        x:Class="Phantom.Workspaces.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1400"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Title="Phantom.Workspaces">
    <Window.DataTemplates>
        <DataTemplate DataType="vm:NoteWorkspaceTabViewModel">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" />
                <TextBox Text="{Binding Markdown}"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:EntityWorkspaceTabViewModel">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="{Binding Entity.EntityType}" Opacity="0.7" />
                <ItemsControl ItemsSource="{Binding Entity.DisplayItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding .}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:BrowserWorkspaceTabViewModel">
            <StackPanel Spacing="6">
                <TextBlock Text="Browser" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="{Binding Url}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="vm:WorkspacePaneViewModel">
            <Grid RowDefinitions="Auto,*">
                <Border Padding="12,10" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="{Binding Entity.EntityType}" Opacity="0.75" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Regions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkspaceRegionViewModel">
                                <Border Margin="0,0,0,12" Padding="10" BorderThickness="1" CornerRadius="6">
                                    <Grid RowDefinitions="Auto,*">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding DockRegion}" Opacity="0.7" />
                                            <TextBlock Text="{Binding RelativeSize, StringFormat='x{0}'}" Opacity="0.7" />
                                        </StackPanel>
                                        <TabControl Grid.Row="1"
                                                    ItemsSource="{Binding Tabs}"
                                                    SelectedItem="{Binding SelectedTab}">
                                            <TabControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WorkspaceTabViewModel">
                                                    <TextBlock Text="{Binding Title}" />
                                                </DataTemplate>
                                            </TabControl.ItemTemplate>
                                        </TabControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{Binding RepositoryStatusText}" />

                <ListBox Grid.Column="1"
                         Margin="18,0"
                         ItemsSource="{Binding TopLevelViews}"
                         SelectedItem="{Binding SelectedTopLevelView}"
                         BorderThickness="0"
                         HorizontalAlignment="Left"
                         Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ViewDefinitionViewModel">
                            <Border CornerRadius="6" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding IconGlyph}" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="Theme" />
                    <Button Content="Dark" Command="{Binding SetDarkThemeCommand}" IsEnabled="{Binding IsLightThemeSelected}" />
                    <Button Content="Light" Command="{Binding SetLightThemeCommand}" IsEnabled="{Binding IsDarkThemeSelected}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,6,2*">
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <Border Grid.Row="0" Padding="12,10" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTopLevelView.Title}" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="{Binding SelectedTopLevelView.Description}" Opacity="0.75" />
                        <TextBlock Text="{Binding StickyParentContextText}"
                                   Margin="0,6,0,0"
                                   FontStyle="Italic"
                                   IsVisible="{Binding HasStickyParentContext}" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding VisibleEntities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EntityVisualViewModel">
                                <Border Margin="{Binding IndentMargin}"
                                        Padding="10"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding EntityType}" Opacity="0.65" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Open"
                                                    Command="{Binding $parent[Window].DataContext.ActivateEntityCommand}"
                                                    CommandParameter="{Binding}" />

                                            <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Badges}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border CornerRadius="10" Padding="8,2" Margin="0,2,6,0">
                                                            <TextBlock Text="{Binding .}" FontSize="11" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding DisplayItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{Binding .}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <TabControl Grid.Column="2"
                        ItemsSource="{Binding WorkspacePanes}"
                        SelectedItem="{Binding SelectedWorkspacePane}">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkspacePaneViewModel">
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </Grid>
    </Grid>
</Window>
