<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Phantom.Workspaces.ViewModels"
        mc:Ignorable="d"
        x:Class="Phantom.Workspaces.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Classes="main-window-root"
        Width="1400"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        FontFamily="{DynamicResource Theme.FontFamily}"
        Title="Phantom.Workspaces">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="window-header">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="{Binding RepositoryStatusText}" />
                    <TextBlock Classes="accent"
                               Text="Debug mode enabled"
                               IsVisible="{Binding IsDebuggingEnabled}" />
                </StackPanel>

                <ListBox Grid.Column="1"
                         Classes="top-view-list"
                         ItemsSource="{Binding TopLevelViews}"
                         SelectedItem="{Binding SelectedTopLevelView}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ViewDefinitionViewModel">
                            <Border Classes="top-view-item">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding IconGlyph}" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Column="2"
                        Classes="settings-gear"
                        Content="🌐"
                        ToolTip.Tip="Network connections"
                        Click="OnOpenConnectionStatusClicked"
                        IsVisible="{Binding ConnectionStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <Button Grid.Column="3"
                        Classes="settings-gear"
                        Content="⚙"
                        ToolTip.Tip="Settings"
                        Click="OnOpenSettingsClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,2*">
            <Grid Grid.Column="0"
                  Classes="entity-pane"
                  RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="pane-header">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTopLevelView.Title}" Classes="heading" />
                        <TextBlock Text="{Binding SelectedTopLevelView.Description}" Classes="muted" />
                        <TextBlock Text="{Binding StickyParentContextText}"
                                   FontStyle="Italic"
                                   Classes="accent sticky-context-note"
                                   IsVisible="{Binding HasStickyParentContext}" />
                        <CheckBox Content="Show hidden items"
                                  IsChecked="{Binding ShowHiddenItems}" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding SelectedTopLevelView.Entities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ViewEntityViewModel">
                                <StackPanel Margin="{Binding IndentMargin}"
                                            Spacing="6">
                                    <ContentControl Content="{Binding EntityCardNode}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" Classes="main-splitter" />

            <TabControl Grid.Column="2"
                        ItemsSource="{Binding WorkspacePanes}"
                        SelectedItem="{Binding SelectedWorkspacePane}">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkspacePaneViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            <Button Content="✕"
                                    Command="{Binding CloseCommand}"
                                    CommandParameter="{Binding}"
                                    Classes="tab-close-button"
                                    IsVisible="{Binding CloseCommand, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    ToolTip.Tip="Close workspace" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:WorkspacePaneViewModel">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Region tabs within workspace -->
                            <TabControl Grid.Row="0"
                                        ItemsSource="{Binding Regions}"
                                        SelectedItem="{Binding SelectedRegion}"
                                        IsVisible="{Binding HasRegions}">
                                <TabControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkspaceRegionViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                            <Button Content="✕"
                                                    Command="{Binding CloseTabCommand}"
                                                    Classes="tab-close-button"
                                                    ToolTip.Tip="Close tab" />
                                        </StackPanel>
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:WorkspaceRegionViewModel">
                                        <ContentControl Content="{Binding}" />
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                            
                            <!-- Message when no regions -->
                            <Border Grid.Row="0"
                                    IsVisible="{Binding HasNoRegions}"
                                    Padding="16">
                                <TextBlock Text="No tabs open in this workspace"
                                           Classes="muted"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </Grid>
</Window>
