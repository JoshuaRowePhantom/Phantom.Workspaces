<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Phantom.Workspaces.ViewModels"
        xmlns:secrets="using:Phantom.Workspaces.Llm.Secrets"
        xmlns:converters="using:Phantom.Workspaces.Converters"
        mc:Ignorable="d"
        x:Class="Phantom.Workspaces.SecretUseDialogWindow"
        x:DataType="vm:SecretUseDialogViewModel"
        SizeToContent="WidthAndHeight"
        MinWidth="760"
        MaxWidth="1100"
        MinHeight="320"
        MaxHeight="760"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Allow secret use">
    <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="16">
        <TextBlock Grid.Row="0" Text="Would you like to allow using the following secrets?" />

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SecretUseDialogRowViewModel">
                        <Grid ColumnDefinitions="160,260,Auto,260,Auto" Margin="0,0,0,8" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{Binding SecretName}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding UseDisplayString}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding AvailableMemories}"
                                      SelectedItem="{Binding SelectedMemory, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="secrets:SecretUseMemory">
                                        <TextBlock Text="{Binding DisplayString}"
                                                   TextTrimming="None"
                                                   ToolTip.Tip="{Binding DisplayString}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding AvailableSources}"
                                      SelectedItem="{Binding SelectedSource, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="secrets:SecretSource">
                                        <TextBlock Text="{Binding Converter={x:Static converters:SecretSourceLabelConverter.Instance}}"
                                                   TextTrimming="None"
                                                   ToolTip.Tip="{Binding Converter={x:Static converters:SecretSourceLabelConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="4"
                                    Content="…"
                                    Command="{Binding PickCredentialCommand}"
                                    ToolTip.Tip="Select or enter a saved credential" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="No" Click="OnNoClicked" />
            <Button Content="Yes" Click="OnYesClicked" />
        </StackPanel>
    </Grid>
</Window>
