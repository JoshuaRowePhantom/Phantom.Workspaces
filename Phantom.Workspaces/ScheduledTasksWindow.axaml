<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Phantom.Workspaces.ViewModels"
        x:Class="Phantom.Workspaces.ScheduledTasksWindow"
        x:DataType="vm:ScheduledTasksViewModel"
        x:CompileBindings="False"
        Width="720"
        Height="560"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Title="Scheduled Tasks">
    <Grid RowDefinitions="Auto,*,Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0"
                   Text="Scheduled tasks"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <Border Grid.Row="1" BorderThickness="1" CornerRadius="6" Padding="8"
                BorderBrush="{DynamicResource Theme.Class.muted.Foreground}">
            <Grid>
                <TextBlock Text="No scheduled tasks on this workspace."
                           IsVisible="{Binding !HasScheduledTasks}"
                           Opacity="0.7" />
                <ScrollViewer IsVisible="{Binding HasScheduledTasks}">
                    <ItemsControl ItemsSource="{Binding ScheduledTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6" Margin="0,0,0,6"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource Theme.Class.muted.Foreground}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding ToolDisplayName}" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding ScheduleDisplayName, StringFormat='Schedule: {0}'}" Opacity="0.8" />
                                            <TextBlock Text="{Binding TargetDisplayName, StringFormat='Target: {0}'}" Opacity="0.8" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Opacity="0.7" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Tool runs (running and recent)"
                   FontWeight="SemiBold"
                   Margin="0,16,0,8" />
        <Border Grid.Row="3" BorderThickness="1" CornerRadius="6" Padding="8"
                BorderBrush="{DynamicResource Theme.Class.muted.Foreground}">
            <TreeView ItemsSource="{Binding ToolResults.Hosts}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock Text="{Binding Status}" Opacity="0.7" IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="{Binding PauseButtonText}"
                    Command="{Binding TogglePauseCommand}"
                    IsVisible="{Binding HasPauseControl}" />
            <Button Content="Refresh" Click="OnRefreshClick" />
            <Button Content="Close" Click="OnCloseClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
