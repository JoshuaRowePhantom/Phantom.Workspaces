<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Phantom.Workspaces.ViewModels"
        x:Class="Phantom.Workspaces.ScheduledTasksWindow"
        x:DataType="vm:ScheduledTasksViewModel"
        x:CompileBindings="False"
        Width="720"
        Height="560"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Title="Scheduled Tasks">
    <Grid RowDefinitions="Auto,*,Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0"
                   Text="Scheduled tasks"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />
        <Border Grid.Row="1" BorderThickness="1" CornerRadius="6" Padding="8"
                BorderBrush="{DynamicResource Theme.Class.muted.Foreground}">
            <Grid>
                <TextBlock Text="No scheduled tasks on this workspace."
                           IsVisible="{Binding !HasScheduledTasks}"
                           Opacity="0.7" />
                <ScrollViewer IsVisible="{Binding HasScheduledTasks}">
                    <ListBox ItemsSource="{Binding ScheduledTasks}"
                             SelectedItem="{Binding SelectedTask}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6" Margin="0,0,0,6"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource Theme.Class.muted.Foreground}">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="🔔"
                                                       IsVisible="{Binding IsRunning}"
                                                       ToolTip.Tip="Running" />
                                            <TextBlock Text="❗"
                                                       Foreground="{DynamicResource Theme.Status.Bad}"
                                                       IsVisible="{Binding HasFailure}"
                                                       ToolTip.Tip="Last run failed" />
                                            <TextBlock Text="✅"
                                                       IsVisible="{Binding LastRunSucceeded}"
                                                       ToolTip.Tip="Last run succeeded" />
                                            <TextBlock Text="{Binding ToolDisplayName}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding ScheduleDisplayName, StringFormat='Schedule: {0}'}" Opacity="0.8" />
                                            <TextBlock Text="{Binding TargetDisplayName, StringFormat='Target: {0}'}" Opacity="0.8" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Opacity="0.7" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Tool runs"
                   FontWeight="SemiBold"
                   Margin="0,16,0,8" />
        <Border Grid.Row="3" BorderThickness="1" CornerRadius="6" Padding="8"
                BorderBrush="{DynamicResource Theme.Class.muted.Foreground}">
            <Grid>
                <TextBlock Text="No tool runs recorded."
                           IsVisible="{Binding ScheduledToolsRunning, Converter={x:Static ObjectConverters.IsNull}}"
                           Opacity="0.7" />
                <TextBlock Text="Select a task above to see its run history."
                           IsVisible="{Binding SelectedTask, Converter={x:Static ObjectConverters.IsNull}}"
                           Opacity="0.7" />
                <TreeView ItemsSource="{Binding SelectedToolRow.RecentRuns}"
                          IsVisible="{Binding SelectedTask, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding SubRuns}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding StatusGlyph}" Opacity="0.9" />
                                <TextBlock Text="{Binding StartedAt, StringFormat='{}{0:HH:mm:ss}'}" Opacity="0.7" />
                                <TextBlock Text="{Binding Duration, StringFormat='{}{0:g}'}"
                                           Opacity="0.7"
                                           IsVisible="{Binding Duration, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{Binding Message}"
                                           IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Opacity="0.8"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="{Binding PauseButtonText}"
                    Command="{Binding TogglePauseCommand}"
                    IsVisible="{Binding HasPauseControl}" />
            <Button Content="Refresh" Click="OnRefreshClick" />
            <Button Content="Close" Click="OnCloseClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
