<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ActiveDebugProfile>Phantom.Workspaces.MongoDb</ActiveDebugProfile>
    <!-- Per-RID self-contained single-file publish targets (no AnyCPU single file). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <!-- Publish-only settings: active only when a RuntimeIdentifier is specified (i.e. during
       `dotnet publish -r <rid>`), so normal `dotnet build`/F5 debugging is unaffected. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- The GUI references other (non-self-contained) executable projects; the self-contained
         single-file bundle pulls in their assemblies, so bypass the SDK's matching check. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <!-- Referenced executable projects emit their own apphost/deps.json under both the RID and
         non-RID paths; the GUI is the only entry point we ship, so tolerate the duplicates. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
  <!-- When the GUI is built non-RID (e.g. by `dotnet build`/`dotnet test`) and then published for
       a RID, each referenced executable project leaves both a non-RID and a RID `apphost.exe` that
       map to the same bundle entry (e.g. Phantom.Workspaces.Containers.exe), crashing the
       single-file bundler. Drop the non-RID copies, keeping the RID-specific one. -->
  <Target Name="RemoveDuplicateReferencedAppHosts"
          AfterTargets="_ComputeFilesToBundle"
          Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_FilesToBundle Remove="@(_FilesToBundle)"
          Condition="'%(_FilesToBundle.Filename)%(_FilesToBundle.Extension)' == 'apphost.exe' and !$([System.String]::Copy('%(_FilesToBundle.Identity)').Contains('\$(RuntimeIdentifier)\'))" />
    </ItemGroup>
  </Target>
  <!-- Issue #1376: GitHub.Copilot.SDK resolves its CLI strictly from
       AppContext.BaseDirectory\runtimes\<rid>\native\copilot.exe and does NOT search PATH. The SDK
       registers copilot.exe / copilot_runtime.dll / LICENSE.md as Content (not native libraries).
       PublishSingleFile drops that transitive content from the publish output entirely (verified:
       no runtimes\ tree appears in the single-file publish), so the installed payload has no
       copilot.exe and the provider fails with "Copilot runtime not found". The regular build
       output ($(OutDir)) DOES contain runtimes\<rid>\native\{copilot.exe,copilot_runtime.dll,
       LICENSE.md} (the SDK copies them there and the LICENSE is added by Llm.Core). Copy them into
       the publish output as LOOSE files beside the single-file exe (BaseDirectory), where the SDK's
       default lookup finds them, and ship the CLI LICENSE.md unmodified as required by the GitHub
       Copilot CLI License. -->
  <Target Name="PublishCopilotRuntimeLoose"
           AfterTargets="Publish"
           DependsOnTargets="ValidatePreparedCopilotPayload;PublishCopilotWrapperLoose"
           Condition="'$(RuntimeIdentifier)' != '' And '$(PublishCopilotRuntime)' != 'false'">
    <PropertyGroup>
      <_CopilotRuntimeSourceDirectory Condition="'$(UsePreparedCopilotPayloadForTests)' == 'true'">$(PreparedCopilotPayloadDirectory)</_CopilotRuntimeSourceDirectory>
      <_CopilotRuntimeSourceDirectory Condition="'$(_CopilotRuntimeSourceDirectory)' == ''">$(OutDir)runtimes\$(RuntimeIdentifier)\native</_CopilotRuntimeSourceDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_CopilotRuntimeToPublish Include="$(_CopilotRuntimeSourceDirectory)\copilot.exe" />
      <_CopilotRuntimeToPublish Include="$(_CopilotRuntimeSourceDirectory)\copilot_runtime.dll"
                                Condition="Exists('$(_CopilotRuntimeSourceDirectory)\copilot_runtime.dll')" />
      <_CopilotRuntimeToPublish Include="$(_CopilotRuntimeSourceDirectory)\LICENSE.md" />
    </ItemGroup>
    <Error Condition="!Exists('$(_CopilotRuntimeSourceDirectory)\copilot.exe')"
           Text="Copilot CLI not found in payload source '$(_CopilotRuntimeSourceDirectory)\copilot.exe'; cannot bundle it into the publish payload (issue #1376)." />
    <Error Condition="!Exists('$(_CopilotRuntimeSourceDirectory)\LICENSE.md')"
           Text="GitHub Copilot CLI LICENSE.md not found in payload source '$(_CopilotRuntimeSourceDirectory)\LICENSE.md'; the redistributed CLI must ship its license (issue #1376)." />
    <Copy SourceFiles="@(_CopilotRuntimeToPublish)"
          DestinationFolder="$(PublishDir)runtimes\$(RuntimeIdentifier)\native"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)runtimes\$(RuntimeIdentifier)\native\copilot.exe')"
           Text="Copilot CLI (runtimes\$(RuntimeIdentifier)\native\copilot.exe) was not published as a loose file (issue #1376)." />
    <Error Condition="!Exists('$(PublishDir)runtimes\$(RuntimeIdentifier)\native\phantom-copilot-wrapper.exe')"
           Text="The Copilot MXC wrapper was not published as a loose file." />
  </Target>
  <Target Name="ValidatePreparedCopilotPayload"
          BeforeTargets="PublishCopilotWrapperLoose;PublishCopilotRuntimeLoose;PublishMxcRuntimeLoose"
          Condition="'$(UsePreparedCopilotPayloadForTests)' != '' Or '$(PreparedCopilotPayloadDirectory)' != '' Or '$(PreparedCopilotPayloadFingerprint)' != '' Or '$(PreparedCopilotPayloadConfiguration)' != '' Or '$(PreparedCopilotPayloadRuntimeIdentifier)' != '' Or '$(PreparedCopilotPayloadManifestSha256)' != '' Or '$(PreparedCopilotWrapperSha256)' != '' Or '$(PreparedCopilotCliSha256)' != '' Or '$(PreparedCopilotRuntimeSha256)' != '' Or '$(PreparedCopilotLicenseSha256)' != '' Or '$(PreparedMxcFfiSha256)' != '' Or '$(PreparedPlmSha256)' != '' Or '$(PreparedMxcLicenseSha256)' != '' Or '$(SimulateMissingCopilotWrapperChildOutputForTests)' != '' Or '$(UsePreparedCopilotPayload)' != '' Or '$(RequirePreparedCopilotWrapper)' != '' Or '$(CopilotWrapperPreparedExecutable)' != '' Or '$(CopilotWrapperPreparedConfiguration)' != '' Or '$(CopilotWrapperPreparedRuntimeIdentifier)' != ''">
    <Error Condition="'$(UsePreparedCopilotPayload)' != '' Or '$(RequirePreparedCopilotWrapper)' != '' Or '$(CopilotWrapperPreparedExecutable)' != '' Or '$(CopilotWrapperPreparedConfiguration)' != '' Or '$(CopilotWrapperPreparedRuntimeIdentifier)' != ''"
           Text="Legacy prepared Copilot properties are unsafe and are not supported." />
    <Error Condition="'$(UsePreparedCopilotPayloadForTests)' != 'true'"
           Text="Prepared Copilot payload properties require explicit test-only opt-in with UsePreparedCopilotPayloadForTests=true." />
    <Error Condition="'$(SimulateMissingCopilotWrapperChildOutputForTests)' != '' And '$(SimulateMissingCopilotWrapperChildOutputForTests)' != 'true'"
           Text="SimulateMissingCopilotWrapperChildOutputForTests only accepts true in prepared test mode." />
    <Error Condition="'$(NoBuild)' != 'true'"
           Text="Prepared Copilot payload inputs may only be used by a build-free target invocation with NoBuild=true." />
    <Error Condition="'$(PreparedCopilotPayloadDirectory)' == '' Or !$([System.IO.Path]::IsPathFullyQualified('$(PreparedCopilotPayloadDirectory)')) Or !Exists('$(PreparedCopilotPayloadDirectory)')"
           Text="The prepared Copilot payload directory does not exist at '$(PreparedCopilotPayloadDirectory)'." />
    <Error Condition="'$(PreparedCopilotPayloadConfiguration)' != '$(Configuration)'"
           Text="The prepared Copilot payload configuration '$(PreparedCopilotPayloadConfiguration)' does not match '$(Configuration)'." />
    <Error Condition="'$(PreparedCopilotPayloadRuntimeIdentifier)' != '$(RuntimeIdentifier)'"
           Text="The prepared Copilot payload RID '$(PreparedCopilotPayloadRuntimeIdentifier)' does not match '$(RuntimeIdentifier)'." />
    <PropertyGroup>
      <_PreparedCopilotPayloadCanonicalDirectory>$([System.IO.Path]::TrimEndingDirectorySeparator($([System.IO.Path]::GetFullPath('$(PreparedCopilotPayloadDirectory)'))))</_PreparedCopilotPayloadCanonicalDirectory>
      <_PreparedCopilotPayloadDirectoryName>$([System.IO.Path]::GetFileName('$(_PreparedCopilotPayloadCanonicalDirectory)'))</_PreparedCopilotPayloadDirectoryName>
      <_PreparedCopilotPayloadCacheDirectory>$([System.IO.Path]::GetDirectoryName('$(_PreparedCopilotPayloadCanonicalDirectory)'))</_PreparedCopilotPayloadCacheDirectory>
      <_PreparedCopilotPayloadCacheRoot>$([System.IO.Path]::GetDirectoryName('$(_PreparedCopilotPayloadCacheDirectory)'))</_PreparedCopilotPayloadCacheRoot>
      <_PreparedCopilotPayloadCacheName>$([System.IO.Path]::GetFileName('$(_PreparedCopilotPayloadCacheDirectory)'))</_PreparedCopilotPayloadCacheName>
      <_PreparedCopilotPayloadExpectedCacheRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Phantom.Workspaces.Install.Tests\obj\mxcw'))</_PreparedCopilotPayloadExpectedCacheRoot>
      <_PreparedCopilotPayloadFingerprintFile>$(_PreparedCopilotPayloadCacheDirectory)\prerequisite.fingerprint</_PreparedCopilotPayloadFingerprintFile>
      <_PreparedCopilotPayloadManifestFile>$(_PreparedCopilotPayloadCacheDirectory)\prerequisite.json</_PreparedCopilotPayloadManifestFile>
      <_PreparedCopilotPayloadFingerprintPrefix Condition="$([System.String]::Copy('$(PreparedCopilotPayloadFingerprint)').Length) &gt;= 16">$([System.String]::Copy('$(PreparedCopilotPayloadFingerprint)').Substring(0, 16))</_PreparedCopilotPayloadFingerprintPrefix>
    </PropertyGroup>
    <Error Condition="'$(PreparedCopilotPayloadDirectory)' != '$(_PreparedCopilotPayloadCanonicalDirectory)' Or '$(_PreparedCopilotPayloadDirectoryName)' != 'prepared'"
           Text="The prepared Copilot payload directory must be the canonical absolute 'prepared' directory." />
    <Error Condition="'$(_PreparedCopilotPayloadCacheRoot)' != '$(_PreparedCopilotPayloadExpectedCacheRoot)'"
           Text="Prepared Copilot payload inputs are restricted to the canonical Install.Tests prerequisite cache." />
    <Error Condition="'$(PreparedCopilotPayloadFingerprint)' == '' Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(PreparedCopilotPayloadFingerprint)', '^[0-9a-f]{64}$'))"
           Text="The prepared Copilot payload fingerprint must be a lowercase SHA-256 value." />
    <Error Condition="'$(_PreparedCopilotPayloadCacheName)' == '' Or '$(_PreparedCopilotPayloadCacheName)' != '$(_PreparedCopilotPayloadFingerprintPrefix)'"
           Text="The prepared Copilot payload cache directory does not match its fingerprint." />
    <Error Condition="!Exists('$(_PreparedCopilotPayloadFingerprintFile)')"
           Text="The prepared Copilot payload fingerprint file does not exist at '$(_PreparedCopilotPayloadFingerprintFile)'." />
    <Error Condition="!Exists('$(_PreparedCopilotPayloadManifestFile)')"
           Text="The prepared Copilot payload manifest does not exist at '$(_PreparedCopilotPayloadManifestFile)'." />
    <ReadLinesFromFile File="$(_PreparedCopilotPayloadFingerprintFile)"
                       Condition="Exists('$(_PreparedCopilotPayloadFingerprintFile)')">
      <Output TaskParameter="Lines" PropertyName="_PreparedCopilotPayloadActualFingerprint" />
    </ReadLinesFromFile>
    <Error Condition="'$(PreparedCopilotPayloadFingerprint)' == '' Or '$(_PreparedCopilotPayloadActualFingerprint)' != '$(PreparedCopilotPayloadFingerprint)'"
           Text="The prepared Copilot payload fingerprint does not match its provenance file." />
    <ItemGroup>
      <_PreparedCopilotPayloadArtifact Include="$(_PreparedCopilotPayloadManifestFile)">
        <ExpectedSha256>$(PreparedCopilotPayloadManifestSha256)</ExpectedSha256>
        <ArtifactName>prerequisite.json</ArtifactName>
      </_PreparedCopilotPayloadArtifact>
      <_PreparedCopilotPayloadArtifact Include="$(_PreparedCopilotPayloadCanonicalDirectory)\phantom-copilot-wrapper.exe">
        <ExpectedSha256>$(PreparedCopilotWrapperSha256)</ExpectedSha256>
        <ArtifactName>phantom-copilot-wrapper.exe</ArtifactName>
      </_PreparedCopilotPayloadArtifact>
      <_PreparedCopilotPayloadArtifact Include="$(_PreparedCopilotPayloadCanonicalDirectory)\copilot.exe">
        <ExpectedSha256>$(PreparedCopilotCliSha256)</ExpectedSha256>
        <ArtifactName>copilot.exe</ArtifactName>
      </_PreparedCopilotPayloadArtifact>
      <_PreparedCopilotPayloadArtifact Include="$(_PreparedCopilotPayloadCanonicalDirectory)\copilot_runtime.dll">
        <ExpectedSha256>$(PreparedCopilotRuntimeSha256)</ExpectedSha256>
        <ArtifactName>copilot_runtime.dll</ArtifactName>
      </_PreparedCopilotPayloadArtifact>
      <_PreparedCopilotPayloadArtifact Include="$(_PreparedCopilotPayloadCanonicalDirectory)\LICENSE.md">
        <ExpectedSha256>$(PreparedCopilotLicenseSha256)</ExpectedSha256>
        <ArtifactName>LICENSE.md</ArtifactName>
      </_PreparedCopilotPayloadArtifact>
      <_PreparedCopilotPayloadArtifact Include="$(_PreparedCopilotPayloadCanonicalDirectory)\mxc_ffi.dll">
        <ExpectedSha256>$(PreparedMxcFfiSha256)</ExpectedSha256>
        <ArtifactName>mxc_ffi.dll</ArtifactName>
      </_PreparedCopilotPayloadArtifact>
      <_PreparedCopilotPayloadArtifact Include="$(_PreparedCopilotPayloadCanonicalDirectory)\plm.exe">
        <ExpectedSha256>$(PreparedPlmSha256)</ExpectedSha256>
        <ArtifactName>plm.exe</ArtifactName>
      </_PreparedCopilotPayloadArtifact>
      <_PreparedCopilotPayloadArtifact Include="$(_PreparedCopilotPayloadCanonicalDirectory)\MXC-LICENSE.md">
        <ExpectedSha256>$(PreparedMxcLicenseSha256)</ExpectedSha256>
        <ArtifactName>MXC-LICENSE.md</ArtifactName>
      </_PreparedCopilotPayloadArtifact>
    </ItemGroup>
    <Error Condition="'%(_PreparedCopilotPayloadArtifact.ExpectedSha256)' == '' Or !$([System.Text.RegularExpressions.Regex]::IsMatch('%(_PreparedCopilotPayloadArtifact.ExpectedSha256)', '^[0-9a-f]{64}$'))"
           Text="The expected SHA-256 for prepared artifact '%(_PreparedCopilotPayloadArtifact.ArtifactName)' is missing or invalid." />
    <Error Condition="!Exists('%(_PreparedCopilotPayloadArtifact.Identity)')"
           Text="Prepared Copilot payload artifact '%(_PreparedCopilotPayloadArtifact.ArtifactName)' does not exist at '%(_PreparedCopilotPayloadArtifact.Identity)'." />
    <GetFileHash Files="@(_PreparedCopilotPayloadArtifact)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_PreparedCopilotPayloadHashedArtifact" />
    </GetFileHash>
    <Error Condition="'%(_PreparedCopilotPayloadHashedArtifact.FileHash)' != '%(_PreparedCopilotPayloadHashedArtifact.ExpectedSha256)'"
           Text="Prepared Copilot payload artifact '%(_PreparedCopilotPayloadHashedArtifact.ArtifactName)' does not match its provenance hash." />
  </Target>
  <UsingTask TaskName="ResolveCopilotWrapperPublishDirectory"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ProjectDirectory ParameterType="System.String" Required="true" />
      <IntermediateDirectory ParameterType="System.String" Required="true" />
      <Configuration ParameterType="System.String" Required="true" />
      <RuntimeIdentifier ParameterType="System.String" Required="true" />
      <PublishDirectory ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        static void RejectReparsePoints(string path)
        {
            var root = Path.GetPathRoot(path)
                ?? throw new InvalidOperationException($"Path '{path}' has no filesystem root.");
            var relative = path.Substring(root.Length);
            var current = root;
            foreach (var component in relative.Split(
                new[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar },
                StringSplitOptions.RemoveEmptyEntries))
            {
                current = Path.Combine(current, component);
                if ((Directory.Exists(current) || File.Exists(current))
                    && (File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
                {
                    throw new InvalidOperationException(
                        $"Copilot wrapper publish directory cannot traverse reparse point '{current}'.");
                }
            }
        }

        static string SafeSegment(string value)
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                throw new InvalidOperationException(
                    "Configuration and RuntimeIdentifier must be non-empty.");
            }

            var chars = value.Select(character =>
                    char.IsLetterOrDigit(character) || character == '-' || character == '_'
                        ? character
                        : '_')
                .ToArray();
            var segment = new string(chars);
            return segment.Substring(0, Math.Min(segment.Length, 8));
        }

        var projectRoot = Path.GetFullPath(ProjectDirectory);
        if (!Path.IsPathRooted(projectRoot))
        {
            throw new InvalidOperationException(
                $"MSBuildProjectDirectory must be fully qualified: '{ProjectDirectory}'.");
        }

        var intermediateRoot = Path.GetFullPath(
            Path.IsPathRooted(IntermediateDirectory)
                ? IntermediateDirectory
                : Path.Combine(projectRoot, IntermediateDirectory));
        RejectReparsePoints(intermediateRoot);

        var invocation = Guid.NewGuid().ToString("N").Substring(0, 16);
        var candidate = Path.GetFullPath(Path.Combine(
            intermediateRoot,
            "cw",
            SafeSegment(Configuration),
            SafeSegment(RuntimeIdentifier),
            invocation));
        var intermediatePrefix = intermediateRoot.TrimEnd(
            Path.DirectorySeparatorChar,
            Path.AltDirectorySeparatorChar) + Path.DirectorySeparatorChar;
        if (!candidate.StartsWith(intermediatePrefix, StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException(
                $"Copilot wrapper publish directory escaped its parent intermediate root: '{candidate}'.");
        }

        Directory.CreateDirectory(candidate);
        RejectReparsePoints(candidate);
        PublishDirectory = candidate.TrimEnd(
                Path.DirectorySeparatorChar,
                Path.AltDirectorySeparatorChar)
            + Path.DirectorySeparatorChar;
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="ResolveCopilotWrapperPublishPath"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' And '$(PublishCopilotRuntime)' != 'false' And '$(SkipCopilotWrapperPublish)' != 'true'">
    <PropertyGroup>
      <_CopilotWrapperIntermediateRoot Condition="'$(CopilotWrapperPublishIntermediateRoot)' != ''">$(CopilotWrapperPublishIntermediateRoot)</_CopilotWrapperIntermediateRoot>
      <_CopilotWrapperIntermediateRoot Condition="'$(_CopilotWrapperIntermediateRoot)' == ''">$(IntermediateOutputPath)</_CopilotWrapperIntermediateRoot>
    </PropertyGroup>
    <ResolveCopilotWrapperPublishDirectory
        ProjectDirectory="$(MSBuildProjectDirectory)"
        IntermediateDirectory="$(_CopilotWrapperIntermediateRoot)"
        Configuration="$(Configuration)"
        RuntimeIdentifier="$(RuntimeIdentifier)">
      <Output TaskParameter="PublishDirectory"
              PropertyName="_CopilotWrapperPublishDir" />
    </ResolveCopilotWrapperPublishDirectory>
    <PropertyGroup>
      <_CopilotWrapperExecutable>$(_CopilotWrapperPublishDir)phantom-copilot-wrapper.exe</_CopilotWrapperExecutable>
    </PropertyGroup>
    <Message Importance="high"
             Text="Copilot wrapper child PublishDir: $(_CopilotWrapperPublishDir)" />
  </Target>
  <Target Name="PublishCopilotWrapperLoose"
          DependsOnTargets="ValidatePreparedCopilotPayload;ResolveCopilotWrapperPublishPath"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' And '$(PublishCopilotRuntime)' != 'false' And '$(SkipCopilotWrapperPublish)' != 'true'">
    <PropertyGroup>
      <_CopilotWrapperProject>$(MSBuildProjectDirectory)\..\Phantom.Workspaces.Copilot.Cli.Wrapper\Phantom.Workspaces.Copilot.Cli.Wrapper.csproj</_CopilotWrapperProject>
      <_CopilotWrapperSource Condition="'$(UsePreparedCopilotPayloadForTests)' == 'true'">$(PreparedCopilotPayloadDirectory)\phantom-copilot-wrapper.exe</_CopilotWrapperSource>
    </PropertyGroup>
    <Error Condition="'$(UsePreparedCopilotPayloadForTests)' == 'true' And !Exists('$(_CopilotWrapperSource)')"
           Text="The prepared Copilot wrapper does not exist at '$(_CopilotWrapperSource)'." />
    <MSBuild Projects="$(_CopilotWrapperProject)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishSingleFile=true;PublishReadyToRun=false;PublishTrimmed=false;IncludeNativeLibrariesForSelfExtract=true;PublishDir=$([MSBuild]::Escape('$(_CopilotWrapperPublishDir)'));CopilotWrapperParentPublishDirectory=$([MSBuild]::Escape('$(_CopilotWrapperPublishDir)'))"
             Condition="'$(UsePreparedCopilotPayloadForTests)' != 'true'" />
    <MakeDir Directories="$(_CopilotWrapperPublishDir)"
             Condition="'$(UsePreparedCopilotPayloadForTests)' == 'true'" />
    <Copy SourceFiles="$(_CopilotWrapperSource)"
          DestinationFiles="$(_CopilotWrapperExecutable)"
          SkipUnchangedFiles="true"
          Condition="'$(UsePreparedCopilotPayloadForTests)' == 'true'" />
    <Delete Files="$(_CopilotWrapperExecutable)"
            Condition="'$(UsePreparedCopilotPayloadForTests)' == 'true' And '$(SimulateMissingCopilotWrapperChildOutputForTests)' == 'true'" />
    <Error Condition="!Exists('$(_CopilotWrapperExecutable)')"
           Text="The Copilot MXC wrapper was not published at '$(_CopilotWrapperExecutable)'." />
    <Copy SourceFiles="$(_CopilotWrapperExecutable)"
          DestinationFolder="$(PublishDir)runtimes\$(RuntimeIdentifier)\native"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishMxcRuntimeLoose"
          AfterTargets="Publish"
          DependsOnTargets="ValidatePreparedCopilotPayload"
          Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_MxcNativeDirectory>$(PublishDir)runtimes\$(RuntimeIdentifier)\native</_MxcNativeDirectory>
      <_MxcRuntimeSourceDirectory Condition="'$(UsePreparedCopilotPayloadForTests)' == 'true'">$(PreparedCopilotPayloadDirectory)</_MxcRuntimeSourceDirectory>
      <_MxcRuntimeSourceDirectory Condition="'$(_MxcRuntimeSourceDirectory)' == ''">$(OutDir)</_MxcRuntimeSourceDirectory>
      <_MxcLicenseSource Condition="'$(UsePreparedCopilotPayloadForTests)' == 'true'">$(PreparedCopilotPayloadDirectory)\MXC-LICENSE.md</_MxcLicenseSource>
      <_MxcLicenseSource Condition="'$(_MxcLicenseSource)' == ''">$(MSBuildProjectDirectory)\..\microsoft\mxc\LICENSE.md</_MxcLicenseSource>
    </PropertyGroup>
    <ItemGroup>
      <_MxcRuntimeToPublish Include="$(_MxcRuntimeSourceDirectory)\mxc_ffi.dll" />
      <_MxcRuntimeToPublish Include="$(_MxcRuntimeSourceDirectory)\plm.exe" />
    </ItemGroup>
    <Error Condition="'$(RuntimeIdentifier)' != 'win-x64'"
           Text="Microsoft MXC release payloads currently support only win-x64." />
    <Error Condition="!Exists('$(_MxcRuntimeSourceDirectory)\mxc_ffi.dll')"
           Text="MXC native library not found at '$(_MxcRuntimeSourceDirectory)\mxc_ffi.dll'." />
    <Error Condition="!Exists('$(_MxcRuntimeSourceDirectory)\plm.exe')"
           Text="MXC policy launcher not found at '$(_MxcRuntimeSourceDirectory)\plm.exe'; the native unit must remain complete." />
    <Copy SourceFiles="@(_MxcRuntimeToPublish)"
          DestinationFolder="$(_MxcNativeDirectory)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_MxcLicenseSource)"
          DestinationFiles="$(_MxcNativeDirectory)\MXC-LICENSE.md"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(_MxcNativeDirectory)\mxc_ffi.dll') Or !Exists('$(_MxcNativeDirectory)\plm.exe') Or !Exists('$(_MxcNativeDirectory)\MXC-LICENSE.md')"
           Text="The complete MXC native unit and MIT license were not published to '$(_MxcNativeDirectory)'." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />

    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Referenced unconditionally so restore is configuration-independent and the
         #if DEBUG WithDeveloperTools() call always resolves during no-restore parallel
         test builds. Conditioning asset metadata on $(Configuration) made restore output
         config-dependent and intermittently dropped the compile assets, silently skipping
         a test assembly (see #1050). The call is still #if DEBUG, so DevTools never
         attaches in Release. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Model.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Dock.Serializer.SystemTextJson" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="Microsoft.DevTunnels.Connections" />
    <PackageReference Include="Microsoft.DevTunnels.Contracts" />
    <PackageReference Include="Microsoft.DevTunnels.Management" />
    <PackageReference Include="Meziantou.Framework.Win32.CredentialManager" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Phantom.Dock.Avalonia.TabSwitching\Phantom.Dock.Avalonia.TabSwitching\Phantom.Dock.Avalonia.TabSwitching.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Agent.Gui\Phantom.Workspaces.Agent.Gui.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Data.Core\Phantom.Workspaces.Data.Core.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Data.MongoDB\Phantom.Workspaces.Data.MongoDB.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Data.Offline\Phantom.Workspaces.Data.Offline.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Data.Web.Client\Phantom.Workspaces.Data.Web.Client.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Data.Web.Server\Phantom.Workspaces.Data.Web.Server.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Gui.Shared\Phantom.Workspaces.Gui.Shared.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Install\Phantom.Workspaces.Install.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Logging\Phantom.Workspaces.Logging.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Web.Server\Phantom.Workspaces.Web.Server.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Copilot.Cli.Wrapper\Phantom.Workspaces.Copilot.Cli.Wrapper.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Tools\*.cs" />
    <Compile Include="Tools\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Phantom.Workspaces.Tests" />
    <InternalsVisibleTo Include="Phantom.Workspaces.Tools.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
