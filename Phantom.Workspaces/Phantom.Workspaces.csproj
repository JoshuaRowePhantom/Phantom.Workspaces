<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ActiveDebugProfile>Phantom.Workspaces.MongoDb</ActiveDebugProfile>
    <!-- Per-RID self-contained single-file publish targets (no AnyCPU single file). -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <!-- Publish-only settings: active only when a RuntimeIdentifier is specified (i.e. during
       `dotnet publish -r <rid>`), so normal `dotnet build`/F5 debugging is unaffected. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- The GUI references other (non-self-contained) executable projects; the self-contained
         single-file bundle pulls in their assemblies, so bypass the SDK's matching check. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <!-- Referenced executable projects emit their own apphost/deps.json under both the RID and
         non-RID paths; the GUI is the only entry point we ship, so tolerate the duplicates. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
  <!-- When the GUI is built non-RID (e.g. by `dotnet build`/`dotnet test`) and then published for
       a RID, each referenced executable project leaves both a non-RID and a RID `apphost.exe` that
       map to the same bundle entry (e.g. Phantom.Workspaces.Containers.exe), crashing the
       single-file bundler. Drop the non-RID copies, keeping the RID-specific one. -->
  <Target Name="RemoveDuplicateReferencedAppHosts"
          AfterTargets="_ComputeFilesToBundle"
          Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_FilesToBundle Remove="@(_FilesToBundle)"
          Condition="'%(_FilesToBundle.Filename)%(_FilesToBundle.Extension)' == 'apphost.exe' and !$([System.String]::Copy('%(_FilesToBundle.Identity)').Contains('\$(RuntimeIdentifier)\'))" />
    </ItemGroup>
  </Target>
  <!-- Issue #1376: GitHub.Copilot.SDK resolves its CLI strictly from
       AppContext.BaseDirectory\runtimes\<rid>\native\copilot.exe and does NOT search PATH. The SDK
       registers copilot.exe / copilot_runtime.dll / LICENSE.md as Content (not native libraries).
       PublishSingleFile drops that transitive content from the publish output entirely (verified:
       no runtimes\ tree appears in the single-file publish), so the installed payload has no
       copilot.exe and the provider fails with "Copilot runtime not found". The regular build
       output ($(OutDir)) DOES contain runtimes\<rid>\native\{copilot.exe,copilot_runtime.dll,
       LICENSE.md} (the SDK copies them there and the LICENSE is added by Llm.Core). Copy them into
       the publish output as LOOSE files beside the single-file exe (BaseDirectory), where the SDK's
       default lookup finds them, and ship the CLI LICENSE.md unmodified as required by the GitHub
       Copilot CLI License. -->
  <Target Name="PublishCopilotRuntimeLoose"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_CopilotRuntimeToPublish Include="$(OutDir)runtimes\$(RuntimeIdentifier)\native\copilot.exe" />
      <_CopilotRuntimeToPublish Include="$(OutDir)runtimes\$(RuntimeIdentifier)\native\copilot_runtime.dll"
                                Condition="Exists('$(OutDir)runtimes\$(RuntimeIdentifier)\native\copilot_runtime.dll')" />
      <_CopilotRuntimeToPublish Include="$(OutDir)runtimes\$(RuntimeIdentifier)\native\LICENSE.md" />
    </ItemGroup>
    <Error Condition="!Exists('$(OutDir)runtimes\$(RuntimeIdentifier)\native\copilot.exe')"
           Text="Copilot CLI not found in build output at '$(OutDir)runtimes\$(RuntimeIdentifier)\native\copilot.exe'; cannot bundle it into the publish payload (issue #1376)." />
    <Error Condition="!Exists('$(OutDir)runtimes\$(RuntimeIdentifier)\native\LICENSE.md')"
           Text="GitHub Copilot CLI LICENSE.md not found in build output at '$(OutDir)runtimes\$(RuntimeIdentifier)\native\LICENSE.md'; the redistributed CLI must ship its license (issue #1376)." />
    <Copy SourceFiles="@(_CopilotRuntimeToPublish)"
          DestinationFolder="$(PublishDir)runtimes\$(RuntimeIdentifier)\native"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)runtimes\$(RuntimeIdentifier)\native\copilot.exe')"
           Text="Copilot CLI (runtimes\$(RuntimeIdentifier)\native\copilot.exe) was not published as a loose file (issue #1376)." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />

    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Referenced unconditionally so restore is configuration-independent and the
         #if DEBUG WithDeveloperTools() call always resolves during no-restore parallel
         test builds. Conditioning asset metadata on $(Configuration) made restore output
         config-dependent and intermittently dropped the compile assets, silently skipping
         a test assembly (see #1050). The call is still #if DEBUG, so DevTools never
         attaches in Release. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Model.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Dock.Serializer.SystemTextJson" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="Microsoft.DevTunnels.Connections" />
    <PackageReference Include="Microsoft.DevTunnels.Contracts" />
    <PackageReference Include="Microsoft.DevTunnels.Management" />
    <PackageReference Include="Meziantou.Framework.Win32.CredentialManager" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Phantom.Dock.Avalonia.TabSwitching\Phantom.Dock.Avalonia.TabSwitching\Phantom.Dock.Avalonia.TabSwitching.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Agent.Gui\Phantom.Workspaces.Agent.Gui.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Data.Core\Phantom.Workspaces.Data.Core.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Data.MongoDB\Phantom.Workspaces.Data.MongoDB.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Data.Offline\Phantom.Workspaces.Data.Offline.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Data.Web.Client\Phantom.Workspaces.Data.Web.Client.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Data.Web.Server\Phantom.Workspaces.Data.Web.Server.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Gui.Shared\Phantom.Workspaces.Gui.Shared.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Install\Phantom.Workspaces.Install.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Logging\Phantom.Workspaces.Logging.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Web.Server\Phantom.Workspaces.Web.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Tools\*.cs" />
    <Compile Include="Tools\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Phantom.Workspaces.Tests" />
    <InternalsVisibleTo Include="Phantom.Workspaces.Tools.Tests" />
  </ItemGroup>
</Project>
