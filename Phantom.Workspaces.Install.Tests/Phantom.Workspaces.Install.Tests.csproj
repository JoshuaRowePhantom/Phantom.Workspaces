<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Phantom.Workspaces.Install.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Phantom.Workspaces.Install\Phantom.Workspaces.Install.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Testing\Phantom.Workspaces.Testing.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Test.WindowsProcessProbe\Phantom.Workspaces.Test.WindowsProcessProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyWindowsProcessProbe" AfterTargets="Build">
    <ItemGroup>
      <WindowsProcessProbeFiles Include="..\Phantom.Workspaces.Test.WindowsProcessProbe\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WindowsProcessProbeFiles)"
          DestinationFiles="@(WindowsProcessProbeFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PrepareCopilotWrapperTestPrerequisite"
          BeforeTargets="VSTest"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_CopilotWrapperPrerequisiteCache>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)mxcw</_CopilotWrapperPrerequisiteCache>
      <_CopilotWrapperPrerequisitePathFile>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)copilot-wrapper-prerequisite.path</_CopilotWrapperPrerequisitePathFile>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\scripts\prepare-copilot-wrapper-test-prerequisite.ps1&quot; -RepositoryRoot &quot;$(MSBuildProjectDirectory)\..&quot; -CacheRoot &quot;$(_CopilotWrapperPrerequisiteCache)&quot; -PathOutputFile &quot;$(_CopilotWrapperPrerequisitePathFile)&quot;"
          StandardOutputImportance="high"
          StandardErrorImportance="high" />
    <Error Condition="!Exists('$(_CopilotWrapperPrerequisitePathFile)')"
           Text="The Copilot wrapper prerequisite path was not produced before VSTest started." />
    <Copy SourceFiles="$(_CopilotWrapperPrerequisitePathFile)"
          DestinationFiles="$(OutDir)copilot-wrapper-prerequisite.path"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
