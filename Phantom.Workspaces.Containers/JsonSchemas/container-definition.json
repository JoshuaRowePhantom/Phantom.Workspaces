{
  "$id": "https://schemas.workspaces.phantom.to/containers/container-definition.json",
  "type": "object",
  "properties": {
    "container-name": {
      "type": "string",
      "minLength": 1
    },
    "image-name": {
      "type": "string",
      "minLength": 1
    },
    "hostname": {
      "type": "string"
    },
    "network-type": {
      "type": "string",
      "enum": [
        "bridge",
        "host",
        "none",
        "container"
      ]
    },
    "environment-variables": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "read-only": {
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "target",
          "read-only"
        ],
        "additionalProperties": false
      }
    },
    "port-mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source-port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "target-port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "required": [
          "source-port",
          "target-port"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "container-name",
    "image-name",
    "network-type",
    "environment-variables",
    "mounts"
  ],
  "additionalProperties": false
}
