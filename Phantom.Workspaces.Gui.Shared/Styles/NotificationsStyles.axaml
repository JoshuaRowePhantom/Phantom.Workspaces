<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:CompileBindings="False">
    <Styles.Resources>
        <!-- Notifications panel resources - no longer alias, reference directly -->
        <CornerRadius x:Key="Theme.Notifications.Panel.CornerRadius">6</CornerRadius>
        <BoxShadows x:Key="Theme.Notifications.Panel.BoxShadow">0 4 16 0 #B0000000</BoxShadows>
        
        <!-- Notifications badge (unread count) -->
        <SolidColorBrush x:Key="Theme.Notifications.Badge.Foreground">Gold</SolidColorBrush>

        <!-- Navigation highlight (F7/F8 keyboard navigation) -->
        <SolidColorBrush x:Key="Theme.Notifications.Row.HighlightBackground">#285EA0FF</SolidColorBrush>
    </Styles.Resources>

    <Style Selector="Border.notifications-panel">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.Popup.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.Popup.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Theme.Notifications.Panel.CornerRadius}" />
        <Setter Property="BoxShadow" Value="{DynamicResource Theme.Notifications.Panel.BoxShadow}" />
    </Style>

    <Style Selector="Border.interactive-row.highlighted">
        <Setter Property="Background" Value="{DynamicResource Theme.Notifications.Row.HighlightBackground}" />
    </Style>

    <Style Selector="TextBlock.notification-unread-indicator">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Notifications.Badge.Foreground}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- exclamation-indicator: renders "!" glyph in gold for unread notifications.
         Opacity 0 when idle (IsIndeterminate=false); opacity 1 when active (IsIndeterminate=true). -->
    <Style Selector="ProgressBar.glyph-indicator.exclamation-indicator">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Notifications.Badge.Foreground}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_Indicator" IsVisible="False" />
                    <TextBlock x:Name="Glyph" Text="!" FontSize="14" FontWeight="Bold" Opacity="0"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ProgressBar.glyph-indicator.exclamation-indicator:indeterminate /template/ TextBlock#Glyph">
        <Setter Property="Opacity" Value="1.0" />
    </Style>
</Styles>
