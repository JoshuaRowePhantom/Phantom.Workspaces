<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:CompileBindings="False">
    <Styles.Resources>
        <CornerRadius x:Key="Theme.SlashCompletions.Popup.CornerRadius">6</CornerRadius>
        <BoxShadows x:Key="Theme.SlashCompletions.Popup.BoxShadow">0 -4 16 0 #B0000000</BoxShadows>
        <SolidColorBrush x:Key="Theme.SlashCompletions.Item.SelectedBackground">#40569CD6</SolidColorBrush>
    </Styles.Resources>

    <Style Selector="Border.slash-completions-popup">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.Popup.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.Popup.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Theme.SlashCompletions.Popup.CornerRadius}" />
        <Setter Property="BoxShadow" Value="{DynamicResource Theme.SlashCompletions.Popup.BoxShadow}" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="Border.slash-completion-item">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Border.slash-completion-item.selected">
        <Setter Property="Background" Value="{DynamicResource Theme.SlashCompletions.Item.SelectedBackground}" />
    </Style>
</Styles>
