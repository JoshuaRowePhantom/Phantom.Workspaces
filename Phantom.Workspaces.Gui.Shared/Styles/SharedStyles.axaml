<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Phantom.Workspaces.Gui.Shared.Controls"
        x:CompileBindings="False">
    <!-- Free, MIT-licensed Markdown.Avalonia renderer theme + syntax-highlight appendix used by
         WorkspaceMarkdownView. Kept here (not App.axaml) so the Markdown.Avalonia assemblies stay
         referenced only by this shared assembly, keeping their root 'Markdown' namespace out of the
         application's global namespace. -->
    <StyleInclude Source="avares://Markdown.Avalonia/StyleCollections/MarkdownStyleFluentTheme.axaml" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://Markdown.Avalonia.SyntaxHigh/StyleCollections/AppendixOfFluentTheme.axaml" />
    <Styles.Resources>
        <!-- Default theme fallbacks for apps that do not inject profile resources. -->
        <FontFamily x:Key="Theme.FontFamily">Inter</FontFamily>
        <x:Double x:Key="Theme.FontSize.Base">13</x:Double>

        <!-- Text class sizing/weight resources (variant-agnostic) -->
        <x:Double x:Key="Theme.Class.normal.Opacity">1</x:Double>
        <x:Double x:Key="Theme.Class.normal.FontSize">13</x:Double>
        <FontWeight x:Key="Theme.Class.normal.FontWeight">Normal</FontWeight>

        <x:Double x:Key="Theme.Class.heading.Opacity">1</x:Double>
        <x:Double x:Key="Theme.Class.heading.FontSize">16</x:Double>
        <FontWeight x:Key="Theme.Class.heading.FontWeight">Bold</FontWeight>

        <x:Double x:Key="Theme.Class.section-title.Opacity">1</x:Double>
        <x:Double x:Key="Theme.Class.section-title.FontSize">14</x:Double>
        <FontWeight x:Key="Theme.Class.section-title.FontWeight">Bold</FontWeight>

        <x:Double x:Key="Theme.Class.caption.Opacity">1</x:Double>
        <x:Double x:Key="Theme.Class.caption.FontSize">11</x:Double>
        <FontWeight x:Key="Theme.Class.caption.FontWeight">Normal</FontWeight>

        <x:Double x:Key="Theme.Class.muted.Opacity">1</x:Double>
        <x:Double x:Key="Theme.Class.muted.FontSize">13</x:Double>
        <FontWeight x:Key="Theme.Class.muted.FontWeight">Normal</FontWeight>

        <x:Double x:Key="Theme.Class.accent.Opacity">1</x:Double>
        <x:Double x:Key="Theme.Class.accent.FontSize">13</x:Double>
        <FontWeight x:Key="Theme.Class.accent.FontWeight">Normal</FontWeight>
    </Styles.Resources>
    <Style Selector="TextBox.copyable-text">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="InnerLeftContent">
            <Template>
                <Button Classes="copyable-text-button"
                        Focusable="False" />
            </Template>
        </Setter>
    </Style>
    <Style Selector="TextBlock.heading">
        <Setter Property="FontWeight" Value="{DynamicResource Theme.Class.heading.FontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.heading.Foreground}" />
        <Setter Property="Opacity" Value="{DynamicResource Theme.Class.heading.Opacity}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.heading.FontSize}" />
    </Style>
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontWeight" Value="{DynamicResource Theme.Class.section-title.FontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.section-title.Foreground}" />
        <Setter Property="Opacity" Value="{DynamicResource Theme.Class.section-title.Opacity}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.section-title.FontSize}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontWeight" Value="{DynamicResource Theme.Class.caption.FontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.caption.Foreground}" />
        <Setter Property="Opacity" Value="{DynamicResource Theme.Class.caption.Opacity}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.caption.FontSize}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="FontWeight" Value="{DynamicResource Theme.Class.muted.FontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.muted.Foreground}" />
        <Setter Property="Opacity" Value="{DynamicResource Theme.Class.muted.Opacity}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.muted.FontSize}" />
    </Style>
    <Style Selector="TextBlock.accent">
        <Setter Property="FontWeight" Value="{DynamicResource Theme.Class.accent.FontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.accent.Foreground}" />
        <Setter Property="Opacity" Value="{DynamicResource Theme.Class.accent.Opacity}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.accent.FontSize}" />
    </Style>

    <Style Selector="Grid.entity-pane">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityPane.Background}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Grid.entity-pane:pointerover">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityPane.HoverBackground}" />
    </Style>
    <Style Selector="Border.entity-card">
        <Setter Property="Padding" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.Border}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.entity-card:pointerover">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.HoverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.ActiveBorder}" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="Border.entity-card.selected">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.SelectedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.SelectedBorder}" />
    </Style>
    <Style Selector="Border.entity-card.selected:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.SelectedBorder}" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="StackPanel.entity-card-tree-item">
        <Setter Property="Spacing" Value="4" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="StackPanel.entity-card-tree-item.detail">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.entity-card.branch-header">
        <Setter Property="CornerRadius" Value="6,6,0,0" />
    </Style>
    <Style Selector="Border.entity-card.leaf">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="StackPanel.sticky-pinned > Border.entity-card">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.HoverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.ActiveBorder}" />
        <Setter Property="Opacity" Value="0.92" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.entity-card-expand-section">
        <Setter Property="Margin" Value="0,-4,0,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.Border}" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.entity-card-expand-section.branch-footer">
        <Setter Property="CornerRadius" Value="0,0,6,6" />
    </Style>
    <Style Selector="Border.entity-card-expand-section:pointerover">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.HoverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.HoverBorder}" />
    </Style>
    <Style Selector="Border.interactive-row">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.interactive-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.HoverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.HoverBorder}" />
    </Style>

    <Style Selector="Button.entity-card-expand-button">
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.workspace-save-button">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="4,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TreeView.entity-card-tree.entity-card-tree-entity Border.entity-card-tree-type-bar">
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <!-- Issue #1029: reusable entity-card border/header shell. Applied by the entity-card
         TreeViewItem template and by a standalone ContentControl so entity-like content is
         presented identically everywhere. Border/footer thickness reuses the same resource the
         agent-chat input TextBox resolves to (TextControlBorderThemeThickness) so hover/selection
         recolouring never reflows. -->
    <Style Selector="ContentControl.entity-card-shell">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel HorizontalAlignment="Stretch">
                    <Border Classes="entity-card-shell-border"
                            Classes.has-children="{Binding HasChildren, FallbackValue=False}"
                            ClipToBounds="True"
                            HorizontalAlignment="Stretch">
                        <ContentPresenter Classes="branch-header"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Top"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                    <Button Classes="entity-card-shell-footer"
                            IsVisible="{Binding HasChildren, FallbackValue=False}"
                            Content="{Binding ExpandArrow, FallbackValue=▼}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding ToggleExpandCommand}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Border.entity-card-shell-border">
        <Setter Property="Padding" Value="10" />
        <Setter Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThickness}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.ItemPanelBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.Border}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.entity-card-shell-border.has-children">
        <Setter Property="CornerRadius" Value="6,6,0,0" />
    </Style>
    <Style Selector="Button.entity-card-shell-footer">
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,-1,0,0" />
        <Setter Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThickness}" />
        <Setter Property="CornerRadius" Value="0,0,6,6" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.ItemPanelBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.Border}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Issue #1029: shared entity-card TreeViewItem template built on the reusable shell.
         Applies to both the legacy `entity-card-tree` class and the named `entity-card-tree-view`
         style so every entity tree gets the same chrome while EntityCardControl stays content-only. -->
    <Style Selector="TreeView.entity-card-tree TreeViewItem, TreeView.entity-card-tree-view TreeViewItem">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*"
                      ColumnDefinitions="20,*"
                      HorizontalAlignment="Stretch">
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                Classes="entity-card-tree-item"
                                Classes.selected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                HorizontalAlignment="Stretch">
                        <ContentControl Classes="entity-card-shell"
                                        HorizontalAlignment="Stretch"
                                        Content="{TemplateBinding Header}"
                                        ContentTemplate="{TemplateBinding HeaderTemplate}" />
                    </StackPanel>
                    <Border Grid.Column="0" Grid.Row="1"
                            Classes="entity-card-child-rail"
                            Background="{Binding ChildRailBrush, FallbackValue=#808080}"
                            Width="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch" />
                    <ItemsPresenter Grid.Column="1" Grid.Row="1"
                                    IsVisible="{Binding IsExpanded}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- Issue #1064: any legacy `entity-card-tree` respects the card's hard minimum widths AND
         stays reachable, mirroring the #1049 `entity-card-tree-view` wrapper. H=Auto keeps a
         horizontal scrollbar available; a single items-region wrapper caps content to the inner
         scroller's viewport (so it wraps and never overflows when wide) but floors at MinWidth=160
         (so a horizontal scrollbar appears and the minimum-width card is scrollable when the
         viewport is narrower than the minimum). The tree's own inner scroller supplies vertical
         scrolling; no surrounding ScrollViewer is required. -->
    <Style Selector="TreeView.entity-card-tree">
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Stretch"
                            MinWidth="160"
                            MaxWidth="{Binding $parent[ScrollViewer].Viewport.Width}" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="TreeView.entity-card-tree-view">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityPane.Background}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Stretch"
                            MinWidth="160"
                            MaxWidth="{Binding $parent[ScrollViewer].Viewport.Width}" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <!-- Issue #1048: scope hover/selection highlights to the item's own header StackPanel so
         ancestor/descendant chains are not highlighted. The StackPanel.entity-card-tree-item sits
         in grid row 0 and does NOT contain the row-1 ItemsPresenter, so its :pointerover is true
         only for this item's header/footer — never for child items or ancestor propagation. -->
    <Style Selector="TreeView.entity-card-tree StackPanel.entity-card-tree-item:pointerover Border.entity-card-shell-border">
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.ActiveBorder}" />
    </Style>
    <Style Selector="TreeView.entity-card-tree StackPanel.entity-card-tree-item:pointerover Button.entity-card-shell-footer">
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.ActiveBorder}" />
    </Style>
    <Style Selector="TreeView.entity-card-tree-view StackPanel.entity-card-tree-item:pointerover Border.entity-card-shell-border">
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.ActiveBorder}" />
    </Style>
    <Style Selector="TreeView.entity-card-tree-view StackPanel.entity-card-tree-item:pointerover Button.entity-card-shell-footer">
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.ActiveBorder}" />
    </Style>
    <Style Selector="TreeView.entity-card-tree StackPanel.entity-card-tree-item.selected Border.entity-card-shell-border">
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.SelectedBorder}" />
    </Style>
    <Style Selector="TreeView.entity-card-tree-view StackPanel.entity-card-tree-item.selected Border.entity-card-shell-border">
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.SelectedBorder}" />
    </Style>
    <Style Selector="TreeView.entity-card-tree StackPanel.entity-card-tree-item.selected Button.entity-card-shell-footer">
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.SelectedBorder}" />
    </Style>
    <Style Selector="TreeView.entity-card-tree-view StackPanel.entity-card-tree-item.selected Button.entity-card-shell-footer">
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.SelectedBorder}" />
    </Style>
    <Style Selector="TreeView.entity-card-tree.entity-card-tree-sticky ScrollViewer">
        <Setter Property="controls:StickyScroll.IsEnabled" Value="True"/>
    </Style>
    <Style Selector="TreeView.entity-card-tree.entity-card-tree-sticky StackPanel.entity-card-tree-item">
        <Setter Property="controls:TreeSticky.AutoRowLevel" Value="True"/>
    </Style>
    <Style Selector="TreeView.entity-card-tree-view.entity-card-tree-sticky ScrollViewer">
        <Setter Property="controls:StickyScroll.IsEnabled" Value="True"/>
    </Style>
    <Style Selector="TreeView.entity-card-tree-view.entity-card-tree-sticky StackPanel.entity-card-tree-item">
        <Setter Property="controls:TreeSticky.AutoRowLevel" Value="True"/>
    </Style>

    <Style Selector="Border.window-header">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ListBox.top-view-list">
        <Setter Property="Margin" Value="18,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.top-view-item">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.settings-gear">
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.pane-header">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.workspace-region-card">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TabControl.workspace-tabs">
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="TabControl.workspace-tabs TabItem">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6,6,0,0" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.Border}" />
    </Style>
    <Style Selector="TabControl.workspace-tabs TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.HoverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.HoverBorder}" />
    </Style>
    <Style Selector="TabControl.workspace-tabs TabItem:selected">
        <Setter Property="Margin" Value="0,0,2,-1" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.SelectedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.SelectedBorder}" />
    </Style>
    <Style Selector="TabControl.workspace-tabs /template/ ContentPresenter#PART_SelectedContentHost">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.Border}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.Background}" />
        <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Button.workspace-tab-close-button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.caption.FontSize}" />
    </Style>
    <Style Selector="Border.entity-badge">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,2,6,0" />
    </Style>
    <Style Selector="Border.status-badge">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.status-badge > TextBlock.status-badge-text">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Foreground}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="GridSplitter.main-splitter">
        <Setter Property="Width" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityPane.Border}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ResizeDirection" Value="Columns" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="ShowsPreview" Value="True" />
    </Style>
    <Style Selector="Grid.settings-root">
        <Setter Property="Margin" Value="16" />
    </Style>
    <Style Selector="StackPanel.settings-main">
        <Setter Property="Spacing" Value="14" />
    </Style>
    <Style Selector="StackPanel.settings-section">
        <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="StackPanel.settings-row">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="StackPanel.settings-actions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.settings-close">
        <Setter Property="MinWidth" Value="90" />
    </Style>

    <Style Selector="Button.queue-action-button">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="UserControl.queue-composer-root">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.queue-status-picker-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.queue-glyph-button">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.queue-danger-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.muted.Foreground}" />
    </Style>
    <Style Selector="Button.queue-danger-button:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Class.accent.Foreground}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.accent.Foreground}" />
    </Style>
    <Style Selector="Button.queue-item-trigger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
