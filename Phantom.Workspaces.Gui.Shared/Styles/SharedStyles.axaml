        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="ItemsControl.agent-attachments-block">
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="Border.agent-running-item">
        <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector="Button.queue-submit-button">
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="MenuItem.queue-immediacy-menu-item">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeaderTemplate">
            <DataTemplate>
                <Border Classes="queue-immediacy-pill queue-immediacy-option-pill"
                        Background="{ReflectionBinding Background}"
                        BorderBrush="{ReflectionBinding BorderBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="queue-immediacy-glyph"
                                   Foreground="{ReflectionBinding Foreground}"
                                   Text="{ReflectionBinding GlyphText}" />
                        <TextBlock Classes="queue-immediacy-label queue-immediacy-option-label"
                                   Foreground="{ReflectionBinding Foreground}"
                                   Text="{ReflectionBinding Label}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </Setter>
    </Style>
    <Style Selector="ItemsControl.queue-entry-attachments">
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="ProgressBar.agent-progress">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.accent.Foreground}" />
    </Style>

    <!-- running-indicator: glyph-based ControlTemplate status indicators.
         Idle (no modifier): hidden (opacity 0, preserves layout space).
         :indeterminate (running): ⏰ alarm clock glyph (scheduled-task context).
         .succeeded: ✅ check mark glyph.
         .failed: ❌ cross mark glyph.
         Use running-indicator-agent subclass to show 🧠 brain glyph when running (agent context).
         PART_Indicator is required by ProgressBar but hidden; the glyph TextBlock is the visual. -->
    <Style Selector="ProgressBar.running-indicator">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_Indicator" IsVisible="False" />
                    <TextBlock Text="⏰"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ProgressBar.running-indicator:indeterminate">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ProgressBar.running-indicator.succeeded">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_Indicator" IsVisible="False" />
                    <TextBlock Text="✅"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ProgressBar.running-indicator.failed">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_Indicator" IsVisible="False" />
                    <TextBlock Text="❌"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- running-indicator-agent: overrides :indeterminate template to show 🧠 brain glyph.
         Declared after running-indicator:indeterminate so it wins the Template property
         while Opacity=1 still comes from running-indicator:indeterminate. -->
    <Style Selector="ProgressBar.running-indicator-agent:indeterminate">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_Indicator" IsVisible="False" />
                    <TextBlock Text="🧠"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- glyph-indicator: shared base style for emoji glyph ProgressBars used as toolbar and tab-header
         indicators. Fixes Avalonia Fluent's unconstrained ProgressBar default sizing. -->
    <Style Selector="ProgressBar.glyph-indicator">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- pulsating-brain: 🧠 opacity 0.25 idle → sine-wave 1.0↔0.4 when :indeterminate -->
    <Style Selector="ProgressBar.glyph-indicator.pulsating-brain">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_Indicator" IsVisible="False" />
                    <TextBlock x:Name="Glyph" Text="🧠" FontSize="14" Opacity="0.25"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ProgressBar.glyph-indicator.pulsating-brain:indeterminate /template/ TextBlock#Glyph">
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- vibrating-alarm-clock: ⏰ static idle → rapid wobble when :indeterminate -->
    <Style Selector="ProgressBar.glyph-indicator.vibrating-alarm-clock">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.normal.Foreground}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_Indicator" IsVisible="False" />
                    <TextBlock x:Name="Glyph" Text="⏰" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform><RotateTransform /></TextBlock.RenderTransform>
                    </TextBlock>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ProgressBar.glyph-indicator.vibrating-alarm-clock:indeterminate /template/ TextBlock#Glyph">
        <Style.Animations>
            <Animation Duration="0:0:0.15" IterationCount="INFINITE" PlaybackDirection="Alternate">
                <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="-15" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="15" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="ProgressBar.glyph-indicator.vibrating-alarm-clock.paused">
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_Indicator" IsVisible="False" />
                    <TextBlock x:Name="Glyph" Text="⏸" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ProgressBar.glyph-indicator.vibrating-alarm-clock.failed">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Status.Bad}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_Indicator" IsVisible="False" />
                    <TextBlock x:Name="Glyph" Text="⏰" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- swinging-bell: 🔔 static idle → pendulum from top-centre when :indeterminate -->
    <Style Selector="ProgressBar.glyph-indicator.swinging-bell">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_Indicator" IsVisible="False" />
                    <TextBlock x:Name="Glyph" Text="🔔" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.0">
                        <TextBlock.RenderTransform><RotateTransform /></TextBlock.RenderTransform>
                    </TextBlock>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ProgressBar.glyph-indicator.swinging-bell:indeterminate /template/ TextBlock#Glyph">
        <Style.Animations>
            <Animation Duration="0:0:0.5" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="-20" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="20" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="TextBlock.terminal-mono">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Courier New,monospace" />
    </Style>
    <Style Selector="SelectableTextBlock.terminal-mono">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Courier New,monospace" />
    </Style>
    <Style Selector="TextBox.terminal-mono">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Courier New,monospace" />
    </Style>
    <Style Selector="SelectableTextBlock.terminal-content">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.normal.Foreground}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Base}" />
    </Style>
    <Style Selector="SelectableTextBlock.terminal-detail">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.muted.Foreground}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.caption.FontSize}" />
    </Style>
    <Style Selector="SelectableTextBlock.terminal-error">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="#FFB3B3" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Base}" />
    </Style>
    <Style Selector="TextBox.terminal-editor">
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Base}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityPane.HoverBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.normal.Foreground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Theme.Class.normal.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.Border}" />
    </Style>
    <Style Selector="TextBlock.agent-meta-label">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.muted.Foreground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.caption.FontSize}" />
    </Style>
    <Style Selector="TextBlock.agent-role-label">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.caption.FontSize}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.agent-role-label.role-user">
        <Setter Property="Foreground" Value="#6EC06E" />
    </Style>
    <Style Selector="TextBlock.agent-role-label.role-assistant">
        <Setter Property="Foreground" Value="#6A9FD8" />
    </Style>
    <Style Selector="TextBlock.agent-role-label.role-system">
        <Setter Property="Foreground" Value="#C29DFF" />
    </Style>
    <Style Selector="TextBlock.agent-role-label.role-tool">
        <Setter Property="Foreground" Value="#E0A860" />
    </Style>
    <Style Selector="TextBlock.agent-role-label.role-developer">
        <Setter Property="Foreground" Value="#7FC8A9" />
    </Style>
    <Style Selector="TextBlock.agent-reasoning-line">
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.caption.FontSize}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.muted.Foreground}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="TextBlock.agent-chip-label">
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.caption.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.normal.Foreground}" />
    </Style>
    <Style Selector="TextBlock.agent-body-text">
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Base}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.normal.Foreground}" />
    </Style>
    <Style Selector="SelectableTextBlock.agent-log-line">
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="CheckBox.agent-option-toggle">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.normal.Foreground}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="Border.agent-surface">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityPane.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.agent-surface.compact">
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.agent-titlebar">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityPane.HoverBackground}" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="TextBlock.agent-main-title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.normal.Foreground}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSize.Base}" />
    </Style>
    <Style Selector="Border.agent-pane">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityPane.Background}" />
    </Style>
    <Style Selector="TextBlock.agent-runtime-placeholder">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.muted.Foreground}" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.caption.FontSize}" />
    </Style>
    <Style Selector="TextBlock.agent-dialog-title">
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.heading.FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.muted.Foreground}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.agent-error-title">
        <Setter Property="Foreground" Value="#E57373" />
    </Style>
    <Style Selector="Window.agent-window">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityPane.HoverBackground}" />
    </Style>
    <Style Selector="DockPanel.agent-dialog-root">
        <Setter Property="Margin" Value="16" />
    </Style>
    <Style Selector="DockPanel.agent-dialog-root.compact">
        <Setter Property="Margin" Value="12" />
    </Style>
    <Style Selector="StackPanel.agent-dialog-actions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Spacing" Value="8" />
    </Style>

    <Style Selector="Border.agent-card">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Border.agent-card.error">
        <Setter Property="Background" Value="#3A1F1F" />
        <Setter Property="BorderBrush" Value="#6B2A2A" />
    </Style>
    <Style Selector="Border.agent-row">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityPane.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.agent-running">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.HoverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityPane.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Border.agent-chip">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.HoverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.HoverBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="TextBlock.agent-section-title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.muted.Foreground}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.caption.FontSize}" />
    </Style>
    <Style Selector="TextBlock.agent-detail-label">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.muted.Foreground}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.caption.FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.agent-detail-value">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.normal.Foreground}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.caption.FontSize}" />
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Courier New,monospace" />
    </Style>
    <Style Selector="Button.copyable-text-button">
        <Setter Property="Content" Value="⧉" />
        <Setter Property="ToolTip.Tip" Value="Copy value" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.muted.Foreground}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.caption.FontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="StackPanel.copyable-text:pointerover Button.copyable-text-button">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Grid.copyable-text:pointerover Button.copyable-text-button">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBox.copyable-text:pointerover Button.copyable-text-button">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.copyable-text-button:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.normal.Foreground}" />
    </Style>
    <Style Selector="Button.copyable-text-button:pressed">
        <Setter Property="Foreground" Value="#6EC06E" />
    </Style>
    
    <!-- Dock tab header binding -->
    <Style Selector="DocumentTabStripItem">
        <Setter Property="ToolTip.Tip" Value="{Binding Content.TabViewModel.TabTooltip}" />
    </Style>

    <!-- Alt+N shortcut index badge on tab headers -->
    <Style Selector="Border.alt-index-badge">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="3,1" />
        <Setter Property="Margin" Value="0,-2,-2,0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="ZIndex" Value="10" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" Easing="LinearEasing" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.alt-index-badge.alt-held">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="Button.workspace-url-link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.workspace-url-link:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

</Styles>


