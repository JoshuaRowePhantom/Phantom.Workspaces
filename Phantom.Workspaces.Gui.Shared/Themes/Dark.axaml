<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme color palette -->
    
    <!-- Entity pane surfaces -->
    <SolidColorBrush x:Key="Theme.Surface.EntityPane.Background">#000000</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.Chat.Background">#000000</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityPane.Border">#2A2A2A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityPane.HoverBackground">#242424</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityPane.HoverBorder">#343434</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityPane.SelectedBackground">#2A2A2A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityPane.SelectedBorder">#5EA0FF</SolidColorBrush>

    <!-- Entity card surfaces -->
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.Background">#252525</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.ItemPanelBackground">#252525</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.Border">#3A3A3A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.HoverBackground">#303030</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.HoverBorder">#505050</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.ActiveBorder">#6080C0FF</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.SelectedBackground">#2A2A2A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.SelectedBorder">Gold</SolidColorBrush>

    <!-- Popup surfaces -->
    <SolidColorBrush x:Key="Theme.Surface.Popup.Background">#2C2C2C</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.Popup.Border">#3A3A3A</SolidColorBrush>

    <!-- Text classes -->
    <SolidColorBrush x:Key="Theme.Class.normal.Foreground">#E6E6E6</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Class.heading.Foreground">#E6E6E6</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Class.section-title.Foreground">#E6E6E6</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Class.caption.Foreground">#E6E6E6</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Class.muted.Foreground">#B3B3B3</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Class.accent.Foreground">#5EA0FF</SolidColorBrush>

    <!-- Status badges -->
    <SolidColorBrush x:Key="Theme.Status.Good">#2E7D32</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Bad">#C62828</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Foreground">#F5F5F5</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Palette.0">#1565C0</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Palette.1">#4527A0</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Palette.2">#6A1B9A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Palette.3">#00838F</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Palette.4">#FF8F00</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Palette.5">#455A64</SolidColorBrush>

    <!-- Terminal palette -->
    <SolidColorBrush x:Key="Terminal.Background">#0D1117</SolidColorBrush>
    <SolidColorBrush x:Key="Terminal.Foreground">#C9D1D9</SolidColorBrush>
    <SolidColorBrush x:Key="Terminal.Cursor">#58A6FF</SolidColorBrush>
    <SolidColorBrush x:Key="Terminal.SelectionBackground">#264F78</SolidColorBrush>
</ResourceDictionary>
