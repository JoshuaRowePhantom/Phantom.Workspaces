<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme color palette -->
    
    <!-- Entity pane surfaces (aligned with ProfileThemeSettings.Dark) -->
    <SolidColorBrush x:Key="Theme.Surface.EntityPane.Background">#1E1E1E</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.Chat.Background">#000000</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityPane.Border">#2A2A2A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityPane.HoverBackground">#242424</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityPane.HoverBorder">#353535</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityPane.SelectedBackground">#2A2A2A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityPane.SelectedBorder">#444444</SolidColorBrush>

    <!-- Entity card surfaces (aligned with ProfileThemeSettings.Dark) -->
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.Background">#2A2A2A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.ItemPanelBackground">#2A2A2A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.Border">#3A3A3A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.HoverBackground">#343434</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.HoverBorder">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.ActiveBorder">#6080C0FF</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.SelectedBackground">#3A3A3A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.EntityCard.SelectedBorder">#5EA0FF</SolidColorBrush>

    <!-- Popup surfaces -->
    <SolidColorBrush x:Key="Theme.Surface.Popup.Background">#2C2C2C</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Surface.Popup.Border">#3A3A3A</SolidColorBrush>

    <!-- Text classes -->
    <SolidColorBrush x:Key="Theme.Class.normal.Foreground">#E6E6E6</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Class.heading.Foreground">#E6E6E6</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Class.section-title.Foreground">#E6E6E6</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Class.caption.Foreground">#E6E6E6</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Class.muted.Foreground">#B3B3B3</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Class.accent.Foreground">#5EA0FF</SolidColorBrush>

    <!-- Font defaults -->
    <FontFamily x:Key="Theme.FontFamily">Inter</FontFamily>
    <x:Double x:Key="Theme.FontSize.Base">13</x:Double>

    <!-- Text class typography defaults -->
    <x:Double x:Key="Theme.Class.normal.Opacity">1</x:Double>
    <x:Double x:Key="Theme.Class.normal.FontSize">13</x:Double>
    <FontWeight x:Key="Theme.Class.normal.FontWeight">Normal</FontWeight>
    <x:Double x:Key="Theme.Class.heading.Opacity">1</x:Double>
    <x:Double x:Key="Theme.Class.heading.FontSize">16</x:Double>
    <FontWeight x:Key="Theme.Class.heading.FontWeight">Bold</FontWeight>
    <x:Double x:Key="Theme.Class.section-title.Opacity">1</x:Double>
    <x:Double x:Key="Theme.Class.section-title.FontSize">14</x:Double>
    <FontWeight x:Key="Theme.Class.section-title.FontWeight">Bold</FontWeight>
    <x:Double x:Key="Theme.Class.caption.Opacity">1</x:Double>
    <x:Double x:Key="Theme.Class.caption.FontSize">11</x:Double>
    <FontWeight x:Key="Theme.Class.caption.FontWeight">Normal</FontWeight>
    <x:Double x:Key="Theme.Class.muted.Opacity">1</x:Double>
    <x:Double x:Key="Theme.Class.muted.FontSize">13</x:Double>
    <FontWeight x:Key="Theme.Class.muted.FontWeight">Normal</FontWeight>
    <x:Double x:Key="Theme.Class.accent.Opacity">1</x:Double>
    <x:Double x:Key="Theme.Class.accent.FontSize">13</x:Double>
    <FontWeight x:Key="Theme.Class.accent.FontWeight">Normal</FontWeight>

    <!-- Status badges -->
    <SolidColorBrush x:Key="Theme.Status.Good">#2E7D32</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Bad">#C62828</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Foreground">#F5F5F5</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Palette.0">#1565C0</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Palette.1">#4527A0</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Palette.2">#6A1B9A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Palette.3">#00838F</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Palette.4">#FF8F00</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Status.Palette.5">#455A64</SolidColorBrush>

    <!-- Issue #1120: white glyph brush for the shared pane-collapser (>>/<<) ToggleButton. -->
    <SolidColorBrush x:Key="Theme.Collapser.Glyph.Foreground">#FFFFFF</SolidColorBrush>

    <!-- Terminal palette -->
    <SolidColorBrush x:Key="Terminal.Background">#0D1117</SolidColorBrush>
    <SolidColorBrush x:Key="Terminal.Foreground">#C9D1D9</SolidColorBrush>
    <SolidColorBrush x:Key="Terminal.Cursor">#58A6FF</SolidColorBrush>
    <SolidColorBrush x:Key="Terminal.SelectionBackground">#264F78</SolidColorBrush>
</ResourceDictionary>
