<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Phantom.Workspaces.Agent.Gui\Phantom.Workspaces.Agent.Gui.csproj" />
    <ProjectReference Include="..\Phantom.Workspaces.Gui.Shared\Phantom.Workspaces.Gui.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shares the scripted BYOK server and CLI locator with the Llm.Core test suite (issue #912).
         Linked as sources (not a project reference) because the two test projects use different
         xunit major versions. -->
    <Compile Include="..\Phantom.Workspaces.Llm.Core.Tests\ScriptedByokChatServer.cs" Link="ScriptedByokChatServer.cs" />
    <Compile Include="..\Phantom.Workspaces.Llm.Core.Tests\CopilotCliLocator.cs" Link="CopilotCliLocator.cs" />
  </ItemGroup>
</Project>
