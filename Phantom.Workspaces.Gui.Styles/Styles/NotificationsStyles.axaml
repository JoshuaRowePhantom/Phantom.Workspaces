<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:CompileBindings="False">
    <Styles.Resources>
        <!-- Notifications panel resources -->
        <StaticResource x:Key="Theme.Notifications.Panel.Background" ResourceKey="Theme.Surface.Popup.Background" />
        <StaticResource x:Key="Theme.Notifications.Panel.Border" ResourceKey="Theme.Surface.Popup.Border" />
        <CornerRadius x:Key="Theme.Notifications.Panel.CornerRadius">6</CornerRadius>
        <BoxShadows x:Key="Theme.Notifications.Panel.BoxShadow">0 4 16 0 #B0000000</BoxShadows>
        
        <!-- Notifications badge (unread count) -->
        <SolidColorBrush x:Key="Theme.Notifications.Badge.Foreground">Gold</SolidColorBrush>
    </Styles.Resources>

    <Style Selector="Border.notifications-panel">
        <Setter Property="Background" Value="{DynamicResource Theme.Notifications.Panel.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Notifications.Panel.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Theme.Notifications.Panel.CornerRadius}" />
        <Setter Property="BoxShadow" Value="{DynamicResource Theme.Notifications.Panel.BoxShadow}" />
    </Style>

    <Style Selector="TextBlock.notification-unread-indicator">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Notifications.Badge.Foreground}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.notification-bell-ringing">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <RotateTransform Angle="0" />
        </Setter>
        <Style.Animations>
            <Animation IterationCount="INFINITE"
                       Duration="0:0:0.5"
                       PlaybackDirection="Alternate"
                       Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="-18" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="18" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
