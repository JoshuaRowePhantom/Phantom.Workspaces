<Styles xmlns="https://github.com/avaloniaui">
    <Style Selector="TextBlock.heading">
        <Setter Property="FontWeight" Value="{DynamicResource Theme.Class.heading.FontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.heading.Foreground}" />
        <Setter Property="Opacity" Value="{DynamicResource Theme.Class.heading.Opacity}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.heading.FontSize}" />
    </Style>
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontWeight" Value="{DynamicResource Theme.Class.section-title.FontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.section-title.Foreground}" />
        <Setter Property="Opacity" Value="{DynamicResource Theme.Class.section-title.Opacity}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.section-title.FontSize}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontWeight" Value="{DynamicResource Theme.Class.caption.FontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.caption.Foreground}" />
        <Setter Property="Opacity" Value="{DynamicResource Theme.Class.caption.Opacity}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.caption.FontSize}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="FontWeight" Value="{DynamicResource Theme.Class.muted.FontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.muted.Foreground}" />
        <Setter Property="Opacity" Value="{DynamicResource Theme.Class.muted.Opacity}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.muted.FontSize}" />
    </Style>
    <Style Selector="TextBlock.accent">
        <Setter Property="FontWeight" Value="{DynamicResource Theme.Class.accent.FontWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Class.accent.Foreground}" />
        <Setter Property="Opacity" Value="{DynamicResource Theme.Class.accent.Opacity}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Class.accent.FontSize}" />
    </Style>

    <Style Selector="Grid.entity-pane">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityPane.Background}" />
    </Style>
    <Style Selector="Grid.entity-pane:pointerover">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityPane.HoverBackground}" />
    </Style>
    <Style Selector="Border.entity-card">
        <Setter Property="Padding" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.Border}" />
    </Style>
    <Style Selector="Border.entity-card:pointerover">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.HoverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.HoverBorder}" />
    </Style>
    <Style Selector="Border.entity-card.selected">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.SelectedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.SelectedBorder}" />
    </Style>
    <Style Selector="StackPanel.sticky-pinned > Border.entity-card">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.HoverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.HoverBorder}" />
        <Setter Property="Opacity" Value="0.92" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.entity-card-expand-section">
        <Setter Property="Margin" Value="0,-4,0,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.Border}" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.entity-card-expand-section:pointerover">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.HoverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.HoverBorder}" />
    </Style>
    <Style Selector="Button.entity-card-expand-button">
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.window-header">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ListBox.top-view-list">
        <Setter Property="Margin" Value="18,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.top-view-item">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button.settings-gear">
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.pane-header">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.workspace-region-card">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TabControl.workspace-tabs">
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="TabControl.workspace-tabs TabItem">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6,6,0,0" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.Border}" />
    </Style>
    <Style Selector="TabControl.workspace-tabs TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.HoverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.HoverBorder}" />
    </Style>
    <Style Selector="TabControl.workspace-tabs TabItem:selected">
        <Setter Property="Margin" Value="0,0,2,-1" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.SelectedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.SelectedBorder}" />
    </Style>
    <Style Selector="TabControl.workspace-tabs /template/ ContentPresenter#PART_SelectedContentHost">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Surface.EntityCard.Border}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.EntityCard.Background}" />
        <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.entity-badge">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,2,6,0" />
    </Style>
    <Style Selector="GridSplitter.main-splitter">
        <Setter Property="Width" Value="6" />
        <Setter Property="Background" Value="#2A2A2A" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ResizeDirection" Value="Columns" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="ShowsPreview" Value="True" />
    </Style>

    <Style Selector="Grid.settings-root">
        <Setter Property="Margin" Value="16" />
    </Style>
    <Style Selector="StackPanel.settings-main">
        <Setter Property="Spacing" Value="14" />
    </Style>
    <Style Selector="StackPanel.settings-section">
        <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="StackPanel.settings-row">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="StackPanel.settings-actions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.settings-close">
        <Setter Property="MinWidth" Value="90" />
    </Style>

    <Style Selector="Button.queue-action-button">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Button.queue-glyph-button">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.queue-danger-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#666666" />
        <Setter Property="Foreground" Value="#9A9A9A" />
    </Style>
    <Style Selector="Button.queue-danger-button:pointerover">
        <Setter Property="BorderBrush" Value="#8A3A3A" />
        <Setter Property="Foreground" Value="#FF6666" />
    </Style>
    <Style Selector="Button.queue-item-trigger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.queue-status-pill">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style Selector="TextBlock.terminal-mono">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Courier New,monospace" />
    </Style>
    <Style Selector="SelectableTextBlock.terminal-mono">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Courier New,monospace" />
    </Style>
    <Style Selector="TextBox.terminal-mono">
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Courier New,monospace" />
    </Style>
    <Style Selector="SelectableTextBlock.terminal-content">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="#D0D0D0" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="SelectableTextBlock.terminal-detail">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="#C8C8C8" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="SelectableTextBlock.terminal-error">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="#FFB3B3" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBox.terminal-editor">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="#242424" />
        <Setter Property="Foreground" Value="#E0E0E0" />
        <Setter Property="CaretBrush" Value="#E0E0E0" />
        <Setter Property="BorderBrush" Value="#3A3A3A" />
    </Style>
    <Style Selector="TextBlock.agent-meta-label">
        <Setter Property="Foreground" Value="#B8B8B8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.agent-role-label">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.agent-role-label.role-user">
        <Setter Property="Foreground" Value="#6EC06E" />
    </Style>
    <Style Selector="TextBlock.agent-role-label.role-assistant">
        <Setter Property="Foreground" Value="#6A9FD8" />
    </Style>
    <Style Selector="TextBlock.agent-role-label.role-system">
        <Setter Property="Foreground" Value="#C29DFF" />
    </Style>
    <Style Selector="TextBlock.agent-role-label.role-tool">
        <Setter Property="Foreground" Value="#E0A860" />
    </Style>
    <Style Selector="TextBlock.agent-role-label.role-developer">
        <Setter Property="Foreground" Value="#7FC8A9" />
    </Style>
    <Style Selector="TextBlock.agent-reasoning-line">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="#8F8F8F" />
    </Style>
    <Style Selector="TextBlock.agent-chip-label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#D0D0D0" />
    </Style>
    <Style Selector="TextBlock.agent-body-text">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#CCCCCC" />
    </Style>
    <Style Selector="SelectableTextBlock.agent-log-line">
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="CheckBox.agent-option-toggle">
        <Setter Property="Foreground" Value="#CCCCCC" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="Border.agent-surface">
        <Setter Property="Background" Value="#111111" />
        <Setter Property="BorderBrush" Value="#303030" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.agent-surface.compact">
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.agent-titlebar">
        <Setter Property="Background" Value="#1A1A1A" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="TextBlock.agent-main-title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#D0D0D0" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.agent-pane">
        <Setter Property="Background" Value="#161616" />
    </Style>
    <Style Selector="TextBlock.agent-runtime-placeholder">
        <Setter Property="Foreground" Value="#444444" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.agent-dialog-title">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#AAAAAA" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.agent-error-title">
        <Setter Property="Foreground" Value="#E57373" />
    </Style>
    <Style Selector="Window.agent-window">
        <Setter Property="Background" Value="#1A1A1A" />
    </Style>
    <Style Selector="DockPanel.agent-dialog-root">
        <Setter Property="Margin" Value="16" />
    </Style>
    <Style Selector="DockPanel.agent-dialog-root.compact">
        <Setter Property="Margin" Value="12" />
    </Style>
    <Style Selector="StackPanel.agent-dialog-actions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Spacing" Value="8" />
    </Style>

    <Style Selector="Border.agent-card">
        <Setter Property="Background" Value="#252525" />
        <Setter Property="BorderBrush" Value="#3A3A3A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="Border.agent-card.error">
        <Setter Property="Background" Value="#3A1F1F" />
        <Setter Property="BorderBrush" Value="#6B2A2A" />
    </Style>
    <Style Selector="Border.agent-row">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderBrush" Value="#2A2A2A" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.agent-running">
        <Setter Property="Background" Value="#232323" />
        <Setter Property="BorderBrush" Value="#2A2A2A" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Border.agent-chip">
        <Setter Property="Background" Value="#303030" />
        <Setter Property="BorderBrush" Value="#505050" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6" />
    </Style>
</Styles>
