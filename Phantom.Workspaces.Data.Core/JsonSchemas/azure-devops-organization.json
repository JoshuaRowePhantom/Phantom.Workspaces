{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/azure-devops-organization.json",
  "description": "Schema for Azure DevOps organization entities and their connection metadata.",
  "allOf": [
    {
      "$ref": "entity.json"
    },
    {
      "$ref": "external.json"
    }
  ],
  "type": "object",
  "required": [
    "entity-types"
  ],
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "azure-devops-organization"
      }
    },
    "organization-name": {
      "type": "string",
      "description": "The Azure DevOps organization name"
    }
  }
}
