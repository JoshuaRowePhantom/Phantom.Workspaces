{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/user-computer-profile.json",
  "description": "Schema for user-computer profile entities that store per-user machine preferences and mappings.",
  "allOf": [
    {
      "$ref": "entity.json"
    }
  ],
  "type": "object",
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "user-computer-profile"
      }
    },
    "computer-reference": {
      "type": "array",
      "minItems": 3,
      "prefixItems": [
        {
          "const": "computers"
        },
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "items": {
        "type": "string"
      },
      "description": "Reference to the computer entity"
    },
    "user-reference": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "prefixItems": [
        {
          "const": "users"
        },
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "items": {
        "type": "string"
      },
      "description": "Reference to the user entity"
    },
    "home-directory": {
      "type": "string",
      "description": "Home directory path for this user on this computer"
    },
    "scheduled-tools-paused": {
      "type": "boolean",
      "description": "When true, the scheduled tools host on this profile starts no new runs and stops in-flight runs (persisted Stop all / Pause state)."
    },
    "reachability": {
      "description": "Durable, credential-free reachability model.",
      "type": "object",
      "properties": {
        "routes": {
          "type": "object",
          "description": "Map of stable route id to a publisher-owned reachability route.",
          "propertyNames": {
            "pattern": "^(direct-http|reverse-http:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          },
          "minProperties": 0,
          "maxProperties": 16,
          "additionalProperties": {
            "$ref": "reachability-route.json"
          }
        }
      },
      "required": [
        "routes"
      ],
      "unevaluatedProperties": false
    },
    "chat-input": {
      "type": "object",
      "properties": {
        "show-help-text": {
          "type": "boolean",
          "description": "When false, the keyboard-shortcut help text below the chat input box is hidden.",
          "default": true
        }
      }
    }
  },
  "required": [
    "entity-types",
    "computer-reference",
    "user-reference"
  ]
}
