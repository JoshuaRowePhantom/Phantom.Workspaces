{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/view.json",
  "description": "Schema for view entities that define query-driven workspace navigation and presentation.",
  "type": "object",
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "view"
      }
    },
    "title": {
      "$ref": "core.json#/$defs/local-string"
    },
    "sub-views": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/view-reference"
          },
          {
            "$ref": "#/$defs/view-definition"
          }
        ]
      }
    }
  },
  "required": [
    "entity-types",
    "title",
    "sub-views"
  ],
  "$defs": {
    "view-reference": {
      "type": "object",
      "properties": {
        "view-entity-id": {
          "$ref": "core.json#/$defs/entity-reference",
          "x-entity-types": ["view"]
        },
        "disposition": {
          "$ref": "#/$defs/view-disposition"
        }
      },
      "required": [
        "view-entity-id",
        "disposition"
      ],
      "unevaluatedProperties": false
    },
    "view-definition": {
      "type": "object",
      "properties": {
        "disposition": {
          "$ref": "#/$defs/view-disposition"
        },
        "get-entity": {
          "$ref": "https://schemas.workspaces.phantom.to/workspaces/data/core/workspace-entities-data-access-layer.json#/$defs/get-entity"
        },
        "query": {
          "description": "A query (clauses) that selects the entities shown by this sub-view, as an alternative to 'get-entity'. Use this for interest-driven views (for example, inbox and workstreams).",
          "$ref": "https://schemas.workspaces.phantom.to/workspaces/data/core/workspace-entities-data-access-layer.json#/$defs/query-request"
        },
        "relationships-to-return": {
          "$ref": "https://schemas.workspaces.phantom.to/workspaces/data/core/workspace-entities-data-access-layer.json#/$defs/relationships-to-return"
        },
        "timestamps": {
          "$ref": "https://schemas.workspaces.phantom.to/workspaces/data/core/workspace-entities-data-access-layer.json#/$defs/timestamps"
        },
        "entity-type-views": {
          "type": "array",
          "items": {
            "$ref": "entity-type-view.json",
            "x-entity-types": ["entity-type-view"]
          }
        }
      },
      "required": [
        "disposition"
      ],
      "oneOf": [
        {
          "required": [
            "get-entity"
          ]
        },
        {
          "required": [
            "query"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "view-disposition": {
      "type": "string",
      "enum": [
        "expanded",
        "collapsed",
        "new-window"
      ]
    }
  }
}
