{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/view.json",
  "type": "object",
  "properties": {
    "title": {
      "$ref": "core.json#/$defs/local-string"
    },
    "sub-views": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/view-reference"
          },
          {
            "$ref": "#/$defs/view-definition"
          }
        ]
      }
    }
  },
  "required": [
    "title",
    "sub-views"
  ],
  "$defs": {
    "view-reference": {
      "type": "object",
      "properties": {
        "view-entity-id": {
          "$ref": "core.json#/$defs/entity-reference",
          "x-entity-type": "view"
        },
        "disposition": {
          "$ref": "#/$defs/view-disposition"
        }
      },
      "required": [
        "view-entity-id",
        "disposition"
      ],
      "unevaluatedProperties": false
    },
    "view-definition": {
      "type": "object",
      "properties": {
        "disposition": {
          "$ref": "#/$defs/view-disposition"
        },
        "query": {
          "type": "object",
          "properties": {
            "clauses": {
              "type": "array"
            },
            "timestamps": {
              "type": "array"
            }
          },
          "required": [
            "clauses"
          ],
          "additionalProperties": true
        },
        "entity-type-views": {
          "type": "array",
          "items": {
            "$ref": "entity-type-view.json",
            "x-entity-type": "entity-type-view"
          }
        }
      },
      "required": [
        "disposition",
        "query"
      ],
      "unevaluatedProperties": false
    },
    "view-disposition": {
      "type": "string",
      "enum": [
        "expanded",
        "collapsed",
        "new-window"
      ]
    }
  }
}
