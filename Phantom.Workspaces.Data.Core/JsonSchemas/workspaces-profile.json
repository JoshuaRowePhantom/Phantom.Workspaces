{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/workspaces-profile.json",
  "type": "object",
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "workspaces-profile"
      }
    },
    "theme": {
      "type": "string",
      "enum": [
        "dark",
        "light"
      ]
    },
    "initial-workspace": {
      "$ref": "core.json#/$defs/entity-id"
    },
    "opened-workspaces": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-id"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "theme",
    "initial-workspace",
    "opened-workspaces"
  ]
}
