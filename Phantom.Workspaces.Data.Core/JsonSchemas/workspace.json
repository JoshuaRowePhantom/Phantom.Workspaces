{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/workspace.json",
  "description": "Schema for workspace entities that represent top-level workspace containers and metadata.",
  "type": "object",
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "workspace"
      }
    },
    "entity-id": {
      "$ref": "core.json#/$defs/entity-id"
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-name"
      }
    },
    "display-name": {
      "$ref": "core.json#/$defs/local-string"
    },
    "title": {
      "$ref": "core.json#/$defs/local-string"
    },
    "tabs": {
      "type": "array",
      "description": "Ordered list of open tabs in their current visual order (left to right). Kept in sync with the dock model's VisibleDockables order. Replaces regions[].",
      "items": {
        "$ref": "#/$defs/workspace-tab-descriptor"
      }
    },
    "dock-layout": {
      "description": "Dock.Serializer snapshot of the workspace content layout, stored as an inline JSON object. Captures splits, proportions, and active-tab-per-dock. Absent or invalid values are silently ignored.",
      "$ref": "workspace-dock-layout.json"
    },
    "active-tab-id": {
      "type": "string",
      "description": "Tab ID to activate after restore. Replaces focused-tab-id."
    },
    "regions": {
      "type": "array",
      "deprecated": true,
      "description": "Deprecated. Use tabs and dock-layout instead. Kept for backward compatibility; read-only during migration, never written.",
      "items": {
        "$ref": "#/$defs/workspace-region"
      }
    },
    "focused-tab-id": {
      "type": "string",
      "deprecated": true,
      "description": "Deprecated. Use active-tab-id instead."
    }
  },
  "required": [
    "entity-types"
  ],
  "$defs": {
    "workspace-tab-descriptor": {
      "type": "object",
      "description": "Descriptor for a single open tab, stored in visual order.",
      "properties": {
        "tab-id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "content": {
          "oneOf": [
            {
              "$ref": "#/$defs/workspace-entity-content"
            },
            {
              "$ref": "#/$defs/workspace-browser-content"
            }
          ]
        }
      },
      "required": [
        "tab-id",
        "title",
        "kind",
        "content"
      ],
      "unevaluatedProperties": false
    },
    "workspace-region": {
      "type": "object",
      "properties": {
        "region-id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "dock": {
          "type": "string",
          "enum": [
            "center",
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        "tabs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workspace-tab"
          }
        },
        "size": {
          "type": "number",
          "minimum": 0.1
        }
      },
      "required": [
        "region-id",
        "title",
        "dock",
        "tabs",
        "size"
      ],
      "unevaluatedProperties": false
    },
    "workspace-tab": {
      "type": "object",
      "description": "Deprecated tab descriptor used inside legacy regions[]. Replaced by workspace-tab-descriptor.",
      "properties": {
        "tab-id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "content": {
          "oneOf": [
            {
              "$ref": "#/$defs/workspace-entity-content"
            },
            {
              "$ref": "#/$defs/workspace-browser-content"
            }
          ]
        },
        "dock": {
          "type": "string",
          "enum": [
            "full",
            "left",
            "right",
            "bottom"
          ]
        }
      },
      "required": [
        "tab-id",
        "kind",
        "content",
        "dock"
      ],
      "unevaluatedProperties": false
    },
    "workspace-entity-content": {
      "type": "object",
      "properties": {
        "target-entity-name": {
          "$ref": "core.json#/$defs/entity-reference"
        }
      },
      "required": [
        "target-entity-name"
      ],
      "unevaluatedProperties": false
    },
    "workspace-browser-content": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "url"
      ],
      "unevaluatedProperties": false
    }
  }
}
