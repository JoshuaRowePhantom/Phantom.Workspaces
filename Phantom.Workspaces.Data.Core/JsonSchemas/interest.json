{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/interest.json",
  "description": "Schema for interest relationship entities that encode automated relationship behaviors.",
  "type": "object",
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "allOf": [
        {
          "contains": {
            "const": "relationship"
          }
        },
        {
          "contains": {
            "const": "interest"
          }
        }
      ]
    },
    "applied": {
      "$ref": "#/$defs/interest-state-content"
    },
    "notApplied": {
      "$ref": "#/$defs/interest-state-content"
    }
  },
  "required": [
    "entity-types",
    "applied",
    "notApplied"
  ],
  "$defs": {
    "interest-state-content": {
      "type": "object",
      "properties": {
        "indicator": {
          "$ref": "core.json#/$defs/local-string"
        },
        "description": {
          "$ref": "core.json#/$defs/local-string"
        },
        "actionText": {
          "$ref": "core.json#/$defs/local-string"
        }
      },
      "required": [
        "indicator",
        "description",
        "actionText"
      ],
      "unevaluatedProperties": false
    }
  }
}
