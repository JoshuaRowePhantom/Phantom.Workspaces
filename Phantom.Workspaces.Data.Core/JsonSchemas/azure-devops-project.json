{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/azure-devops-project.json",
  "description": "Schema for Azure DevOps project entities and their project-level metadata.",
  "allOf": [
    {
      "$ref": "entity.json"
    },
    {
      "$ref": "external.json"
    }
  ],
  "type": "object",
  "required": [
    "entity-types"
  ],
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "azure-devops-project"
      }
    },
    "project-id": {
      "type": "string",
      "description": "The Azure DevOps project ID (GUID)"
    }
  }
}
