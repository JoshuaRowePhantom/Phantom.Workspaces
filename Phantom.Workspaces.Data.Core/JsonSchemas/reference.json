{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/reference.json",
  "description": "Schema for reference relationship entities that connect entities through typed references.",
  "allOf": [
    {
      "$ref": "relationship.json"
    }
  ],
  "type": "object",
  "required": [
    "entity-types"
  ],
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "reference"
      }
    },
    "participants": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "core.json#/$defs/entity-id"
        },
        "target": {
          "$ref": "core.json#/$defs/entity-id"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "additionalProperties": false
    }
  }
}
