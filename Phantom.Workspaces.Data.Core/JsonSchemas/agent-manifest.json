{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/agent-manifest.json",
  "description": "Schema for agent manifest entities that store declarative agent configurations with tool resource references. Tool resources are resolved at runtime based on execution context (user, machine, workspace).",
  "allOf": [
    {
      "$ref": "https://schemas.workspaces.phantom.to/workspaces/data/core/entity.json"
    }
  ],
  "type": "object",
  "properties": {
    "entity-types": {
      "type": "array",
      "contains": {
        "const": "agent-manifest"
      }
    },
    "manifest": {
      "$ref": "https://phantom-workspaces/schemas/agent-manifest.json"
    }
  },
  "required": [
    "entity-types",
    "manifest"
  ]
}
