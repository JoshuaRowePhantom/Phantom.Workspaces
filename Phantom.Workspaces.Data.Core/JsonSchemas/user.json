{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/user.json",
  "type": "object",
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "user"
      }
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/user-name"
      },
      "minItems": 1
    }
  },
  "required": [
    "entity-types",
    "names"
  ],
  "$defs": {
    "user-name": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "prefixItems": [
        {
          "const": "users"
        },
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "items": {
        "type": "string"
      }
    }
  }
}
