{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/note.json",
  "description": "Schema for note entities containing human-readable documentation and markdown content.",
  "type": "object",
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "note"
      }
    },
    "title": {
      "$ref": "core.json#/$defs/local-string"
    },
    "content": {
      "$ref": "mime-attachment.json",
      "x-default-mime-type": "text/markdown"
    }
  },
  "required": [
    "entity-types",
    "content"
  ]
}
