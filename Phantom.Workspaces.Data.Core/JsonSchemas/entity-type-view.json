{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/entity-type-view.json",
  "description": "Schema for entity type view entities that define presentation and navigation defaults by entity type.",
  "allOf": [
    {
      "$ref": "entity.json"
    }
  ],
  "type": "object",
  "required": [
    "entity-types"
  ],
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "entity-type-view"
      }
    },
    "base-entity-type-field-entity-id": {
      "$ref": "core.json#/$defs/entity-id"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity-field-view"
      }
    },
    "sort-order": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/sort-field"
      }
    },
    "traverse-relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship-traversal"
      }
    },
    "traversed-entity-display-disposition": {
      "type": "string",
      "enum": [
        "collapsed",
        "expanded"
      ]
    },
    "parent-hierarchy-relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship-traversal"
      }
    },
    "group-by-parent": {
      "type": "object",
      "description": "When present, the view assembler groups leaf entities by reading the entity-id in the given field and building parent nodes above them. Entities with no value in the field are placed at root level ungrouped.",
      "properties": {
        "source": {
          "type": "string",
          "enum": ["field"],
          "description": "How to derive the parent entity-id. 'field' reads it from the named field on each leaf entity."
        },
        "field-path": {
          "$ref": "core.json#/$defs/field-path"
        },
        "parent-entity-type-names": {
          "type": "array",
          "items": {
            "$ref": "core.json#/$defs/entity-type-id"
          }
        }
      },
      "required": ["source", "field-path", "parent-entity-type-names"],
      "unevaluatedProperties": false
    }
  },
  "$defs": {
    "entity-field-view": {
      "type": "object",
      "properties": {
        "field-path": {
          "$ref": "core.json#/$defs/field-path"
        },
        "display-format": {
          "type": "string"
        }
      },
      "required": [
        "field-path"
      ],
      "unevaluatedProperties": false
    },
    "relationship-traversal": {
      "type": "object",
      "properties": {
        "relationship-type-ids": {
          "type": "array",
          "items": {
            "$ref": "core.json#/$defs/entity-type-id",
            "x-entity-types": ["entity-type"]
          }
        },
        "relationship-role-names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationship-type": {
          "type": "string",
          "description": "Set to 'ancestor' to request synthesized ancestor grouping instead of a stored relationship traversal."
        },
        "entity-type-names": {
          "type": "array",
          "items": {
            "$ref": "core.json#/$defs/entity-type-id"
          },
          "description": "Entity types to query when relationship-type is 'ancestor'."
        },
        "name-prefix-length": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of leading name segments that form the ancestor grouping key (used with relationship-type 'ancestor')."
        },
        "max-depth": {
          "type": "integer",
          "minimum": 1
        }
      },
      "unevaluatedProperties": false
    }
  }
}
