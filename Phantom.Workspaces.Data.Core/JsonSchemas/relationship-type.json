{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/relationship-type.json",
  "allOf": [
    {
      "$ref": "entity-type.json"
    }
  ],
  "type": "object",
  "properties": {
    "schema": {
      "type": "object",
      "properties": {
        "properties": {
          "type": "object",
          "properties": {
            "participants": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "object"
                },
                "properties": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/participant-property-schema"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "participant-property-schema": {
      "oneOf": [
        {
          "$ref": "#/$defs/singleton-participant-property-schema"
        },
        {
          "$ref": "#/$defs/array-participant-property-schema"
        }
      ]
    },
    "singleton-participant-property-schema": {
      "type": "object",
      "properties": {
        "x-entity-type": {
          "$ref": "core.json#/$defs/entity-type-id"
        }
      },
      "required": [
        "x-entity-type"
      ]
    },
    "array-participant-property-schema": {
      "type": "object",
      "properties": {
        "type": {
          "const": "array"
        },
        "items": {
          "type": "object",
          "properties": {
            "x-entity-type": {
              "$ref": "core.json#/$defs/entity-type-id"
            }
          },
          "required": [
            "x-entity-type"
          ]
        }
      },
      "required": [
        "type",
        "items"
      ]
    }
  }
}
