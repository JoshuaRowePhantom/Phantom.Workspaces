{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/relationship-type.json",
  "description": "Schema for relationship type entities that define roles and validation for relationship instances.",
  "allOf": [
    {
      "$ref": "entity-type.json"
    }
  ],
  "type": "object",
  "properties": {
    "names": {
      "type": "array",
      "description": "Relationship types must have exactly one name in the format ['relationship', <entity-id>]",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/relationship-type-name"
      }
    },
    "schema": {
      "type": "object",
      "properties": {
        "properties": {
          "type": "object",
          "properties": {
            "participants": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "object"
                },
                "properties": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/participant-property-schema"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "relationship-type-name": {
      "type": "array",
      "description": "Relationship type names must be exactly ['relationship', <entity-id>]",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "const": "relationship"
        },
        {
          "$ref": "core.json#/$defs/entity-id"
        }
      ],
      "items": false
    },
    "participant-property-schema": {
      "$comment": "A participant role: either a singleton entity reference or an array of them. Each may optionally declare x-entity-types (allowed entity types); absent means any entity type is allowed.",
      "type": "object",
      "properties": {
        "x-entity-types": {
          "$ref": "core.json#/$defs/x-entity-types"
        },
        "items": {
          "type": "object",
          "properties": {
            "x-entity-types": {
              "$ref": "core.json#/$defs/x-entity-types"
            }
          }
        }
      }
    }
  }
}
