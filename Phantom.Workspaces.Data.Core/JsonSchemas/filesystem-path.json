{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/filesystem-path.json",
  "description": "Schema for filesystem path entities that map workspace concepts to local or remote paths.",
  "allOf": [
    {
      "$ref": "entity.json"
    },
    {
      "$ref": "core.json#/$defs/hosted-on-computer"
    }
  ],
  "type": "object",
  "required": [
    "entity-types"
  ],
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "filesystem-path"
      }
    },
    "path": {
      "type": "string",
      "description": "The filesystem path of the path."
    }
  }
}
