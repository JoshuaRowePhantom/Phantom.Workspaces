{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/entity-type.json",
  "description": "Schema for entity type entities, including composed schema references and metadata for each type.",
  "allOf": [
    {
      "$ref": "https://schemas.workspaces.phantom.to/workspaces/data/core/json-schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "entity-type"
      }
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/schema-index-name"
      },
      "minItems": 1
    },
    "default-name-prefixes": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    },
    "display-interest-types": {
      "type": "array",
      "description": "The interest types that should be displayed on entities of this entity type.",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      }
    },
    "entity-display-order": {
      "type": "number",
      "description": "Optional float that orders this entity type's contributed fields relative to other entity types when an entity is rendered or edited. Lower values are rendered first. When absent, the type sorts after all types that specify a value, then by type name."
    },
    "abstract": {
      "type": "boolean",
      "description": "When true, this entity type cannot stand on its own: an entity may not declare only abstract entity types. Every entity must declare at least one concrete (non-abstract) entity type."
    },
    "schema": {
      "$comment": "Meta-rule: every entity-type schema must enforce that its own type name appears in the entity's entity-types. The inline schema must require entity-types and constrain entity-types via contains.const.",
      "type": "object",
      "required": [
        "required",
        "properties"
      ],
      "properties": {
        "required": {
          "type": "array",
          "contains": {
            "const": "entity-types"
          }
        },
        "properties": {
          "type": "object",
          "required": [
            "entity-types"
          ],
          "properties": {
            "entity-types": {
              "type": "object",
              "required": [
                "contains"
              ],
              "properties": {
                "contains": {
                  "type": "object",
                  "required": [
                    "const"
                  ],
                  "properties": {
                    "const": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "entity-types",
    "names",
    "schema"
  ],
  "$defs": {
    "schema-index-name": {
      "anyOf": [
        {
          "$ref": "#/$defs/entity-type-name"
        },
        {
          "$ref": "#/$defs/json-schema-name"
        }
      ]
    },
    "entity-type-name": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "const": "entity-types"
        }
      ],
      "items": {
        "type": "string"
      }
    },
    "json-schema-name": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "const": "json-schemas"
        }
      ],
      "items": {
        "type": "string"
      }
    }
  }
}
