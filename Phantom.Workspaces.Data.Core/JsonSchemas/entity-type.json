{
  "entity-id": "739d0469-4ad8-4ae0-b2b5-3c3be996f264",
  "entity-types": [
    "json-schema",
    "note"
  ],
  "names": [
    [
      "json-schemas",
      "https://schemas.workspaces.phantom.to/workspaces/data/core/entity-type.json"
    ],
    [
      "entity-types",
      "entity-type"
    ]
  ],
  "display-name": {
    "default": "Entity Type Schema"
  },
  "content": {
    "default": {
      "mime-type": "text/markdown",
      "url": "documentation/entity-type-schema.md"
    }
  },
  "schema": {
    "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/entity-type.json",
    "type": "object",
    "properties": {
      "names": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/schema-index-name"
        },
        "minItems": 1
      }
    },
    "required": [
      "names"
    ],
    "$defs": {
      "schema-index-name": {
        "anyOf": [
          {
            "$ref": "#/$defs/entity-type-name"
          },
          {
            "$ref": "#/$defs/json-schema-name"
          }
        ]
      },
      "entity-type-name": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^entity-types(?:/|$)"
          },
          {
            "type": "array",
            "minItems": 1,
            "prefixItems": [
              {
                "const": "entity-types"
              }
            ],
            "items": {
              "type": "string"
            }
          }
        ]
      },
      "json-schema-name": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^json-schemas(?:/|$)"
          },
          {
            "type": "array",
            "minItems": 1,
            "prefixItems": [
              {
                "const": "json-schemas"
              }
            ],
            "items": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
