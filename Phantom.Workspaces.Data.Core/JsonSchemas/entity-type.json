{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/entity-type.json",
  "description": "Schema for entity type entities, including composed schema references and metadata for each type.",
  "allOf": [
    {
      "$ref": "https://schemas.workspaces.phantom.to/workspaces/data/core/json-schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/schema-index-name"
      },
      "minItems": 1
    },
    "default-name-prefixes": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    }
  },
  "required": [
    "names"
  ],
  "$defs": {
    "schema-index-name": {
      "anyOf": [
        {
          "$ref": "#/$defs/entity-type-name"
        },
        {
          "$ref": "#/$defs/json-schema-name"
        }
      ]
    },
    "entity-type-name": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "const": "entity-types"
        }
      ],
      "items": {
        "type": "string"
      }
    },
    "json-schema-name": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "const": "json-schemas"
        }
      ],
      "items": {
        "type": "string"
      }
    }
  }
}
