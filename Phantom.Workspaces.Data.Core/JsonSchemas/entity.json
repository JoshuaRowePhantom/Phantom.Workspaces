{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/entity.json",
  "description": "Base schema for all entities. This schema composes with declared entity type schemas.",
  "$comment": "The DAL composes this base schema with all applicable entity-type schemas and enforces unevaluatedProperties=false at the final composed-schema level.",
  "type": "object",
  "required": [
    "entity-types"
  ],
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "entity"
      }
    },
    "$schema": {
      "type": "string"
    },
    "entity-id": {
      "$ref": "core.json#/$defs/entity-id"
    },
    "names": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "core.json#/$defs/entity-name"
          },
          {
            "$comment": "Used only for the root folder name path ([]).",
            "type": "array",
            "maxItems": 0
          }
        ]
      }
    },
    "display-name": {
      "$ref": "core.json#/$defs/local-string"
    },
    "related-entity-ids": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-id"
      }
    },
    "relationship-roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "patternProperties": {
    "^.*entity-id$": {
      "$ref": "core.json#/$defs/entity-id"
    },
    "^.*entity-ids$": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-id"
      }
    }
  },
  "allOf": [
    {
      "$comment": "An empty entity name path ([]) is valid only for the root folder and must be the only name.",
      "if": {
        "properties": {
          "names": {
            "contains": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        "required": [
          "names"
        ]
      },
      "then": {
        "properties": {
          "entity-types": {
            "type": "array",
            "contains": {
              "const": "folder"
            }
          },
          "names": {
            "const": [
              []
            ]
          }
        },
        "required": [
          "entity-types",
          "names"
        ]
      }
    }
  ]
}
