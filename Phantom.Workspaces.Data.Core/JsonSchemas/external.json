{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/external.json",
  "description": "Schema for external reference entities that point to resources outside the workspace data store.",
  "allOf": [
    {
      "$ref": "entity.json"
    }
  ],
  "type": "object",
  "required": [
    "entity-types"
  ],
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "external"
      }
    },
    "urls": {
      "type": "object",
      "description": "Map of URL keys to URL values",
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      }
    }
  }
}
