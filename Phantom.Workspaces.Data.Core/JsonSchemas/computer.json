{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/computer.json",
  "description": "Schema for computer entities representing machine identity and related host metadata.",
  "allOf": [
    {
      "$ref": "entity.json"
    }
  ],
  "type": "object",
  "required": [
    "entity-types"
  ],
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "computer"
      }
    },
    "os": {
      "type": "string",
      "description": "Operating system identifier (e.g., 'windows', 'linux', 'macos')"
    }
  }
}
