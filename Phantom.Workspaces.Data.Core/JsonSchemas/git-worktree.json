{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/git-worktree.json",
  "description": "Schema for git worktree entities describing checked-out working trees and linkage to repositories.",
  "allOf": [
    {
      "$ref": "entity.json"
    },
    {
      "$ref": "filesystem-path.json"
    }
  ],
  "type": "object",
  "required": [
    "entity-types"
  ],
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "git-worktree"
      }
    },
    "git": {
      "type": "object",
      "description": "Git repository metadata populated by workspace discovery tooling.",
      "properties": {
        "branch": {
          "type": "string",
          "description": "Current checked-out branch name, or HEAD if detached."
        },
        "head-commit": {
          "type": "string",
          "description": "SHA of the HEAD commit."
        },
        "remotes": {
          "type": "array",
          "description": "List of configured remotes for this repository.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Remote name (e.g. 'origin')."
              },
              "url": {
                "type": "string",
                "description": "Remote fetch URL."
              }
            },
            "required": ["name"]
          }
        }
      }
    }
  }
}
