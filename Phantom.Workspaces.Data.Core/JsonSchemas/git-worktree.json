{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/git-worktree.json",
  "description": "Schema for git worktree entities describing checked-out working trees and linkage to repositories.",
  "allOf": [
    {
      "$ref": "entity.json"
    },
    {
      "$ref": "filesystem-path.json"
    }
  ],
  "type": "object",
  "required": [
    "entity-types"
  ],
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "git-worktree"
      }
    },
    "target-branch": {
      "type": "string",
      "description": "The branch this worktree's changes are compared against in the review view (e.g. 'main', 'develop')."
    },
    "git": {
      "$ref": "git.json#/$defs/git"
    }
  }
}
