{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/tool-relationship.json",
  "allOf": [
    {
      "$ref": "relationship.json"
    }
  ],
  "type": "object",
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "tool-relationship"
      }
    },
    "participants": {
      "type": "object",
      "properties": {
        "tool": {
          "allOf": [
            {
              "$ref": "core.json#/$defs/entity-id"
            }
          ],
          "x-entity-type": "tool"
        },
        "schedule": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "core.json#/$defs/entity-id"
              }
            ],
            "x-entity-type": "schedule"
          },
          "minItems": 1
        },
        "target": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "core.json#/$defs/entity-id"
              }
            ],
            "x-entity-type": "entity"
          },
          "minItems": 1
        }
      },
      "required": [
        "tool",
        "schedule",
        "target"
      ],
      "unevaluatedProperties": false
    }
  }
}
