{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/tool-relationship.json",
  "description": "Schema for tool relationship entities linking tools, capabilities, and related workspace entities.",
  "allOf": [
    {
      "$ref": "relationship.json"
    }
  ],
  "type": "object",
  "required": [
    "entity-types"
  ],
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "tool-relationship"
      }
    },
    "participants": {
      "type": "object",
      "properties": {
        "tool": {
          "allOf": [
            {
              "$ref": "core.json#/$defs/entity-id"
            }
          ],
          "x-entity-types": ["tool"]
        },
        "schedule": {
          "$ref": "core.json#/$defs/entity-id-list",
          "x-entity-types": ["schedule"],
          "minItems": 1
        },
        "target": {
          "$ref": "core.json#/$defs/entity-id-list",
          "x-entity-types": ["entity"],
          "minItems": 1
        }
      },
      "required": [
        "tool",
        "schedule",
        "target"
      ],
      "unevaluatedProperties": false
    }
  }
}
