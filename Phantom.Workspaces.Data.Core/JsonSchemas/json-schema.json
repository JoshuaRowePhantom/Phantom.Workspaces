{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/json-schema.json",
  "description": "Schema for json-schema entities that store schema definitions referenced by entity types.",
  "type": "object",
  "properties": {
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/schema-index-name"
      },
      "minItems": 1
    },
    "schema": {
      "$ref": "https://json-schema.org/draft/2020-12/schema"
    }
  },
  "required": [
    "names",
    "schema"
  ],
  "$defs": {
    "schema-index-name": {
      "anyOf": [
        {
          "$ref": "#/$defs/entity-type-name"
        },
        {
          "$ref": "#/$defs/json-schema-name"
        }
      ]
    },
    "entity-type-name": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "const": "entity-types"
        }
      ],
      "items": {
        "type": "string"
      }
    },
    "json-schema-name": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "const": "json-schemas"
        }
      ],
      "items": {
        "type": "string"
      }
    }
  }
}
