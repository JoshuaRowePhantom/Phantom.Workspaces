{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/git.json",
  "description": "Schema for git repository entities and repository-level metadata used by workspace tooling.",
  "$defs": {
    "git": {
      "type": "object",
      "description": "Git repository metadata populated by workspace discovery tooling.",
      "properties": {
        "branch": {
          "type": "string",
          "description": "Current checked-out branch name, or HEAD if detached."
        },
        "head-commit": {
          "type": "string",
          "description": "SHA of the HEAD commit."
        },
        "remotes": {
          "type": "array",
          "description": "List of configured remotes for this repository.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Remote name (e.g. 'origin')."
              },
              "url": {
                "type": "string",
                "description": "Remote fetch URL."
              }
            },
            "required": ["name"]
          }
        }
      }
    }
  },
  "type": "object",
  "required": [
    "entity-types"
  ],
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "git"
      }
    },
    "path": {
      "type": "string",
      "description": "Filesystem path of the git repository root directory."
    },
    "git": {
      "$ref": "#/$defs/git"
    }
  }
}
