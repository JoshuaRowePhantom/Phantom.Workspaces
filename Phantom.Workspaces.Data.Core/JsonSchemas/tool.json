{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/tool.json",
  "description": "Schema for tool entities that represent scheduled background tasks and their configuration.",
  "allOf": [
    {
      "$ref": "entity.json"
    }
  ],
  "type": "object",
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "tool"
      }
    },
    "tool-type": {
      "type": "string",
      "description": "Identifies the implementation class (e.g., 'GitWorkspaceScanTool', 'VectorIndexerTool')."
    },
    "configuration": {
      "type": "object",
      "description": "Tool-specific configuration settings.",
      "additionalProperties": true
    },
    "excludes": {
      "type": "array",
      "description": "Tool-specific list of filesystem paths whose subtrees are skipped by directory-walking tools. Values may contain %NAME% environment-variable references, which are expanded before matching.",
      "items": {
        "type": "string"
      }
    },
    "content": {
      "$ref": "mime-attachment.json",
      "x-default-mime-type": "text/markdown"
    }
  },
  "required": [
    "entity-types",
    "tool-type"
  ]
}
