{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/relationship.json",
  "description": "Schema for relationship entities that connect participant entities through typed roles.",
  "type": "object",
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "relationship"
      }
    },
    "participants": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "core.json#/$defs/entity-id"
          },
          {
            "$ref": "core.json#/$defs/entity-id-list"
          }
        ]
      }
    },
    "note": {
      "description": "An optional human-readable reason explaining why this relationship was applied. Shown, for example, as the tooltip on an interest badge.",
      "type": "string"
    }
  },
  "required": [
    "entity-types",
    "participants"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "entity-types": {
            "contains": {
              "const": "entity"
            }
          }
        }
      },
      "then": {
        "properties": {
          "entity-types": {
            "minItems": 3
          }
        }
      },
      "else": {
        "properties": {
          "entity-types": {
            "minItems": 2
          }
        }
      }
    }
  ]
}
