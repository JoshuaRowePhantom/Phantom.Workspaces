{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/workspace-entities-data-access-layer.json",
  "description": "Schema contracts for data access layer get, query, update, and related request/response payloads.",
  "$defs": {
    "get-request": {
      "type": "object",
      "properties": {
        "get-entity": {
          "$ref": "#/$defs/get-entity"
        },
        "properties": {
          "$ref": "#/$defs/properties"
        },
        "relationships-to-return": {
          "$ref": "#/$defs/relationships-to-return"
        },
        "timestamps": {
          "$ref": "#/$defs/timestamps"
        }
      },
      "required": [
        "get-entity"
      ],
      "unevaluatedProperties": false
    },
    "get-entity": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/get-entity-request"
      }
    },
    "get-entity-request": {
      "type": "object",
      "properties": {
        "entity-id": {
          "$ref": "core.json#/$defs/entity-id"
        },
        "entity-name": {
          "$ref": "core.json#/$defs/entity-name"
        },
        "enumerate-children": {
          "type": "string",
          "enum": [
            "self",
            "children",
            "all-children"
          ]
        },
        "entity-type-names": {
          "type": "array",
          "items": {
            "$ref": "core.json#/$defs/entity-type-id"
          }
        },
        "properties": {
          "$ref": "#/$defs/properties"
        },
        "relationships-to-return": {
          "$ref": "#/$defs/relationships-to-return"
        }
      },
      "anyOf": [
        {
          "required": [
            "entity-id"
          ]
        },
        {
          "required": [
            "entity-name"
          ]
        },
        {
          "required": [
            "entity-type-names"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "relationships-to-return": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/get-relationship-request"
      }
    },
    "get-relationship-request": {
      "type": "object",
      "properties": {
        "relationship-type-names": {
          "type": "array",
          "items": {
            "$ref": "core.json#/$defs/entity-type-id"
          }
        },
        "relationship-role-names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "timestamps": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "core.json#/$defs/timestamp"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "properties": {
      "type": "array",
      "description": "JSON paths to include in returned entity data, e.g. [\"display-name\", \"content.default\"].",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "update-request": {
      "type": "object",
      "properties": {
        "update-metadata": {
          "$ref": "#/$defs/update-metadata"
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entity-change"
          }
        }
      },
      "required": [
        "update-metadata",
        "changes"
      ],
      "unevaluatedProperties": false
    },
    "update-metadata": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "text"
          ],
          "unevaluatedProperties": false
        }
      },
      "required": [
        "comment"
      ],
      "unevaluatedProperties": false
    },
    "entity-change": {
      "type": "object",
      "properties": {
        "entity-id": {
          "$ref": "core.json#/$defs/entity-id"
        },
        "concurrency-tag": {
          "type": "string"
        },
        "data": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "entity-change-mode": {
          "type": "string",
          "enum": [
            "replace",
            "json-patch"
          ]
        }
      },
      "required": [
        "entity-change-mode"
      ],
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/get-request"
}
