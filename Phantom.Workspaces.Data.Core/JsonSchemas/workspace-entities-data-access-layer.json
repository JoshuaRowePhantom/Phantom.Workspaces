{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/workspace-entities-data-access-layer.json",
  "description": "Schema contracts for data access layer get, query, update, and related request/response payloads.",
  "$defs": {
    "get-request": {
      "type": "object",
      "properties": {
        "get-entity": {
          "$ref": "#/$defs/get-entity"
        },
        "properties": {
          "$ref": "#/$defs/properties"
        },
        "relationships-to-return": {
          "$ref": "#/$defs/relationships-to-return"
        },
        "timestamps": {
          "$ref": "#/$defs/timestamps"
        }
      },
      "required": [
        "get-entity"
      ],
      "unevaluatedProperties": false
    },
    "get-entity": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/get-entity-request"
      }
    },
    "get-entity-request": {
      "type": "object",
      "properties": {
        "entity-id": {
          "$ref": "core.json#/$defs/entity-id"
        },
        "entity-name": {
          "$ref": "core.json#/$defs/entity-name"
        },
        "enumerate-children": {
          "type": "string",
          "enum": [
            "self",
            "children",
            "all-children"
          ]
        },
        "entity-type-names": {
          "$comment": "Filter by entity type. Each value must be an entity type's canonical name (a single component from its 'names' property, e.g. 'task') or its entity id. This is NOT the entity type's display-name.",
          "description": "Filter results to entities of these entity types. Each value must be an entity type's canonical name (taken from the entity type's 'names' property, for example 'task' or 'note') or its entity id. Do NOT use the entity type's display-name here; the display-name is a human-facing label and is not interchangeable with the name. To discover valid values, get entity types and read their 'names'.",
          "type": "array",
          "items": {
            "$ref": "core.json#/$defs/entity-type-id"
          }
        },
        "properties": {
          "$ref": "#/$defs/properties"
        },
        "relationships-to-return": {
          "$ref": "#/$defs/relationships-to-return"
        }
      },
      "anyOf": [
        {
          "required": [
            "entity-id"
          ]
        },
        {
          "required": [
            "entity-name"
          ]
        },
        {
          "required": [
            "entity-type-names"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "relationships-to-return": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/get-relationship-request"
      }
    },
    "get-relationship-request": {
      "type": "object",
      "properties": {
        "relationship-type-names": {
          "type": "array",
          "items": {
            "$ref": "core.json#/$defs/entity-type-id"
          }
        },
        "relationship-role-names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "timestamps": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "core.json#/$defs/timestamp"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "properties": {
      "type": "array",
      "description": "JSON paths to include in returned entity data, e.g. [\"display-name\", \"content.default\"].",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "update-request": {
      "type": "object",
      "properties": {
        "update-metadata": {
          "$ref": "#/$defs/update-metadata"
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entity-change"
          }
        }
      },
      "required": [
        "update-metadata",
        "changes"
      ],
      "unevaluatedProperties": false
    },
    "update-metadata": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "text"
          ],
          "unevaluatedProperties": false
        }
      },
      "required": [
        "comment"
      ],
      "unevaluatedProperties": false
    },
    "entity-change": {
      "type": "object",
      "properties": {
        "entity-id": {
          "$ref": "core.json#/$defs/entity-id"
        },
        "concurrency-tag": {
          "type": "string"
        },
        "data": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "entity-change-mode": {
          "type": "string",
          "enum": [
            "replace",
            "json-patch"
          ]
        }
      },
      "required": [
        "entity-change-mode"
      ],
      "unevaluatedProperties": false
    },
    "query-request": {
      "description": "A query over entities expressed as one or more identified top-level clauses. Each clause selects entities; results carry the identifiers of the clauses that matched them.",
      "type": "object",
      "properties": {
        "clauses": {
          "description": "The identified top-level clauses to evaluate.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/top-level-query-clause"
          }
        },
        "timestamps": {
          "description": "Optional timestamps at which to evaluate the query; null/omitted means the current version.",
          "$ref": "#/$defs/timestamps"
        }
      },
      "required": [
        "clauses"
      ],
      "unevaluatedProperties": false
    },
    "top-level-query-clause": {
      "description": "A query clause paired with the identifier reported on the entities it returns.",
      "type": "object",
      "properties": {
        "clause-identifier": {
          "$ref": "#/$defs/query-clause-identifier"
        },
        "clause": {
          "$ref": "#/$defs/query-clause"
        }
      },
      "required": [
        "clause-identifier",
        "clause"
      ],
      "unevaluatedProperties": false
    },
    "query-clause-identifier": {
      "description": "A stable identifier for a query clause, reported back on matching entities.",
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "unevaluatedProperties": false
    },
    "query-name-set": {
      "description": "A set of names (entity-type, relationship-type, or role names depending on context).",
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "values"
      ],
      "unevaluatedProperties": false
    },
    "query-field-path": {
      "description": "A path to a field within entity data, as an ordered list of property components, e.g. [\"participants\", \"user\"].",
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "components"
      ],
      "unevaluatedProperties": false
    },
    "query-clause": {
      "description": "A polymorphic query clause. The 'clause-type' discriminator selects the clause form.",
      "type": "object",
      "required": [
        "clause-type"
      ],
      "oneOf": [
        {
          "description": "Logical AND of sub-clauses.",
          "properties": {
            "clause-type": { "const": "and" },
            "clauses": {
              "type": "array",
              "items": { "$ref": "#/$defs/query-clause" }
            }
          },
          "required": [ "clause-type", "clauses" ],
          "unevaluatedProperties": false
        },
        {
          "description": "Logical OR of sub-clauses.",
          "properties": {
            "clause-type": { "const": "or" },
            "clauses": {
              "type": "array",
              "items": { "$ref": "#/$defs/query-clause" }
            }
          },
          "required": [ "clause-type", "clauses" ],
          "unevaluatedProperties": false
        },
        {
          "description": "Logical negation of a sub-clause.",
          "properties": {
            "clause-type": { "const": "not" },
            "clause": { "$ref": "#/$defs/query-clause" }
          },
          "required": [ "clause-type", "clause" ],
          "unevaluatedProperties": false
        },
        {
          "description": "Limits a sub-clause's results to the given count.",
          "properties": {
            "clause-type": { "const": "top" },
            "result-limit": {
              "type": "object",
              "properties": { "value": { "type": "integer" } },
              "required": [ "value" ],
              "unevaluatedProperties": false
            },
            "clause": { "$ref": "#/$defs/query-clause" }
          },
          "required": [ "clause-type", "result-limit", "clause" ],
          "unevaluatedProperties": false
        },
        {
          "description": "Matches entities of the given entity types.",
          "properties": {
            "clause-type": { "const": "entity-type" },
            "entity-type-names": { "$ref": "#/$defs/query-name-set" }
          },
          "required": [ "clause-type", "entity-type-names" ],
          "unevaluatedProperties": false
        },
        {
          "description": "Matches entities whose field at 'field-path' compares to 'value' under the operator.",
          "properties": {
            "clause-type": { "const": "entity-field" },
            "field-path": { "$ref": "#/$defs/query-field-path" },
            "comparison-operator": {
              "type": "string",
              "enum": [
                "equals",
                "greater-than",
                "less-than",
                "greater-than-or-equal-to",
                "less-than-or-equal-to",
                "regular-expression-match",
                "contains"
              ]
            },
            "value": {
              "description": "The scalar value to compare against. Session meta-variables such as ${USER} are bound by the session data-access layer.",
              "type": [ "object", "array", "string", "number", "boolean", "null" ]
            }
          },
          "required": [ "clause-type", "field-path", "comparison-operator" ],
          "unevaluatedProperties": false
        },
        {
          "description": "Semantic (vector) similarity clause over query text or a precomputed embedding.",
          "properties": {
            "clause-type": { "const": "entity-vector" },
            "vector-query-identifier": { "$ref": "#/$defs/query-clause-identifier" },
            "query-text": { "type": "string" },
            "query-embedding": {
              "type": "array",
              "items": { "type": "number" }
            },
            "number-of-candidates": { "type": "integer" },
            "minimum-query-score": {
              "type": "object",
              "properties": { "value": { "type": "number" } },
              "required": [ "value" ],
              "unevaluatedProperties": false
            }
          },
          "required": [ "clause-type", "vector-query-identifier" ],
          "unevaluatedProperties": false
        },
        {
          "description": "Returns the participant entities (in the given roles) of relationships of the given types, optionally requiring a participant matching the must-have sub-clause.",
          "properties": {
            "clause-type": { "const": "entity-participation" },
            "relationship-type-names": { "$ref": "#/$defs/query-name-set" },
            "participation-role-names": { "$ref": "#/$defs/query-name-set" },
            "must-have": {
              "type": "object",
              "properties": {
                "participation-role-names": { "$ref": "#/$defs/query-name-set" },
                "clause": { "$ref": "#/$defs/query-clause" }
              },
              "required": [ "clause" ],
              "unevaluatedProperties": false
            }
          },
          "required": [ "clause-type", "relationship-type-names" ],
          "unevaluatedProperties": false
        },
        {
          "description": "Traverses relationships from a source clause's results to destination participant entities matching a clause.",
          "properties": {
            "clause-type": { "const": "transit" },
            "source-clause-identifier": { "$ref": "#/$defs/query-clause-identifier" },
            "relationship-type-names": { "$ref": "#/$defs/query-name-set" },
            "source-participation-role-names": { "$ref": "#/$defs/query-name-set" },
            "destination-participation-role-names": { "$ref": "#/$defs/query-name-set" },
            "match-clause": { "$ref": "#/$defs/query-clause" }
          },
          "required": [ "clause-type", "source-clause-identifier", "relationship-type-names", "match-clause" ],
          "unevaluatedProperties": false
        }
      ]
    }
  },
  "$ref": "#/$defs/get-request"
}
