{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/schedule.json",
  "description": "Schema for schedule entities that model planned timing, recurrence, and scheduling metadata.",
  "allOf": [
    {
      "$ref": "entity.json"
    }
  ],
  "type": "object",
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "schedule"
      }
    },
    "repeat": {
      "type": "object",
      "properties": {
        "frequency": {
          "$ref": "core.json#/$defs/time",
          "description": "Frequency between schedule runs."
        },
        "days-of-week": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          }
        },
        "start-at": {
          "type": "array",
          "items": {
            "$ref": "core.json#/$defs/time"
          }
        }
      },
      "required": [
        "frequency",
        "start-at"
      ],
      "unevaluatedProperties": false
    }
  },
  "required": [
    "repeat"
  ]
}
