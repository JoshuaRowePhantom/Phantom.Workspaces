{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/folder.json",
  "description": "Schema for folder entities used to organize named groups of related entities.",
  "type": "object",
  "properties": {
    "entity-types": {
      "type": "array",
      "items": {
        "$ref": "core.json#/$defs/entity-type-id"
      },
      "contains": {
        "const": "folder"
      }
    },
    "display-name": {
      "$ref": "core.json#/$defs/local-string"
    },
    "names": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "core.json#/$defs/entity-name"
          },
          {
            "$comment": "Root folder uses an empty name path ([]).",
            "type": "array",
            "maxItems": 0
          }
        ]
      },
      "minItems": 1,
      "maxItems": 1
    }
  },
  "required": [
    "entity-types",
    "names"
  ]
}
