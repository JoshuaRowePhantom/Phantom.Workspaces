{
  "$id": "https://schemas.workspaces.phantom.to/workspaces/data/core/task.json",
  "description": "Schema for task entities that capture actionable work items and task metadata.",
  "allOf": [
    {
      "$ref": "entity.json"
    }
  ],
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in-progress",
        "completed",
        "blocked",
        "cancelled"
      ],
      "description": "Current status of the task"
    },
    "assigned-to": {
      "type": "string",
      "description": "Reference to the user this task is assigned to"
    }
  }
}
