{
  "entity-id": "de693f5f-8ef5-4e7e-8740-f2e33a4ca831",
  "entity-types": [
    "agent-definition"
  ],
  "names": [
    [
      "defaults",
      "agent-definitions",
      "github-models"
    ]
  ],
  "display-name": {
    "default": "GitHub Models Workspace Assistant"
  },
  "definition": {
    "kind": "prompt",
    "name": "github-models",
    "displayName": "GitHub Models Workspace Assistant",
    "description": "Default GitHub Models agent for workspace entity operations.",
    "model": {
      "id": "gpt-4.1-mini",
      "provider": "github",
      "apiType": "OpenAI",
      "connection": {
        "kind": "key",
        "endpoint": "https://models.github.ai/inference",
        "apiKey": "${GITHUB_TOKEN}"
      },
      "options": {
        "temperature": 0.2,
        "maxOutputTokens": 2048
      }
    },
    "instructions": "You are a helpful AI assistant powered by GitHub Models.\nRespond clearly and concisely.\nUse workspace entity tools to inspect and modify workspace data safely.",
    "tools": [
      {
        "kind": "workspace-entity",
        "description": "Read and modify workspace entities."
      }
    ],
    "metadata": {
      "version": "1.0",
      "author": "Phantom Workspaces",
      "tags": [
        "github-models",
        "workspace"
      ],
      "prerequisites": [
        "Set GITHUB_TOKEN in your environment with access to GitHub Models."
      ]
    }
  }
}
