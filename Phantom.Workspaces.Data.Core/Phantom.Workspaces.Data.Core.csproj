<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Phantom.Workspaces.Data</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="JsonSchemas\*.json" />
    <None Remove="JsonEntities\**\*.json" />
    <None Remove="JsonEntities\**\*.md" />
    <None Remove="..\Phantom.Workspaces.Llm.Core\JsonSchemas\*.json" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="JsonSchemas\*.json" />
    <EmbeddedResource Include="JsonEntities\**\*.json" />
    <EmbeddedResource Include="JsonEntities\**\*.md" />
    <EmbeddedResource Include="..\Phantom.Workspaces.Llm.Core\JsonSchemas\*.json" Link="JsonSchemas\llm\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="JsonPatch.Net" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>
</Project>